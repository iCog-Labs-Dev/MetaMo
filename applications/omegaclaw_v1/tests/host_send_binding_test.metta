;; Provision the real session adapter and invoke existing local Core handlers.
;; Only the real local stdout channel is loaded; no external messages/services.
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (quote (read-file show-current-frame)))
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &send-test-channel (new-state local))
(= (commchannel) (get-state &send-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
;; Supply a typed host frame identity for the concrete-operation contract.
;; Native Core ID migration is a separate production projection task.
!(change-state! &cfv2-current-frame-id "configured-frame")
!(change-state! &cfv2-current-status Active)
!(change-state! &cfv2-root-mode Fast)
!(change-state! &cfv2-current-frame-mode Fast)
!(setConstitutionalMode Engaged)
!(initMetaMoDispatch)
!(bind! &host-config-path (new-state (py-call (host_config_fixture.setup))))
!(bind! &host-read-command (new-state (sread (py-call (host_config_fixture.command)))))
(= (hostReadIntent) (AdmissionRequest propose-candidate current-frame execute-skill))
(= (hostFrameIntent) (AdmissionRequest propose-candidate current-frame search-knowledge))
(= (hostReadTicket) (coreDispatchCapture (hostReadIntent)))

(= (hostSendIntent) (AdmissionRequest propose-candidate current-frame respond))
(= (hostSendTicket) (coreDispatchCapture (hostSendIntent)))
(= (hostSendCommand) (quote (send "observed reply")))
!(py-call (host_config_fixture.capture_local_output))
!(test (sread (py-call (host_dispatch_config.provision
   (py-call (host_config_fixture.write_send "allowed")))))
   (HostDispatchConfigured "configured-frame" 3))
;; Existing reads remain executable with the send binding installed.
!(test (coreDispatchCommand (hostReadTicket) (get-state &host-read-command))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (coreDispatchCommand (coreDispatchCapture (hostFrameIntent)) (quote (show-current-frame)))
   (DispatchResult Executed Feasible (cfv2-current-frame)))
!(bind! &send-ticket (new-state (hostSendTicket)))
!(test (coreDispatchCommand (get-state &send-ticket) (hostSendCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 1)
;; Defeat Core's text dedup to prove the ticket itself prevents a second effect.
!(change-state! &lastsend "")
!(test (coreDispatchCommand (get-state &send-ticket) (hostSendCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(test (coreDispatchCommand (get-state &send-ticket) (quote (send "substituted")))
   (DispatchResult Blocked ConflictingReplay none))
!(test (coreDispatchCommand (hostSendTicket) (quote (send "substituted")))
   (DispatchResult Blocked UnsupportedOperation none))
;; Final check reads actual routing under the existing Core lock.
!(bind! &route-ticket (new-state (hostSendTicket)))
!(change-state! &send-test-channel telegram)
!(test (coreDispatchCommand (get-state &route-ticket) (hostSendCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked DestinationMismatch none))
!(change-state! &send-test-channel local)
!(test (coreDispatchCommand (get-state &route-ticket) (hostSendCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "permission-denied"))))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked PermissionDenied none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "egress-denied"))))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked EgressDenied none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "budget-denied"))))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked BudgetExhausted none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "cost-denied"))))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked ConstraintDenied none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "skill-denied"))))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Blocked SkillNotAllowed none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
;; F1.3: a distinct question coexists with the default respond binding.
(= (hostClarificationIntent) (AdmissionRequest propose-candidate current-frame ask-clarification))
(= (hostClarificationTicket) (coreDispatchCapture (hostClarificationIntent)))
(= (hostClarificationCommand) (quote (send "Which file?")))
!(test (sread (py-call (host_dispatch_config.provision
   (py-call (host_config_fixture.write_clarification "allowed")))))
   (HostDispatchConfigured "configured-frame" 4))
;; A ticket for one candidate cannot invoke the other candidate's command.
!(test (coreDispatchCommand (hostSendTicket) (hostClarificationCommand))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (coreDispatchCommand (hostClarificationTicket) (hostSendCommand))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (py-call (host_config_fixture.local_send_count "Which file?")) 0)
!(bind! &clarification-ticket (new-state (hostClarificationTicket)))
!(test (coreDispatchCommand (get-state &clarification-ticket) (hostClarificationCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count "Which file?")) 1)
!(change-state! &lastsend "")
!(test (coreDispatchCommand (get-state &clarification-ticket) (hostClarificationCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count "Which file?")) 1)
;; Local acceptance establishes operation success, not task completion.
!(test (operationOutcomeStatus (hostClarificationCommand) (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
   Success)
!(test (coreDispatchCommand (hostReadTicket) (get-state &host-read-command))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 2)
!(bind! &clarification-route-ticket (new-state (hostClarificationTicket)))
!(change-state! &send-test-channel telegram)
!(test (coreDispatchCommand (get-state &clarification-route-ticket) (hostClarificationCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(change-state! &send-test-channel local)
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_clarification "permission-denied"))))
!(test (coreDispatchCommand (hostClarificationTicket) (hostClarificationCommand))
   (DispatchResult Blocked PermissionDenied none))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_clarification "egress-denied"))))
!(test (coreDispatchCommand (hostClarificationTicket) (hostClarificationCommand))
   (DispatchResult Blocked EgressDenied none))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_clarification "budget-denied"))))
!(test (coreDispatchCommand (hostClarificationTicket) (hostClarificationCommand))
   (DispatchResult Blocked BudgetExhausted none))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_clarification "cost-denied"))))
!(test (coreDispatchCommand (hostClarificationTicket) (hostClarificationCommand))
   (DispatchResult Blocked ConstraintDenied none))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_clarification "skill-denied"))))
!(test (coreDispatchCommand (hostClarificationTicket) (hostClarificationCommand))
   (DispatchResult Blocked SkillNotAllowed none))
!(test (py-call (host_config_fixture.local_send_count "Which file?")) 1)
!(test (py-call (host_config_fixture.finish_local_capture)) 1)
;; A fresh dispatch suppressed by Core's text guard is not another acceptance.
!(py-call (host_config_fixture.capture_local_output))
!(py-call (host_dispatch_config.provision (py-call (host_config_fixture.write_send "allowed"))))
!(change-state! &lastsend "observed reply")
!(test (coreDispatchCommand (hostSendTicket) (hostSendCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" SuppressedDuplicate)))
!(test (py-call (host_config_fixture.local_send_count)) 0)
;; Flush failure can follow a partial effect. Preserve uncertainty and replay it.
!(change-state! &lastsend "")
!(py-call (host_config_fixture.fail_local_flush))
!(bind! &failed-send-ticket (new-state (hostSendTicket)))
!(test (coreDispatchCommand (get-state &failed-send-ticket) (hostSendCommand))
   (DispatchResult Unobserved ExecutionUncertain none))
!(py-call (host_config_fixture.restore_local_flush))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(change-state! &lastsend "")
!(test (coreDispatchCommand (get-state &failed-send-ticket) (hostSendCommand))
   (DispatchResult Unobserved ExecutionUncertain none))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(test (py-call (host_config_fixture.finish_local_capture)) 1)
!(test (py-call (host_config_fixture.cleanup)) 1)
