;; External inference/memory doubled; real appraisal, capture, gate and handlers.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send read-file))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
!(import! &self fixtures/prepared_response_fixture.py)
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &send-test-channel (new-state local))
(= (commchannel) (get-state &send-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Inspect the file")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Use the native symbol ID to exercise generated operation target preservation.
!(change-state! &cfv2-current-frame-id configured-frame)
!(change-state! &active-task "Inspect the file")
!(change-state! &task-open True)
!(change-state! &new-msg-flag False)
!(initMetaMoDispatch)
!(py-call (host_config_fixture.setup))
;; Startup installer preserves the native symbol target.
!(py-call (host_dispatch_config.configure_startup (py-call (prepared_response_fixture.configure "allowed"))))
!(py-call (host_dispatch_config.provision_startup))
!(bind! &read-bundle (new-state (prepareTaskStateForMetaMo)))
!(retainSelectedOperation execute-skill (captureCandidateOperations (get-state &read-bundle)))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (py-call (prepared_response_fixture.retain_read)) 1)
!(py-call (host_config_fixture.capture_local_output))
!(test (sread (py-call (prepared_response_fixture.queue "answer"))) (ResponsePreparationQueued))

;; An actual admitted read becomes a retained requirement, never a no-tool shortcut.
!(test (case (get-state &host-task-requirements) (
    ((HostTaskRequirements $_ $_ (RequiredWork (Files))
        (RequirementAssessment RequiresTools HostReadRequirement)) True)
    ($_ False))) True)

!(test (py-call (prepared_response_fixture.calls)) 0)
;; The normal bridge invokes preparation/capture before real admission/scoring.
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.calls)) 1)
!(test (selectedHostCommand) (quote (send "observed reply")))
!(test (py-call (host_config_fixture.local_send_count)) 0)
!(bind! &reply-ticket (new-state (selectedHostTicket)))
!(test (coreLoopDispatchBegin) (get-state &reply-ticket))
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (quote (send "substituted")))
   (DispatchResult Blocked UnselectedOperation none))
!(test (py-call (host_config_fixture.local_send_count)) 0)
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(change-state! &lastsend "")
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 1)

;; Host-retained Files blocks a new no-tool claim after the actual read/send path.
!(test (sread (py-call (prepared_response_fixture.greeting_shortcut)))
    (ResponseNoAction RequiresTools))

;; The real dispatch callback preserves acceptance and classifies this operation.
!(bind! &accepted-reply (new-state (get-state &last-operation-outcome)))
!(test (get-state &accepted-reply)
   (OperationOutcome (get-state &selected-operation-decision)
      (attempted-command (quote (send "observed reply"))) Success
      (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted))))
;; Success feedback replaces the old unknown-result exploration signal. The
;; cycle-owned reply expires; no replacement answer is available before F1.8.
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Success 0))
!(test (get-state &task-open) True)
!(test (get-state &active-task) "Inspect the file")
!(test (preparedHostBinding) ())
!(test (py-call (prepared_response_fixture.calls)) 1)
;; F1.9: repeating the host queue on idle cycles must not call the provider
;; or create another send, even if a new dispatch ticket would be possible.
!(bind! &answered-key (new-state (get-state &answered-operation-key)))
!(test (!= (get-state &answered-key) ()) True)
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction AlreadyAnswered))
!(test (preparedHostBinding) ())
!(test (py-call (prepared_response_fixture.calls)) 1)
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction AlreadyAnswered))
!(test (get-state &answered-operation-key) (get-state &answered-key))
!(test (py-call (prepared_response_fixture.calls)) 1)
!(test (py-call (host_config_fixture.local_send_count)) 1)
;; New admitted input makes an answer eligible without completing the task.
!(test (py-call (prepared_response_fixture.new_input)) 1)
;; F1.8: no fresh read feedback or formatted results remain. Required-read
;; coverage and a prepared answer can still make respond available.
!(test (sread (py-call (prepared_response_fixture.queue "missing-read")))
   (ResponseNoAction MissingRequiredReads))
!(test (py-call (prepared_response_fixture.calls)) 1)
!(test (sread (py-call (prepared_response_fixture.queue "ready"))) (ResponsePreparationQueued))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback NoOutcome 0))
!(test (hasResults) False)
!(test (eval (preparedResponseReadyForBundle (activeFrameBundle))) True)
!(test (taskResultReadyForBundle (activeFrameBundle)) True)
!(test (selectedHostCommand) (quote (send "observed reply")))
!(test (py-call (host_config_fixture.local_send_count)) 1)
!(test (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 2)
;; Readiness is cycle-owned and never sticks after the prepared binding expires.
!(prepareTaskStateForMetaMo)
!(test (preparedResponseReadyForBundle (activeFrameBundle)) False)
;; A new input permits another answer; its captured destination is still checked.
!(py-call (prepared_response_fixture.new_input))
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &changed-route-ticket (new-state (selectedHostTicket)))
!(change-state! &send-test-channel telegram)
!(test (coreLoopDispatchCommand (get-state &changed-route-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(change-state! &send-test-channel local)
!(test (coreLoopDispatchCommand (get-state &changed-route-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (host_config_fixture.local_send_count)) 2)
;; Changes during the provider call cannot publish an old prepared command.
!(sread (py-call (prepared_response_fixture.queue "ready-route-change")))
!(motivationContextBlock)
!(test (preparedHostBinding) ())
!(change-state! &send-test-channel local)
;; Explicit no-action and malformed output do not leave a prior reply executable.
!(sread (py-call (prepared_response_fixture.queue "ready-no-action")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction InsufficientEvidence))
!(test (eval (preparedResponseReadyForBundle (activeFrameBundle))) False)
!(test (preparedHostBinding) ())
!(sread (py-call (prepared_response_fixture.queue "ready-invalid")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction InvalidResponse))
!(test (eval (preparedResponseReadyForBundle (activeFrameBundle))) False)
!(test (preparedHostBinding) ())
;; Policy changes during preparation discard the result as well.
!(sread (py-call (prepared_response_fixture.queue "ready-policy-change")))
!(motivationContextBlock)
!(test (preparedHostBinding) ())
;; Generated operations pass both scopes' concrete gate before scoring.
!(py-call (prepared_response_fixture.provision "permission-denied"))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected PermissionDenied))
!(test (!= (selectedHostCommand) (quote (send "observed reply"))) True)
!(py-call (prepared_response_fixture.provision "egress-denied"))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected EgressDenied))
!(test (!= (selectedHostCommand) (quote (send "observed reply"))) True)
!(py-call (prepared_response_fixture.provision "budget-denied"))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected BudgetExhausted))
!(test (!= (selectedHostCommand) (quote (send "observed reply"))) True)
;; A prepared decision also becomes stale when policy changes after selection.
!(py-call (prepared_response_fixture.provision "allowed"))
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &revoked-ticket (new-state (selectedHostTicket)))
!(py-call (prepared_response_fixture.provision "permission-denied"))
!(test (coreLoopDispatchCommand (get-state &revoked-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (preparedHostBinding) ())
;; Existing explicit command revocation also removes the transient binding.
!(py-call (prepared_response_fixture.provision "allowed"))
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.revoke_reply)) 1)
!(test (preparedHostBinding) ())
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected UnsupportedOperation))
;; Pending inputs belong to the original session/frame/task, not later work.
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(bind! &calls-before-owner-change (new-state (py-call (prepared_response_fixture.calls))))
!(change-state! &active-task "A different task")
!(motivationContextBlock)
!(test (preparedHostBinding) ())
!(test (py-call (prepared_response_fixture.calls)) (get-state &calls-before-owner-change))
!(change-state! &active-task "Inspect the file")
!(sread (py-call (prepared_response_fixture.queue "answer")))
!(initOperationSession)
!(motivationContextBlock)
!(test (preparedHostBinding) ())
!(test (py-call (prepared_response_fixture.calls)) (get-state &calls-before-owner-change))
!(test (py-call (host_config_fixture.local_send_count)) 2)
!(test (py-call (host_config_fixture.finish_local_capture)) 1)
!(test (py-call (host_config_fixture.cleanup)) 1)
