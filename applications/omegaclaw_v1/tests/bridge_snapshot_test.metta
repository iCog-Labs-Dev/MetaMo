;; Real host bookkeeping and a real captured bundle. Host/cache mutations after
;; capture are deliberately adversarial; this tests snapshot consistency, not
;; concurrent dispatch authorization. No motivational function is replaced.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send query))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
   (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureOutcome commitmentFixtureApply))
!(bind! &prevmsg (new-state "Summarize the task"))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ensureMotivationRestored)
!(commitmentFixtureReset)
!(ctx-ingest-user-message "Summarize the task")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(bind! &snapshot-frame (new-state (get-state &cfv2-current-frame-id)))
!(test (commitmentFixtureOpen "snapshot-task" (repr (get-state &snapshot-frame)) "Summarize the task")
   (CommitmentOpened "snapshot-task"))
;; Deliberately stale legacy fields must be refreshed before publication.
!(change-state! &task-open False)
!(change-state! &active-task "stale task")
!(change-state! &task-execution-observed "old execution")
!(change-state! &new-msg-flag True)
!(bind! &captured-snapshot (new-state (prepareTaskStateForMetaMo)))
!(test (frameRuntimeTaskOpen (get-state &captured-snapshot)) True)
!(test (frameRuntimeActiveTask (get-state &captured-snapshot))
   (cfv2-compact-limited "Summarize the task" 500))
!(test (frameRuntimeExecutionObserved (get-state &captured-snapshot)) "")
!(test (== (activeFrameBundle) (get-state &captured-snapshot)) True)
!(test (frameBundleCurrentId (get-state &captured-snapshot)) (get-state &snapshot-frame))

;; Establish real appraisal input and bind the actual decision callbacks before
;; replacing host state and its mutable snapshot cache.
!(refreshSignals (get-state &captured-snapshot))
!(clearSpace &appraisal-space)
!(computeAllDimensions)
!(bind! &captured-stimulus (new-state (appraisalToStimulus)))
!(bind! &captured-decision (new-state (omegaclawDecisionForBundle (get-state &captured-snapshot))))
!(change-state! &cfv2-current-frame-id ())
!(change-state! &cfv2-current-status Completed)
!(change-state! &task-open False)
!(change-state! &active-task "later task")
!(change-state! &prevmsg "later message")
!(change-state! &new-msg-flag False)
!(change-state! &error "later failure")
!(change-state! &lastresults "later execution result")
!(bind! &later-snapshot (new-state (frameStateForMetaMo)))
!(setActiveFrameBundle (get-state &later-snapshot))
!(test (feasibilityGate (get-state &captured-snapshot) execute-skill)
   (GateDecision Admitted Feasible))
!(test (feasibilityGate (get-state &later-snapshot) execute-skill)
   (GateDecision Rejected NoActiveFrame))
!(test (> (scoreCandidate (get-state &captured-decision)
   (motivosToMetamoState) (candidateToAction respond)) 0.0) True)
!(test (omegaclawScoreBound (motivosToMetamoState) (candidateToAction respond)) 0.0)
!(test (actionId (decisionAction (decide (get-state &captured-decision)
   (motivosToMetamoState) ((candidateToAction respond))))) respond)
!(test (actionId (decisionAction (omegaclawDecideBound
   (motivosToMetamoState) ((candidateToAction respond))))) none)

;; Execute the very same body called by motivationContextBlock, with the original
;; captured bundle. It must not recapture or consult the replacement cache.
!(bind! &snapshot-policy-results
   (new-state (collapse (motivationContextBlockForBundle (get-state &captured-snapshot)))))
!(test (size-atom (get-state &snapshot-policy-results)) 1)
!(test (policyOutputOperation (car-atom (get-state &snapshot-policy-results))) respond)
!(test (policyOutputFeasibility (car-atom (get-state &snapshot-policy-results))) Admitted)
!(test (appraisalToStimulus) (get-state &captured-stimulus))
!(test (collapse (match &candidateSpace (candidate $name) $name)) (respond))
!(test (get-state &failure-streak) 0)
!(test (get-state &failure-count) 0)
!(test (get-state &success-count) 0)
!(test (get-state &cycle-count) 1)
!(test (> (policyOutputPriority (car-atom (get-state &snapshot-policy-results))) 0.0) True)
!(test (lastAttentionDirective)
   (schedulerAttentionDirective (get-state &captured-snapshot)
      (car-atom (get-state &snapshot-policy-results))))
!(test (== (activeFrameBundle) (get-state &later-snapshot)) True)
!(test (getSignals) ())
!(test (advanceAutonomyPhaseForBundle (get-state &captured-snapshot) recall-goals) False)
!(test (get-state &autonomy-phase) recall)

;; A subsequent publication performs bookkeeping afresh: merged observations
;; are visible, and an explicit host terminal event is reflected before capture.
!(change-state! &task-execution-observed "earlier result")
!(bind! &observed-snapshot (new-state (prepareTaskStateForMetaMo)))
!(test (frameRuntimeExecutionObserved (get-state &observed-snapshot))
   (cfv2-compact-limited
      (py-call (helper.merge_observed_execution_commands "earlier result" "later execution result")) 1200))
!(test (frameRuntimeTaskOpen (get-state &observed-snapshot)) True)
!(commitmentFixtureOutcome "snapshot-outcome" "snapshot-task" 0 Completed)
!(commitmentFixtureApply (quote (CommitmentEvent "snapshot-completed" "snapshot-task" 0
   (Completed "snapshot-outcome"))))
!(bind! &terminal-snapshot (new-state (prepareTaskStateForMetaMo)))
!(test (frameRuntimeTaskOpen (get-state &terminal-snapshot)) False)
!(test (frameRuntimeActiveTask (get-state &terminal-snapshot)) "")
!(test (frameRuntimeExecutionObserved (get-state &terminal-snapshot)) "")
!(test (frameRuntimeTaskOpen (get-state &captured-snapshot)) True)
!(test (py-call (offline_guard.optional_modules_absent)) 1)
