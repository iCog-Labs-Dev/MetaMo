;; Focused tests for context and constitutional policy gates.

!(import! &self (library lib_import))
!(import! &self "../../../../../repos/OmegaClaw-Core/src/helper.py")
!(import! &self ../../../../../repos/OmegaClaw-Core/src/context)
!(import! &self (library MetaMo core/state))
!(import! &self (library MetaMo core/state_accessors))
!(import! &self (library MetaMo core/helper))
!(import! &self (library MetaMo core/helpers.py))
!(import! &self (library MetaMo applications/omegaclaw_v1/utils))
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/mode_layer)
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/context_integration)
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/contexts/context_accessors)
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/contexts/context_policy)

(= (policyTestBundle)
   (FrameStateBundle
      (root (FrameStateRoot policy-root policy-frame (mode Fast)
             root-budget root-constraints))
      (current (FrameStateCurrent
         policy-frame
         (parent ())
         PolicySource
         (status Active)
         (frame-mode Fast)
         (priority 0.8)
         (goal-summary goal)
         (history-summary history)
         (deliverable-summary deliverable)
         (results-summary results)
         (budget (ResourceBudget 10 10 units (status Open)))
         (constraints constraints)
         (certified-method method)))
      (index (active ()) (completed ()))
      (relations ())
      (runtime (FrameStateRuntime
         (new-message False)
         (message-present False)
         (message-summary "")
         (task-open True)
         (task-execution-observed "")
         (active-task-summary task)
         (last-results-summary "")
         (error "")
         (wake-loops 0)
         (next-wake-at 0)
         (budget-state (ResourceBudget 10 10 units (status Open)))))))

!(test (candidateRequiresFrame respond) False)
!(test (candidateRequiresFrame execute-skill) True)
!(test (candidateRequiresFrame verify-frame-state) True)
!(test (candidateRequiresFrame plan-goal) True)

!(test (contextPolicyGateFacts False False False False False)
      (GateDecision Admitted Feasible))
!(test (contextPolicyGateFacts True False True True True)
      (GateDecision Rejected NoActiveFrame))
!(test (contextPolicyGateFacts True True False True True)
      (GateDecision Rejected InactiveFrame))
!(test (contextPolicyGateFacts True True True False True)
      (GateDecision Rejected FrameModeMismatch))
!(test (contextPolicyGateFacts True True True True False)
      (GateDecision Rejected BudgetExhausted))
!(test (contextPolicyGateFacts True True True True True)
      (GateDecision Admitted Feasible))

!(setConstitutionalMode Sleep)
!(test (constitutionalModeGate execute-skill)
      (GateDecision Rejected SleepModeOperationalWork))
!(test (constitutionalModeGate respond)
      (GateDecision Admitted Feasible))
!(setConstitutionalMode Engaged)

!(test (feasibilityGate (policyTestBundle) respond)
      (GateDecision Admitted Feasible))
!(test (feasibilityGate (policyTestBundle) execute-skill)
      (GateDecision Admitted Feasible))
