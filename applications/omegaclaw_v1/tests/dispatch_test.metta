!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/dispatch.pl) (initDispatchFixture))
!(bind! &dispatch-effects (new-state 0))
!(bind! &dispatch-permissions (new-state ("files.read")))
!(bind! &dispatch-budget (new-state 10))
(= (dispatchTestBundle)
   (FrameStateBundle
      (root (FrameStateRoot root "frame" (mode Fast) () ()))
      (current (FrameStateCurrent (id "frame") (parent ()) UserDirective
         (status Active) (frame-mode Fast) (priority 1.0)
         (goal-summary "task") (history-summary "") (deliverable-summary "")
         (results-summary "") (budget (ResourceBudget 10 10 units (status Open)))
         (constraints ()) (certified-method ())))
      (index (active ()) (completed ())) (relations ()) (runtime ())))
(= (dispatchTestScope $target)
   (PolicyScope (target $target) (skills ("read-file"))
      (permissions (get-state &dispatch-permissions)) (egress ()) (constraints ())
      (budgets ((ResourceBudget "commands" "units" (get-state &dispatch-budget) Open)))))
(= (dispatchTestContext)
   (DispatchContext (dispatchTestBundle) (dispatchTestScope Global)
      (dispatchTestScope (FrameTarget "frame")) (constitutionalMode) ()))
(= (dispatchTestRequest) (AdmissionRequest propose-candidate current-frame execute-skill))
(= (dispatchTestOperation)
   (PolicyOperation (candidate execute-skill) (target "frame") (skill "read-file")
      (permissions ("files.read")) (egress ()) (costs ((ResourceCost "commands" "units" 1)))))
(= (dispatch-test-execute)
   (progn (change-state! &dispatch-effects (+ (get-state &dispatch-effects) 1)) completed))
!(initDispatchFixture)
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Executed Feasible completed))
!(test (get-state &dispatch-effects) 1)
;; Blocked dispatch must not be mistaken for completion by host bookkeeping.
!(import! &self (library OmegaClaw-Core src/loop))
!(bind! &error (new-state ()))
!(recordDispatchFailure (DispatchResult Blocked PermissionDenied none))
!(test (get-state &error) (DispatchBlocked PermissionDenied))
!(recordDispatchFailure (DispatchResult Unobserved ExecutionUncertain none))
!(test (get-state &error) (DispatchUnobserved ExecutionUncertain))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Executed Feasible completed))
!(test (get-state &dispatch-effects) 1)

;; A policy change after selection blocks invocation rather than reusing the score.
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(change-state! &dispatch-permissions ())
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Blocked StaleSnapshot none))
!(test (get-state &dispatch-effects) 1)
;; A fresh ticket still needs the real current typed permission check.
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Blocked PermissionDenied none))
!(test (get-state &dispatch-effects) 1)
!(change-state! &dispatch-permissions ("files.read"))
!(change-state! &dispatch-budget 0)
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Blocked BudgetExhausted none))
!(test (get-state &dispatch-effects) 1)
!(change-state! &dispatch-budget 10)
!(setConstitutionalMode Sleep)
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (dispatch-test-execute)))
   (DispatchResult Blocked SleepModeOperationalWork none))
!(test (get-state &dispatch-effects) 1)
!(setConstitutionalMode Engaged)
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (coreDispatch (get-state &dispatch-ticket) (quote (change-state! &dispatch-effects 100)))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (get-state &dispatch-effects) 1)
;; Match the host loop's parsed command path: arguments must stay data until
;; the registered handler is invoked, even for a direct state mutation form.
!(bind! &dispatch-ticket (new-state (coreDispatchCapture (dispatchTestRequest))))
!(test (let $commands (sread "((change-state! &dispatch-effects 100))")
   (let $command (superpose $commands)
      (coreDispatchCommand (get-state &dispatch-ticket) $command)))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (get-state &dispatch-effects) 1)
