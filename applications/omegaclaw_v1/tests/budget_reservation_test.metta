!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/budget_accounting))

(= (reserveId $scope $resource $unit)
   (BudgetAccountId "host" $scope $resource $unit))
(= (reserveAccount $scope $limit $spent $reserved $status $revision)
   (BudgetAccount (reserveId $scope "commands" "units")
      $limit $spent $reserved $status $revision))
(= (reserveOperation $command $costs)
   (BudgetOperation $command
      (PolicyOperation (candidate execute-skill) (target frameA)
         (skill "read-file") (permissions ("files.read")) (egress ()) (costs $costs))))
(= (reserveRead $amount)
   (reserveOperation (read-file "/allowed/file") ((ResourceCost "commands" "units" $amount))))
(= (reserveRows $amount)
   ((AccountCost (reserveId Global "commands" "units") $amount)
    (AccountCost (reserveId (FrameTarget frameA) "commands" "units") $amount)))
(= (reserveAccounts)
   ((reserveAccount Global 10 2 1 Open 4)
    (reserveAccount (FrameTarget frameA) 8 1 1 Open 2)
    (reserveAccount (FrameTarget other) 20 0 0 Open 0)))

;; Every rejected call must preserve accounts, reservations and revisions.
(= (reserveUnchanged $ticket $operation $costs)
   (let* (($before (get-state &budget-account-state))
          ($result (reserveOperationBudget $ticket $operation $costs)))
      ($result (=alpha $before (get-state &budget-account-state)))))
(= (reserveFresh $accounts)
   (progn
      (change-state! &budget-account-state BudgetAccountsUninitialized)
      (initBudgetAccounts $accounts)))
!(test (reserveUnchanged (DispatchTicket "first") (reserveRead 2) (reserveRows 2))
   ((BudgetAccountingRejected AccountsNotInitialized) True))
!(test (initBudgetAccounts (reserveAccounts)) (BudgetAccountsInitialized 3))
!(test (reserveOperationBudget (DispatchTicket "first") (reserveRead 2) (reserveRows 2))
   (BudgetReserved (DispatchTicket "first") (reserveRows 2)))
!(test (budgetAvailability (reserveId Global "commands" "units")) (ResourceBudget "commands" "units" 5 Open))
!(test (budgetAvailability (reserveId (FrameTarget frameA) "commands" "units")) (ResourceBudget "commands" "units" 4 Open))
!(test (budgetAvailability (reserveId (FrameTarget other) "commands" "units")) (ResourceBudget "commands" "units" 20 Open))
!(test (get-state &budget-account-state)
   (BudgetAccounts
      ((reserveAccount Global 10 2 3 Open 5)
       (reserveAccount (FrameTarget frameA) 8 1 3 Open 3)
       (reserveAccount (FrameTarget other) 20 0 0 Open 0))
      ((BudgetReservation (DispatchTicket "first") (reserveRead 2) (reserveRows 2)
         ((reserveAccount (FrameTarget frameA) 8 1 1 Open 2)
          (reserveAccount Global 10 2 1 Open 4))))))
;; Exact replay and reordered/repeated identical references reserve only once.
!(test (reserveUnchanged (DispatchTicket "first") (reserveRead 2) (reserveRows 2))
   ((BudgetReserved (DispatchTicket "first") (reserveRows 2)) True))
!(test (reserveUnchanged (DispatchTicket "first") (reserveRead 2)
   ((AccountCost (reserveId (FrameTarget frameA) "commands" "units") 2)
    (AccountCost (reserveId Global "commands" "units") 2)
    (AccountCost (reserveId Global "commands" "units") 2)))
   ((BudgetReserved (DispatchTicket "first") (reserveRows 2)) True))
!(test (reserveUnchanged (DispatchTicket "first") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected ConflictingReplay) True))
!(test (reserveUnchanged (DispatchTicket "first")
   (reserveOperation (read-file "/different/file") ((ResourceCost "commands" "units" 2))) (reserveRows 2))
   ((BudgetAccountingRejected ConflictingReplay) True))
;; A second dispatch sees the first reservation; frame failure must not debit global.
!(test (reserveUnchanged (DispatchTicket "second") (reserveRead 5) (reserveRows 5))
   ((BudgetAccountingRejected BudgetExhausted) True))
!(test (reserveOperationBudget (DispatchTicket "second") (reserveRead 4) (reserveRows 4))
   (BudgetReserved (DispatchTicket "second") (reserveRows 4)))
!(test (budgetAvailability (reserveId (FrameTarget frameA) "commands" "units")) (ResourceBudget "commands" "units" 0 Open))
!(test (reserveUnchanged (DispatchTicket "third") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected BudgetExhausted) True))
;; Replay remains successful after another dispatch has consumed the capacity.
!(test (reserveUnchanged (DispatchTicket "first") (reserveRead 2) (reserveRows 2))
   ((BudgetReserved (DispatchTicket "first") (reserveRows 2)) True))

!(test (reserveUnchanged "id" (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidDispatchId) True))
!(test (reserveUnchanged (DispatchTicket "") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidDispatchId) True))
!(test (reserveUnchanged (DispatchTicket $id) (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidBudgetReservation) True))
!(test (reserveUnchanged (DispatchTicket "bad") () (reserveRows 1))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveOperation () ()) ())
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveOperation (send "hello") ()) ())
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead -1) (reserveRows -1))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 0.5) (reserveRows 0.5))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead "1") (reserveRows 1))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 9007199254740992) (reserveRows 1))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveOperation (read-file "/allowed/file") ((ResourceCost "commands" "units" 1) (ResourceCost "commands" "units" 1))) (reserveRows 1))
   ((BudgetAccountingRejected InvalidOperation) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) "not a list")
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ())
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) (Broken))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId (FrameTarget frameA) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) (reserveRows 2))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1) (AccountCost (reserveId (FrameTarget frameA) "commands" "tokens") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1) (AccountCost (reserveId (FrameTarget "frameA") "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1) (AccountCost (BudgetAccountId "other-host" (FrameTarget frameA) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1) (AccountCost (reserveId Global "commands" "units") 2) (AccountCost (reserveId (FrameTarget frameA) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))
!(test (reserveUnchanged (DispatchTicket "bad") (reserveRead 1) ((AccountCost (reserveId Global "commands" "units") 1) (AccountCost (reserveId (FrameTarget frameA) "commands" "units") 1) (AccountCost (reserveId (FrameTarget other) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidAccountCosts) True))

;; Missing account and account-revision exhaustion cannot leave partial updates.
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)))
!(test (reserveUnchanged (DispatchTicket "missing") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected MissingBudgetAccount) True))
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Open 9007199254740991)))
!(test (reserveUnchanged (DispatchTicket "overflow") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected BudgetRevisionExhausted) True))
!(reserveFresh ((reserveAccount Global 10 0 0 Closed 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(test (reserveUnchanged (DispatchTicket "closed") (reserveRead 0) (reserveRows 0))
   ((BudgetAccountingRejected BudgetExhausted) True))
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Exhausted 0)))
!(test (reserveUnchanged (DispatchTicket "exhausted") (reserveRead 0) (reserveRows 0))
   ((BudgetAccountingRejected BudgetExhausted) True))

;; Zero-cost declarations still require open accounts; explicit cost-free work
;; has no affected accounts, but retains a replay record.
!(reserveFresh ((reserveAccount Global 0 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 0 0 0 Open 0)))
!(test (reserveOperationBudget (DispatchTicket "zero") (reserveRead 0) (reserveRows 0))
   (BudgetReserved (DispatchTicket "zero") (reserveRows 0)))
!(reserveFresh ())
!(test (reserveOperationBudget (DispatchTicket "free") (reserveOperation (read-file "/free") ()) ())
   (BudgetReserved (DispatchTicket "free") ()))
!(test (reserveUnchanged (DispatchTicket "free") (reserveOperation (read-file "/free") ()) ())
   ((BudgetReserved (DispatchTicket "free") ()) True))
!(test (reserveUnchanged (DispatchTicket "extra") (reserveOperation (read-file "/free") ()) (reserveRows 1))
   ((BudgetAccountingRejected InvalidAccountCosts) True))

;; Multi-resource reservations are all-or-nothing, even when the last resource fails.
(= (multiOperation)
   (reserveOperation (read-file "/allowed/file")
      ((ResourceCost "commands" "units" 1) (ResourceCost "tokens" "tokens" 3))))
(= (multiRows)
   ((AccountCost (reserveId Global "commands" "units") 1)
    (AccountCost (reserveId (FrameTarget frameA) "commands" "units") 1)
    (AccountCost (reserveId Global "tokens" "tokens") 3)
    (AccountCost (reserveId (FrameTarget frameA) "tokens" "tokens") 3)))
(= (multiAccounts $tokenLimit)
   ((reserveAccount Global 10 0 0 Open 0)
    (reserveAccount (FrameTarget frameA) 10 0 0 Open 0)
    (BudgetAccount (reserveId Global "tokens" "tokens") 5 0 0 Open 0)
    (BudgetAccount (reserveId (FrameTarget frameA) "tokens" "tokens") $tokenLimit 0 0 Open 0)))
!(reserveFresh (multiAccounts 2))
!(test (reserveUnchanged (DispatchTicket "multi") (multiOperation) (multiRows))
   ((BudgetAccountingRejected BudgetExhausted) True))
!(reserveFresh (multiAccounts 3))
!(test (reserveOperationBudget (DispatchTicket "multi") (multiOperation) (multiRows))
   (BudgetReserved (DispatchTicket "multi") (multiRows)))
!(test (budgetAvailability (reserveId Global "tokens" "tokens")) (ResourceBudget "tokens" "tokens" 2 Open))
!(test (budgetAvailability (reserveId (FrameTarget frameA) "tokens" "tokens")) (ResourceBudget "tokens" "tokens" 0 Open))

;; Corrupt snapshots and malformed replay records are rejected before any write.
!(change-state! &budget-account-state Broken)
!(test (reserveUnchanged (DispatchTicket "corrupt") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidBudgetAccounts) True))
!(change-state! &budget-account-state (BudgetAccounts (reserveAccounts) (Broken)))
!(test (reserveUnchanged (DispatchTicket "corrupt") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidBudgetReservations) True))

;; Duplicate references on a fresh reservation also charge each account once.
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(test (reserveOperationBudget (DispatchTicket "dedup") (reserveRead 1)
   ((AccountCost (reserveId Global "commands" "units") 1)
    (AccountCost (reserveId Global "commands" "units") 1)
    (AccountCost (reserveId (FrameTarget frameA) "commands" "units") 1)))
   (BudgetReserved (DispatchTicket "dedup") (reserveRows 1)))
!(test (budgetAvailability (reserveId Global "commands" "units"))
   (ResourceBudget "commands" "units" 9 Open))
!(test (budgetAvailability (reserveId (FrameTarget frameA) "commands" "units"))
   (ResourceBudget "commands" "units" 9 Open))

;; Ten separate dispatches exhaust ten units; no settlement is needed to prevent
;; an eleventh in-flight operation from spending the same capacity.
(= (reserveTen $n)
   (if (== $n 0) ()
       (let $result (reserveOperationBudget (DispatchTicket (repr $n))
                       (reserveRead 1) (reserveRows 1))
          (cons-atom $result (reserveTen (- $n 1))))))
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(bind! &ten-reservation-results (new-state (reserveTen 10)))
!(test (size-atom (get-state &ten-reservation-results)) 10)
!(test (size-atom (filter-atom (get-state &ten-reservation-results) $result
   (case $result (((BudgetReserved $_ $_) True) ($_ False))))) 10)
!(test (budgetAvailability (reserveId Global "commands" "units"))
   (ResourceBudget "commands" "units" 0 Open))
!(test (budgetAvailability (reserveId (FrameTarget frameA) "commands" "units"))
   (ResourceBudget "commands" "units" 0 Open))
!(test (reserveUnchanged (DispatchTicket "eleventh") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected BudgetExhausted) True))

;; The accounting function retains a quoted command as data, never evaluates it.
!(bind! &reservation-execution-probe (new-state "unchanged"))
!(reserveFresh ((reserveAccount Global 10 0 0 Open 0)
   (reserveAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(test (reserveOperationBudget (DispatchTicket "inert")
   (quote (BudgetOperation (read-file (change-state! &reservation-execution-probe "executed"))
      (PolicyOperation (candidate execute-skill) (target frameA) (skill "read-file")
         (permissions ("files.read")) (egress ()) (costs ((ResourceCost "commands" "units" 1))))))
   (reserveRows 1)) (BudgetReserved (DispatchTicket "inert") (reserveRows 1)))
!(test (get-state &reservation-execution-probe) "unchanged")

;; Bad accounting and duplicate ticket records cannot produce a fresh claim.
!(change-state! &budget-account-state
   (BudgetAccounts ((reserveAccount Global 10 2 9 Open 0)) ()))
!(test (reserveUnchanged (DispatchTicket "bad-account") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected BudgetOvercommitted) True))
!(change-state! &budget-account-state
   (BudgetAccounts (reserveAccounts)
      ((BudgetReservation (DispatchTicket "duplicate") (reserveRead 1) (reserveRows 1) ())
       (BudgetReservation (DispatchTicket "duplicate") (reserveRead 1) (reserveRows 1) ()))))
!(test (reserveUnchanged (DispatchTicket "new") (reserveRead 1) (reserveRows 1))
   ((BudgetAccountingRejected InvalidBudgetReservations) True))
