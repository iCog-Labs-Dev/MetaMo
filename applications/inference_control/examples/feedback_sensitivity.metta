(= (plnTermStv EvalA) (stv 0.2 0.9))
(= (plnTermStv EvalB) (stv 0.3 0.9))
(= (plnTermStv EvalC) (stv 0.4 0.9))
(= (plnTermStv EvalD) (stv 0.5 0.9))
(= (feedbackSensitivityRequest $confidence)
   (inferenceRequest (Inheritance EvalB EvalD)
     ((Sentence ((Inheritance EvalA EvalB) (stv 0.8 0.9)) (101))
      (Sentence ((Inheritance EvalA EvalC) (stv 0.7 0.8)) (102))
      (Sentence ((Inheritance EvalC EvalD) (stv 0.6 $confidence)) (104))
      (Sentence ((Inheritance EvalD EvalC) (stv 0.7 0.9)) (107))
      (Sentence (Distractor (stv 0.9 0.99)) (105))
      (Sentence ((Implication Distractor Noise) (stv 0.8 0.99)) (106))) 0))
(= (feedbackSensitivityRules $trace)
   (if (== $trace ())
       ()
       (let (inferenceTraceStep (plnProposal $rule $first $second) $derived $state)
            (car-atom $trace)
            (cons-atom ($rule (inferencePredictedTerm
                               (plnProposal $rule $first $second)))
              (feedbackSensitivityRules (cdr-atom $trace))))))
(= (feedbackSensitivityCompare $confidence)
   (let* (($request (feedbackSensitivityRequest $confidence))
          ($normal (validationValue
                     (inferenceEvaluateControlled
                       (inferenceControlDefaultState) $request 2)))
          ($fixed (validationValue
                    (inferenceEvaluateFixedState
                      (inferenceControlDefaultState) $request 2))))
         ($confidence
          (metamo (inferenceEvaluationField $normal status)
                  (feedbackSensitivityRules (inferenceEvaluationField $normal trace)))
          (fixedState (inferenceEvaluationField $fixed status)
                      (feedbackSensitivityRules (inferenceEvaluationField $fixed trace))))))
!(feedbackSensitivityCompare 0.60)
!(feedbackSensitivityCompare 0.61)
!(feedbackSensitivityCompare 0.62)
!(feedbackSensitivityCompare 0.63)
!(feedbackSensitivityCompare 0.64)
!(feedbackSensitivityCompare 0.65)
!(feedbackSensitivityCompare 0.66)
!(feedbackSensitivityCompare 0.67)
!(feedbackSensitivityCompare 0.68)
!(feedbackSensitivityCompare 0.69)
!(feedbackSensitivityCompare 0.70)

