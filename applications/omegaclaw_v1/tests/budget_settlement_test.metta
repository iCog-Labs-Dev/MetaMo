!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/budget_accounting))

(= (settleId $scope $resource $unit)
   (BudgetAccountId "host" $scope $resource $unit))
(= (settleAccount $scope $limit $spent $reserved $status $revision)
   (BudgetAccount (settleId $scope "commands" "units")
      $limit $spent $reserved $status $revision))
(= (settleOperation $costs)
   (BudgetOperation (read-file "/allowed/file")
      (PolicyOperation (candidate execute-skill) (target frameA)
         (skill "read-file") (permissions ("files.read")) (egress ()) (costs $costs))))
(= (settleRead $amount)
   (settleOperation ((ResourceCost "commands" "units" $amount))))
(= (settleRows $amount)
   ((AccountCost (settleId Global "commands" "units") $amount)
    (AccountCost (settleId (FrameTarget frameA) "commands" "units") $amount)))
(= (settleAccounts)
   ((settleAccount Global 10 2 1 Open 4)
    (settleAccount (FrameTarget frameA) 8 1 1 Open 2)
    (settleAccount (FrameTarget other) 20 0 0 Open 0)))
(= (settleFresh $accounts)
   (progn
      (change-state! &budget-account-state BudgetAccountsUninitialized)
      (initBudgetAccounts $accounts)))
(= (settleUnchanged $ticket $actual)
   (let* (($before (get-state &budget-account-state))
          ($result (settleOperationBudget $ticket $actual)))
      ($result (=alpha $before (get-state &budget-account-state)))))
(= (settleCurrentAccounts)
   (let (BudgetAccounts $accounts $_) (get-state &budget-account-state) $accounts))
;; Test-only state mutation for revocation/corruption scenarios.
(= (settleReplaceAccounts $accounts)
   (let (BudgetAccounts $_ $records) (get-state &budget-account-state)
      (change-state! &budget-account-state (BudgetAccounts $accounts $records))))

!(test (settleUnchanged (DispatchTicket "missing") (settleRows 1))
   ((BudgetAccountingRejected AccountsNotInitialized) True))
!(test (initBudgetAccounts (settleAccounts)) (BudgetAccountsInitialized 3))
!(test (settleUnchanged (DispatchTicket "missing") (settleRows 1))
   ((BudgetAccountingRejected UnknownDispatch) True))
!(test (settleUnchanged (DispatchTicket "missing") Unknown)
   ((BudgetAccountingRejected UnknownDispatch) True))
!(test (reserveOperationBudget (DispatchTicket "first") (settleRead 4) (settleRows 4))
   (BudgetReserved (DispatchTicket "first") (settleRows 4)))
!(test (reserveOperationBudget (DispatchTicket "second") (settleRead 1) (settleRows 1))
   (BudgetReserved (DispatchTicket "second") (settleRows 1)))

;; Unknown is not zero consumption: capacity remains reserved.
!(test (settleUnchanged (DispatchTicket "first") Unknown)
   ((BudgetAccountingPending (DispatchTicket "first") UsageUnknown) True))
!(test (budgetAvailability (settleId Global "commands" "units"))
   (ResourceBudget "commands" "units" 2 Open))
!(test (settleUnchanged "first" (settleRows 1))
   ((BudgetAccountingRejected InvalidDispatchId) True))
!(test (settleUnchanged (DispatchTicket "") (settleRows 1))
   ((BudgetAccountingRejected InvalidDispatchId) True))
!(test (settleUnchanged (DispatchTicket $id) (settleRows 1))
   ((BudgetAccountingRejected InvalidBudgetSettlement) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows $amount))
   ((BudgetAccountingRejected InvalidBudgetSettlement) True))
!(test (settleUnchanged (DispatchTicket "first") ())
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") "unknown")
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (Broken))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows -1))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows 0.5))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows 1.0))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows "1"))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows True))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows 9007199254740992))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (settleId (FrameTarget frameA) "commands" "units") 2)))
   ((BudgetAccountingRejected ScopeUsageMismatch) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (settleId (FrameTarget "frameA") "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (BudgetAccountId "wrong" (FrameTarget frameA) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (settleId (FrameTarget frameA) "commands" "tokens") 1)))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (settleId (FrameTarget frameA) "commands" "units") 1) (AccountCost (settleId (FrameTarget other) "commands" "units") 1)))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleUnchanged (DispatchTicket "first") ((AccountCost (settleId Global "commands" "units") 1) (AccountCost (settleId (FrameTarget frameA) "commands" "units") 1) (AccountCost (settleId Global "commands" "units") 2)))
   ((BudgetAccountingRejected InvalidActualCosts) True))

;; Charge two of four reserved units, preserving the other dispatch's reservation
;; and the preexisting pending capacity. Revisions advance exactly once per account.
!(test (settleOperationBudget (DispatchTicket "first") (settleRows 2))
   (BudgetSettled (DispatchTicket "first") (settleRows 2)))
!(test (settleCurrentAccounts)
   ((settleAccount Global 10 4 2 Open 7)
    (settleAccount (FrameTarget frameA) 8 3 2 Open 5)
    (settleAccount (FrameTarget other) 20 0 0 Open 0)))
!(test (budgetAvailability (settleId Global "commands" "units"))
   (ResourceBudget "commands" "units" 4 Open))
!(test (budgetAvailability (settleId (FrameTarget frameA) "commands" "units"))
   (ResourceBudget "commands" "units" 3 Open))
!(test (settleUnchanged (DispatchTicket "first") (settleRows 2))
   ((BudgetSettled (DispatchTicket "first") (settleRows 2)) True))
!(test (settleUnchanged (DispatchTicket "first")
   ((AccountCost (settleId (FrameTarget frameA) "commands" "units") 2)
    (AccountCost (settleId Global "commands" "units") 2)
    (AccountCost (settleId Global "commands" "units") 2)))
   ((BudgetSettled (DispatchTicket "first") (settleRows 2)) True))
!(test (settleUnchanged (DispatchTicket "first") (settleRows 1))
   ((BudgetAccountingRejected ConflictingReplay) True))
!(test (settleUnchanged (DispatchTicket "first") Unknown)
   ((BudgetSettled (DispatchTicket "first") (settleRows 2)) True))
;; An old reservation replay must not charge again after settlement.
!(bind! &settlement-replay-before (new-state (get-state &budget-account-state)))
!(test (reserveOperationBudget (DispatchTicket "first") (settleRead 4) (settleRows 4))
   (BudgetReserved (DispatchTicket "first") (settleRows 4)))
!(test (== (get-state &budget-account-state) (get-state &settlement-replay-before)) True)
!(test (reserveOperationBudget (DispatchTicket "first") (settleRead 3) (settleRows 3))
   (BudgetAccountingRejected ConflictingReplay))

;; Proven non-start/zero consumption releases only the second reservation.
!(test (settleOperationBudget (DispatchTicket "second") (settleRows 0))
   (BudgetSettled (DispatchTicket "second") (settleRows 0)))
!(test (settleCurrentAccounts)
   ((settleAccount Global 10 4 1 Open 8)
    (settleAccount (FrameTarget frameA) 8 3 1 Open 6)
    (settleAccount (FrameTarget other) 20 0 0 Open 0)))
!(test (settleUnchanged (DispatchTicket "second") (settleRows 0))
   ((BudgetSettled (DispatchTicket "second") (settleRows 0)) True))
;; Released capacity is spendable by a new dispatch; measured failure costs use
;; the same settlement path as success, never an implicit refund.
!(test (reserveOperationBudget (DispatchTicket "third") (settleRead 4) (settleRows 4))
   (BudgetReserved (DispatchTicket "third") (settleRows 4)))
!(test (settleOperationBudget (DispatchTicket "third") (settleRows 4))
   (BudgetSettled (DispatchTicket "third") (settleRows 4)))
!(test (budgetAvailability (settleId (FrameTarget frameA) "commands" "units"))
   (ResourceBudget "commands" "units" 0 Open))

;; Revocation cannot prevent accounting for consumption or reopen closed accounts.
!(settleFresh ((settleAccount Global 10 0 0 Open 0)
   (settleAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(reserveOperationBudget (DispatchTicket "closed") (settleRead 2) (settleRows 2))
!(settleReplaceAccounts ((settleAccount Global 10 0 2 Closed 2)
   (settleAccount (FrameTarget frameA) 10 0 2 Exhausted 2)))
!(test (settleOperationBudget (DispatchTicket "closed") (settleRows 1))
   (BudgetSettled (DispatchTicket "closed") (settleRows 1)))
!(test (settleCurrentAccounts)
   ((settleAccount Global 10 1 0 Closed 3)
    (settleAccount (FrameTarget frameA) 10 1 0 Exhausted 3)))

;; Missing accounts, insufficient retained capacity and revision overflow fail
;; without committing changes to an earlier account in the same settlement.
!(settleFresh ((settleAccount Global 10 0 0 Open 0)
   (settleAccount (FrameTarget frameA) 10 0 0 Open 0)))
!(reserveOperationBudget (DispatchTicket "integrity") (settleRead 2) (settleRows 2))
!(settleReplaceAccounts ((settleAccount Global 10 0 2 Open 1)))
!(test (settleUnchanged (DispatchTicket "integrity") (settleRows 1))
   ((BudgetAccountingRejected MissingBudgetAccount) True))
!(settleReplaceAccounts ((settleAccount Global 10 0 2 Open 1)
   (settleAccount (FrameTarget frameA) 10 0 1 Open 1)))
!(test (settleUnchanged (DispatchTicket "integrity") (settleRows 1))
   ((BudgetAccountingRejected ReservationBalanceMismatch) True))
!(settleReplaceAccounts ((settleAccount Global 10 0 2 Open 1)
   (settleAccount (FrameTarget frameA) 10 0 2 Open 9007199254740991)))
!(test (settleUnchanged (DispatchTicket "integrity") (settleRows 1))
   ((BudgetAccountingRejected BudgetRevisionExhausted) True))

;; Overrun can exceed the account limit: retain the actual report, close accounts,
;; and keep reserved capacity pending reconciliation instead of overdraw/refund.
!(settleFresh ((settleAccount Global 10 0 0 Open 0)
   (settleAccount (FrameTarget frameA) 3 0 0 Open 0)
   (settleAccount (FrameTarget other) 20 0 0 Open 0)))
!(reserveOperationBudget (DispatchTicket "overrun") (settleRead 2) (settleRows 2))
!(test (settleOperationBudget (DispatchTicket "overrun") (settleRows 5))
   (BudgetAccountingPending (DispatchTicket "overrun") BudgetOverrun))
!(test (settleCurrentAccounts)
   ((settleAccount Global 10 0 2 Closed 2)
    (settleAccount (FrameTarget frameA) 3 0 2 Closed 2)
    (settleAccount (FrameTarget other) 20 0 0 Open 0)))
!(test (get-state &budget-account-state)
   (BudgetAccounts (settleCurrentAccounts)
      ((BudgetSettlement
         (BudgetReservation (DispatchTicket "overrun") (settleRead 2) (settleRows 2)
            ((settleAccount (FrameTarget frameA) 3 0 0 Open 0)
             (settleAccount Global 10 0 0 Open 0)))
         (settleRows 5) (BudgetAccountingPending (DispatchTicket "overrun") BudgetOverrun)))))
!(test (budgetAvailability (settleId Global "commands" "units"))
   (ResourceBudget "commands" "units" 8 Closed))
!(test (budgetAvailability (settleId (FrameTarget frameA) "commands" "units"))
   (ResourceBudget "commands" "units" 1 Closed))
!(test (reserveOperationBudget (DispatchTicket "blocked") (settleRead 0) (settleRows 0))
   (BudgetAccountingRejected BudgetExhausted))
!(test (settleUnchanged (DispatchTicket "overrun") (settleRows 5))
   ((BudgetAccountingPending (DispatchTicket "overrun") BudgetOverrun) True))
!(test (settleUnchanged (DispatchTicket "overrun") Unknown)
   ((BudgetAccountingPending (DispatchTicket "overrun") BudgetOverrun) True))
!(test (settleUnchanged (DispatchTicket "overrun") (settleRows 1))
   ((BudgetAccountingRejected ConflictingReplay) True))

;; Explicit cost-free operations still have a retained settlement/replay record.
!(settleFresh ())
!(reserveOperationBudget (DispatchTicket "free") (settleOperation ()) ())
!(test (settleOperationBudget (DispatchTicket "free") ())
   (BudgetSettled (DispatchTicket "free") ()))
!(test (settleUnchanged (DispatchTicket "free") ())
   ((BudgetSettled (DispatchTicket "free") ()) True))
!(test (settleUnchanged (DispatchTicket "free") (settleRows 0))
   ((BudgetAccountingRejected InvalidActualCosts) True))

;; Multi-resource settlement charges distinct measured costs and releases all
;; unused capacity together; a missing resource cannot partially settle a ticket.
(= (settleMultiOperation)
   (settleOperation ((ResourceCost "commands" "units" 2) (ResourceCost "tokens" "tokens" 5))))
(= (settleMultiRows $commands $tokens)
   ((AccountCost (settleId Global "commands" "units") $commands)
    (AccountCost (settleId (FrameTarget frameA) "commands" "units") $commands)
    (AccountCost (settleId Global "tokens" "tokens") $tokens)
    (AccountCost (settleId (FrameTarget frameA) "tokens" "tokens") $tokens)))
!(settleFresh ((settleAccount Global 10 0 0 Open 0)
   (settleAccount (FrameTarget frameA) 10 0 0 Open 0)
   (BudgetAccount (settleId Global "tokens" "tokens") 10 1 0 Open 0)
   (BudgetAccount (settleId (FrameTarget frameA) "tokens" "tokens") 10 2 0 Open 0)))
!(reserveOperationBudget (DispatchTicket "multi") (settleMultiOperation) (settleMultiRows 2 5))
!(test (settleUnchanged (DispatchTicket "multi") (settleRows 1))
   ((BudgetAccountingRejected InvalidActualCosts) True))
!(test (settleOperationBudget (DispatchTicket "multi") (settleMultiRows 1 3))
   (BudgetSettled (DispatchTicket "multi") (settleMultiRows 1 3)))
!(test (settleCurrentAccounts)
   ((settleAccount Global 10 1 0 Open 2)
    (settleAccount (FrameTarget frameA) 10 1 0 Open 2)
    (BudgetAccount (settleId Global "tokens" "tokens") 10 4 0 Open 2)
    (BudgetAccount (settleId (FrameTarget frameA) "tokens" "tokens") 10 5 0 Open 2)))

;; Corrupt completed records cannot be accepted as evidence or charged again.
!(change-state! &budget-account-state
   (BudgetAccounts () ((BudgetSettlement
      (BudgetReservation (DispatchTicket "corrupt") (settleOperation ()) () ())
      () (BudgetSettled (DispatchTicket "wrong-id") ())))))
!(test (settleUnchanged (DispatchTicket "corrupt") ())
   ((BudgetAccountingRejected InvalidBudgetReservations) True))
!(change-state! &budget-account-state Broken)
!(test (settleUnchanged (DispatchTicket "corrupt") ())
   ((BudgetAccountingRejected InvalidBudgetAccounts) True))

;; Malformed retained reservations and actual reports must short-circuit before
;; destructuring/cost arithmetic, preserving state and returning a typed rejection.
!(change-state! &budget-account-state
   (BudgetAccounts () ((BudgetSettlement
      (BudgetReservation (DispatchTicket "corrupt") (settleRead 1) (Broken) ())
      (Broken) (BudgetSettled (DispatchTicket "corrupt") (Broken))))))
!(test (settleUnchanged (DispatchTicket "corrupt") ())
   ((BudgetAccountingRejected InvalidBudgetReservations) True))
!(change-state! &budget-account-state
   (BudgetAccounts () ((BudgetSettlement
      (BudgetReservation (DispatchTicket "corrupt") (settleRead 1) (settleRows 1) ())
      "invalid" (BudgetSettled (DispatchTicket "corrupt") "invalid")))))
!(test (settleUnchanged (DispatchTicket "corrupt") ())
   ((BudgetAccountingRejected InvalidBudgetReservations) True))

;; Integer upper bound is preserved exactly, without float rounding or overflow.
!(settleFresh ((settleAccount Global 9007199254740991 9007199254740990 0 Open 0)
   (settleAccount (FrameTarget frameA) 9007199254740991 9007199254740990 0 Open 0)))
!(reserveOperationBudget (DispatchTicket "maximum") (settleRead 1) (settleRows 1))
!(test (settleOperationBudget (DispatchTicket "maximum") (settleRows 1))
   (BudgetSettled (DispatchTicket "maximum") (settleRows 1)))
!(test (settleCurrentAccounts)
   ((settleAccount Global 9007199254740991 9007199254740991 0 Open 2)
    (settleAccount (FrameTarget frameA) 9007199254740991 9007199254740991 0 Open 2)))
!(test (budgetAvailability (settleId Global "commands" "units"))
   (ResourceBudget "commands" "units" 0 Open))
