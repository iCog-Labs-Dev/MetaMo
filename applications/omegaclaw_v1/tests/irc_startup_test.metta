;; Real first-frame startup, config example and handlers; socket/provider doubles.
!(import! &self (library lib_import))
!(import! &self (library OmegaClaw-Core src/loop))
!(import! &self fixtures/full_loop.metta)
!(import! &self (library MetaMo applications/omegaclaw_v1/runtime_support))
(= (getPrompt) "Use only the selected command.")
(= (maxFeedback) 512)
!(import! &self (library MetaMo applications/omegaclaw_v1/host_startup))
!(import! &self fixtures/irc_startup_fixture.py)
!(import! &self fixtures/irc_routing_fixture.py)
!(import! &self (library OmegaClaw-Core channels/irc.py))
(= (commchannel) irc)
!(import! &self (library OmegaClaw-Core src/channels))
!(py-call (host_config_fixture.setup))
!(initContextFrame)
!(fullLoopStartSession)
!(test (py-call (irc_startup_fixture.configure)) 1)
!(test (initializeHostStartup) True)
!(test (coreLoopPrepare) 1)
!(test (cfv2-root-current-frame-id) ())
!(test (py-call (irc_routing_fixture.writes)) 0)
!(py-call (irc_routing_fixture.connect "same"))
!(ctx-ingest-user-message "Check the configured IRC reply")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(bind! &initial-frame (new-state (cfv2-root-current-frame-id)))
!(test (coreLoopPrepare) 1)
!(test (cfv2-root-current-frame-id) (get-state &initial-frame))
!(test (py-call (irc_routing_fixture.writes)) 0)
(= (replyTicket) (coreDispatchCapture (AdmissionRequest propose-candidate current-frame respond)))
(= (replyCommand) (quote (send "Configured IRC reply.")))
!(bind! &initial-ticket (new-state (replyTicket)))
;; Repeated preparation cannot reinstall and invalidate captured tickets.
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (get-state &initial-ticket) (replyCommand))
   (DispatchResult Executed Feasible (SendObservation "irc:irc.example.org:6667:#room"
      (TransportSubmission Submitted Complete 1 1))))
!(test (coreDispatchCommand (get-state &initial-ticket) (replyCommand))
   (DispatchResult Executed Feasible (SendObservation "irc:irc.example.org:6667:#room"
      (TransportSubmission Submitted Complete 1 1))))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (coreDispatchCommand
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame ask-clarification))
   (quote (send "Which task should I help with?")))
   (DispatchResult Executed Feasible (SendObservation "irc:irc.example.org:6667:#room"
      (TransportSubmission Submitted Complete 1 1))))
!(test (py-call (irc_routing_fixture.writes)) 2)
;; Mismatch fails before replacing policies; old tickets retain recorded outcomes.
!(test (py-call (irc_startup_fixture.reject_mismatch)) 1)
!(test (coreDispatchCommand (get-state &initial-ticket) (replyCommand))
   (DispatchResult Executed Feasible (SendObservation "irc:irc.example.org:6667:#room"
      (TransportSubmission Submitted Complete 1 1))))
!(test (py-call (irc_routing_fixture.writes)) 2)
;; A diagnostic never grants missing permissions or bypasses the final gate.
!(py-call (irc_startup_fixture.configure "denied"))
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (replyTicket) (replyCommand))
   (DispatchResult Blocked PermissionDenied none))
!(test (py-call (irc_routing_fixture.writes)) 2)
;; Read-only IRC startup is valid and stays read-only.
!(py-call (irc_startup_fixture.configure "read-only"))
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (replyTicket) (replyCommand))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (py-call (irc_routing_fixture.writes)) 2)
;; Later frames do not acquire the first frame's grants.
!(py-call (irc_startup_fixture.configure))
!(test (coreLoopPrepare) 1)
!(change-state! &cfv2-current-frame-id LaterFrame)
!(test (coreLoopPrepare) 1)
!(test (coreDispatchCommand (replyTicket) (replyCommand))
   (DispatchResult Blocked TargetMismatch none))
!(test (py-call (irc_routing_fixture.writes)) 2)
!(test (py-call (host_config_fixture.cleanup)) 1)
