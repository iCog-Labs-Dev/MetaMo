# Gemini API access
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL container credentials
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Application database connection
DATABASE_URL=postgresql+psycopg2://your_database_user:your_database_password@postgres:5432/your_database_name

# Alembic migration database connection
ALEMBIC_DATABASE_URL=postgresql+psycopg2://your_database_user:your_database_password@postgres:5432/your_database_name

# Redis container connection
REDIS_URL=redis://redis:6379/0

# Qwestor engine settings
QWESTOR_USECASE_DIR=/app/usecase
QWESTOR_CYCLE_TIMEOUT=60