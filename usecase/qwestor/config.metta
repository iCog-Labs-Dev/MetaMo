(= (qwestorGoalTargetWeights)
    (
        (BENEFICIAL_BASE 0.55)
        (BENEFICIAL_SAFETY_GAP_WEIGHT 0.25)
        (BENEFICIAL_LONG_HELP_GAP_WEIGHT 0.20)
        (HONESTY_BASE 0.60)
        (HONESTY_GROUNDING_GAP_WEIGHT 0.25)
        (HONESTY_VERIFICATION_WEIGHT 0.15)
        (SAFETY_BASE 0.60)
        (SAFETY_RISK_WEIGHT 0.25)
        (SAFETY_OUTCOME_GAP_WEIGHT 0.15)
        (HELP_SHORT_URGENCY_WEIGHT 0.55)
        (HELP_SHORT_OUTCOME_GAP_WEIGHT 0.45)
        (HELP_LONG_PLAN_WEIGHT 0.35)
        (HELP_LONG_MULTI_SOURCE_WEIGHT 0.25)
        (HELP_LONG_OUTCOME_GAP_WEIGHT 0.40)
        (KNOWLEDGE_UNFAMILIARITY_WEIGHT 0.35)
        (KNOWLEDGE_EVIDENCE_WEIGHT 0.30)
        (KNOWLEDGE_GROUNDING_GAP_WEIGHT 0.35)
        (NOVELTY_FEATURE_WEIGHT 0.50)
        (NOVELTY_REFLECTION_WEIGHT 0.25)
        (NOVELTY_OUTCOME_GAP_WEIGHT 0.25)
        (ORIGINALITY_CREATIVITY_WEIGHT 0.45)
        (ORIGINALITY_MULTI_SOURCE_WEIGHT 0.30)
        (ORIGINALITY_OUTCOME_GAP_WEIGHT 0.25)
        (MODERATE_SUCCESS_RISK_WEIGHT 0.35)
        (MODERATE_SUCCESS_URGENCY_WEIGHT 0.25)
        (MODERATE_SUCCESS_OUTCOME_GAP_WEIGHT 0.40)
        (BREAKTHROUGH_NOVELTY_WEIGHT 0.45)
        (BREAKTHROUGH_REFLECTION_WEIGHT 0.30)
        (BREAKTHROUGH_OUTCOME_GAP_WEIGHT 0.25)
        (COHERENCE_AMBIGUITY_WEIGHT 0.35)
        (COHERENCE_MULTI_SOURCE_WEIGHT 0.25)
        (COHERENCE_OUTCOME_GAP_WEIGHT 0.40)
        (SOCIAL_AMBIGUITY_WEIGHT 0.30)
        (SOCIAL_NOVICE_WEIGHT 0.20)
        (SOCIAL_OUTCOME_GAP_WEIGHT 0.50)
        (EFFICIENCY_URGENCY_WEIGHT 0.45)
        (EFFICIENCY_EFFORT_WEIGHT 0.25)
        (EFFICIENCY_OUTCOME_GAP_WEIGHT 0.30)
        (ACCURACY_RISK_WEIGHT 0.40)
        (ACCURACY_VERIFICATION_WEIGHT 0.25)
        (ACCURACY_OUTCOME_GAP_WEIGHT 0.35)
    )
)

;; Return coefficients for structural-overgoal coupling
(= (qwestorOvergoalWeights)
    (
        (INDIVIDUATION_BASE 0.35)
        (INDIVIDUATION_NORMATIVE_WEIGHT 0.25)
        (INDIVIDUATION_COHERENCE_WEIGHT 0.15)
        (INDIVIDUATION_PRESSURE_WEIGHT 0.25)
        (TRANSCENDENCE_BASE 0.15)
        (TRANSCENDENCE_GROWTH_WEIGHT 0.35)
        (TRANSCENDENCE_USEFUL_NOVELTY_WEIGHT 0.25)
        (TRANSCENDENCE_BENEFICIAL_WEIGHT 0.15)
        (TRANSCENDENCE_PRESSURE_WEIGHT 0.25)
    )
)

;; Return the initial safe-region and embodiment parameters
(= (qwestorStabilityConfig)
    (
        (INDIVIDUATION_FLOOR 0.30)
        (BENEFICIAL_FLOOR 0.55)
        (HONESTY_FLOOR 0.55)
        (SAFETY_FLOOR 0.55)
        (GOAL_NORM_MAX 3.00)
        (THRESHOLD_MIN 0.20)
        (THRESHOLD_MAX 0.95)
        (AROUSAL_MIN 0.10)
        (AROUSAL_MAX 0.90)
        (BOUNDARY_WIDTH 0.10)
        (BOUNDARY_CAUTION_GAIN 0.25)
        (PROJECTION_CAUTION_GAIN 0.10)
        (CONTRACTION_CONSTANT 0.90)
        (CONTRACTION_EPSILON 0.05)
    )
)

;; Return incremental embodiment and parallel-merge parameters
(= (qwestorCoherenceConfig)
    (
        (ALPHA_0 0.10)
        (BETA_0 0.15)
        (MIN_ALPHA 0.000001)
        (LIPSCHITZ_CONSTANT 1.00)
        (MAX_ALLOWED_DRIFT 0.10)
        (MIN_ALPHA_SCALE 0.125)
        (STATE_DRIFT_WEIGHT 0.50)
        (SELF_MODEL_DRIFT_WEIGHT 0.50)
        (MERGE_COHERENCE_CORRECTION 0.05)
    )
)

;; Return the canonical default values for goal coordinates.
(= (qwestorDefaultGoalPairs)
    (
        (individuation 0.60)
        (transcendence 0.50)
        (beneficial 0.60)
        (honesty 0.65)
        (safety 0.65)
        (help_short 0.55)
        (help_long 0.45)
        (knowledge 0.52)
        (novelty 0.46)
        (originality 0.48)
        (success_moderate 0.62)
        (success_breakthrough 0.44)
        (coherence 0.58)
        (social 0.58)
        (efficiency 0.60)
        (accuracy 0.70)
        (hallucinate 0.35)
        (redundant 0.30)
        (rabbit_hole 0.28)
        (premature 0.30)
    )
)

;; Return the canonical default values for modulators
(= (qwestorDefaultModulatorPairs)
    (
        (valence 0.50)
        (arousal 0.40)
        (approach 0.40)
        (resolution 0.40)
        (threshold 0.30)
        (securing 0.10)
        (urgency 0.20)
        (risk_aversion 0.40)
        (error_tolerance 0.45)
        (failure_wariness 0.10)
        (user_expertise 0.50)
        (topic_familiarity 0.50)
        (creativity 0.45)
    )
)

;; Return the deterministic context used when Qwestor cannot parse a provider response
(= (qwestorNeutralContext)
    (
        (complexity 0.30)
        (specificity 0.50)
        (ambiguity 0.00)
        (requested_threshold 0.00)
        (urgency 0.00)
        (user_expertise 0.50)
        (topic_familiarity 0.50)
        (failure_pressure 0.00)
        (verification 0.00)
        (reflective_intent 0.00)
        (external_evidence 0.00)
        (evidence_available 0.00)
        (primary_operation unknown)
        (final_deliverable unknown)
        (task_plan 0.00)
        (multi_source 0.00)
        (signed_valence 0.00)
        (additional_information_expected 0.00)
        (missing_required_input 0.00)
        (intent_type mixed)
        (query_type unknown)
    )
)

;; Read a named configuration value and return the provided fallback when absent
(= (qwestorConfigGet $pairs $name $default)
    (featurePairsGet $pairs $name $default)
)
