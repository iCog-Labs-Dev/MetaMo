!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/tests/fixtures/typed_policy))

!(test (resourceBudgetFromAccounting "commands" "units" 10 3 4 Open)
   (ResourceBudget "commands" "units" 3 Open))
!(test (resourceBudgetFromAccounting "commands" "units" 10 3 7 Open)
   (ResourceBudget "commands" "units" 0 Open))
!(test (resourceBudgetFromAccounting "commands" "units" 10 11 0 Open)
   (BudgetAccountingRejected BudgetOvercommitted))
!(test (resourceBudgetFromAccounting "commands" "units" 10 3 8 Open)
   (BudgetAccountingRejected BudgetOvercommitted))
!(test (resourceBudgetFromAccounting "commands" "units" 10 -1 0 Open)
   (BudgetAccountingRejected InvalidBudgetAccounting))
!(test (resourceBudgetFromAccounting "commands" "units" 10 0 "4" Open)
   (BudgetAccountingRejected InvalidBudgetAccounting))
!(test (resourceBudgetFromAccounting "commands" "units" True 0 0 Open)
   (BudgetAccountingRejected InvalidBudgetAccounting))
!(test (resourceBudgetFromAccounting "commands" "units" 9007199254740992 0 0 Open)
   (BudgetAccountingRejected InvalidBudgetAccounting))
!(test (resourceBudgetFromAccounting "commands" "units" 10 0 0 Unknown)
   (BudgetAccountingRejected InvalidBudgetAccounting))
!(test (resourceBudgetFromAccounting "commands" "units" 10 0 0 Closed)
   (ResourceBudget "commands" "units" 10 Closed))
!(test (resourceBudgetFromAccounting "" "units" 10 0 0 Open)
   (BudgetAccountingRejected InvalidBudgetAccounting))

(= (accountingScope $target $budget)
   (typedPolicyFixture $target ("read-file") ("files.read") () () $budget))
(= (accountingOperation $costs)
   (PolicyOperation (candidate execute-skill) (target "policy-frame")
      (skill "read-file") (permissions ("files.read")) (egress ()) (costs $costs)))
(= (accountingAdmission $global $frame $costs)
   (typedOperationPolicyGate (accountingScope Global $global)
      (accountingScope (FrameTarget "policy-frame") $frame)
      (accountingOperation $costs) execute-skill "policy-frame"))

;; A pending reservation makes another operation unaffordable despite Open.
!(test (accountingAdmission
   ((resourceBudgetFromAccounting "commands" "units" 10 3 4 Open))
   (typedBudgetFixture) ((ResourceCost "commands" "units" 4)))
   (GateDecision Rejected BudgetExhausted))
!(test (accountingAdmission (typedBudgetFixture)
   ((resourceBudgetFromAccounting "commands" "units" 10 3 4 Open))
   ((ResourceCost "commands" "units" 4))) (GateDecision Rejected BudgetExhausted))
!(test (accountingAdmission
   ((resourceBudgetFromAccounting "commands" "units" 10 3 4 Open))
   (typedBudgetFixture) ((ResourceCost "commands" "units" 3)))
   (GateDecision Admitted Feasible))
;; Invalid accounting never becomes an available budget or an implicit zero.
!(test (accountingAdmission
   ((resourceBudgetFromAccounting "commands" "units" 10 3 8 Open))
   (typedBudgetFixture) ((ResourceCost "commands" "units" 0)))
   (GateDecision Rejected InvalidGlobalPolicy))
!(test (accountingAdmission () () ()) (GateDecision Admitted Feasible))
!(test (accountingAdmission () () ((ResourceCost "commands" "units" 0)))
   (GateDecision Rejected MissingResourceBudget))
!(test (accountingAdmission ((ResourceBudget "commands" "units" 1 Closed))
   (typedBudgetFixture) ((ResourceCost "commands" "units" 0)))
   (GateDecision Rejected BudgetExhausted))
;; Every resource is checked, not just the first affordable cost.
!(test (accountingAdmission (typedBudgetFixture) (typedBudgetFixture)
   ((ResourceCost "commands" "units" 1) (ResourceCost "tokens" "tokens" 1)))
   (GateDecision Rejected MissingResourceBudget))
!(test (accountingAdmission (typedBudgetFixture) (typedBudgetFixture)
   ((ResourceCost "commands" "units" 1) (ResourceCost "commands" "units" 1)))
   (GateDecision Rejected InvalidOperation))
!(test (accountingAdmission (typedBudgetFixture) (typedBudgetFixture)
   ((ResourceCost "commands" "tokens" 1))) (GateDecision Rejected ResourceUnitMismatch))
!(test (accountingAdmission (typedBudgetFixture) (typedBudgetFixture)
   ((ResourceCost "commands" "units" "1"))) (GateDecision Rejected InvalidOperation))
!(test (accountingAdmission (typedBudgetFixture) (typedBudgetFixture)
   ((ResourceCost "commands" "units" 9007199254740992))) (GateDecision Rejected InvalidOperation))
;; Accounting examples after releasing an unstarted reservation, or settling
;; an actual cost of two from a reservation of four (three already spent).
!(test (resourceBudgetFromAccounting "commands" "units" 10 3 0 Open)
   (ResourceBudget "commands" "units" 7 Open))
!(test (resourceBudgetFromAccounting "commands" "units" 10 5 0 Open)
   (ResourceBudget "commands" "units" 5 Open))
