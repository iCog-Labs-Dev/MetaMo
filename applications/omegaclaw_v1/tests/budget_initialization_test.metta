!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/budget_accounting))

(= (initAccount $scope $limit $spent $reserved $status $revision)
   (BudgetAccount (BudgetAccountId "host" $scope "commands" "units")
      $limit $spent $reserved $status $revision))

;; Every rejection must leave the entire store uninitialized, including when
;; a valid first row precedes an invalid one. Later valid initialization can retry.
(= (rejectedInit $accounts)
   (let $result (initBudgetAccounts $accounts)
      ($result (get-state &budget-account-state))))

!(test (rejectedInit "not a list")
   ((BudgetAccountingRejected InvalidBudgetAccounts) BudgetAccountsUninitialized))
!(test (rejectedInit (broken))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((BudgetAccount)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 3 8 Open 0)))
   ((BudgetAccountingRejected BudgetOvercommitted) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 11 0 Open 0)))
   ((BudgetAccountingRejected BudgetOvercommitted) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global -1 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 -1 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 -1 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 1.5 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0.5 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0.5 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10.0 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global "10" 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global True 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 9007199254740992 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open -1)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open 0.5)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open 9007199254740992)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Unknown 0)))
   ((BudgetAccountingRejected InvalidBudgetAccounting) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Other 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount (FrameTarget "") 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount (FrameTarget 123) 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((BudgetAccount (BudgetAccountId "" Global "commands" "units") 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((BudgetAccount (BudgetAccountId "host" Global "" "units") 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccounting) BudgetAccountsUninitialized))
!(test (rejectedInit ((BudgetAccount (BudgetAccountId "host" Global "commands" "") 10 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccounting) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open 0) (initAccount Global 20 0 0 Open 1)))
   ((BudgetAccountingRejected DuplicateBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open 0) (initAccount Global 10 0 0 Open 0)))
   ((BudgetAccountingRejected DuplicateBudgetAccount) BudgetAccountsUninitialized))
!(test (rejectedInit ((initAccount Global 10 0 0 Open 0) (initAccount (FrameTarget "f") 1 2 0 Open 0)))
   ((BudgetAccountingRejected BudgetOvercommitted) BudgetAccountsUninitialized))
!(test (rejectedInit ((BudgetAccount (BudgetAccountId "host" Global "commands" "units") $unknown 0 0 Open 0)))
   ((BudgetAccountingRejected InvalidBudgetAccounts) BudgetAccountsUninitialized))

;; Distinct scopes, namespaces, resources, units and native/string frame IDs
;; retain their exact identities. Preserve supplied balances, status and revision.
(= (initialAccounts)
   ((initAccount Global 10 3 4 Open 7)
    (initAccount (FrameTarget frameA) 5 2 3 Exhausted 2)
    (initAccount (FrameTarget "frameA") 0 0 0 Closed 0)
    (BudgetAccount (BudgetAccountId "other-host" Global "commands" "units") 1 0 0 Open 0)
    (BudgetAccount (BudgetAccountId "host" Global "tokens" "tokens") 9007199254740991 0 0 Open 9007199254740991)
    (BudgetAccount (BudgetAccountId "host" Global "commands" "other-unit") 1 0 0 Open 0)))
!(test (initBudgetAccounts (initialAccounts)) (BudgetAccountsInitialized 6))
!(test (get-state &budget-account-state) (BudgetAccounts (initialAccounts)))
!(test (initBudgetAccounts (initialAccounts)) (BudgetAccountingRejected AlreadyInitialized))
!(test (initBudgetAccounts ()) (BudgetAccountingRejected AlreadyInitialized))
!(test (initBudgetAccounts ((initAccount Global 100 0 0 Open 0)))
   (BudgetAccountingRejected AlreadyInitialized))
!(test (initBudgetAccounts "invalid replacement") (BudgetAccountingRejected AlreadyInitialized))
!(test (get-state &budget-account-state) (BudgetAccounts (initialAccounts)))

;; Test-only reset; there is deliberately no production reset function.
!(change-state! &budget-account-state BudgetAccountsUninitialized)
!(test (initBudgetAccounts ()) (BudgetAccountsInitialized 0))
!(test (get-state &budget-account-state) (BudgetAccounts ()))
!(test (initBudgetAccounts ((initAccount Global 10 0 0 Open 0)))
   (BudgetAccountingRejected AlreadyInitialized))
!(test (get-state &budget-account-state) (BudgetAccounts ()))

;; Bounded input: 129 distinct accounts fail without partially storing any;
;; the same session can then initialize with the allowed 128 accounts.
(= (manyInitAccounts $n)
   (if (== $n 0) ()
       (cons-atom
          (initAccount (FrameTarget (repr $n)) 1 0 0 Open 0)
          (manyInitAccounts (- $n 1)))))
!(change-state! &budget-account-state BudgetAccountsUninitialized)
!(test (rejectedInit (manyInitAccounts 129))
   ((BudgetAccountingRejected TooManyBudgetAccounts) BudgetAccountsUninitialized))
!(test (initBudgetAccounts (manyInitAccounts 128)) (BudgetAccountsInitialized 128))
!(test (get-state &budget-account-state) (BudgetAccounts (manyInitAccounts 128)))
