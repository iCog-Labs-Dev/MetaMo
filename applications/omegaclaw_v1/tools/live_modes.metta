;; Real services, one session, at most one active frame, unchanged mode registry.
!(test (py-call (live_cycle_probe.prepare)) 1)
!(initLoop)
!(initMemory)
!(initChannels)
!(initContextFrame)
!(initOperationSession)
!(initOmegaClawMotivation)

(= (modeLiveCycle $label)
   (progn
      (coreLoopPrepare)
      (let $outputs (collapse (motivationContextBlock))
         (progn
            (println! (LiveModePolicy $label $outputs))
            (py-call (live_modes_probe.capture $label "selection"))
            (size-atom $outputs)))))
(= (modeLiveDispatch $label $ticket $command)
   (let $result (coreLoopDispatchCommand $ticket $command)
      (progn
         (println! (LiveModeExecution $label $result))
         (py-call (live_modes_probe.capture $label "outcome"))
         $result)))
(= (modeLiveTransition)
   (let (ModeObservation $_ $_ $_
          (ModeTransitionState $before $_ $_ $_ $_)
          (ModeTransitionState $after $_ $_ $_ $_) $_) (lastModeObservation)
      ($before $after)))
(= (modeLiveSignals)
   (let (ModeObservation $_ $_ $signals $_ $_ $_) (lastModeObservation) $signals))
(= (modeLiveInput)
   (progn
      (change-state! &prevmsg (string-safe (repr (receive))))
      (change-state! &core-loop-new-message True)))

!(test (modeLiveCycle "initial-idle") 1)
!(test (constitutionalMode) Sleep)
!(test (selectedHostCommand) ())
!(modeLiveInput)
!(ctx-ingest-user-message (get-state &prevmsg))
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(bind! &live-mode-frame (new-state (cfv2-root-current-frame-id)))
!(test (py-call (live_modes_probe.open_commitment)) 1)
!(test (modeLiveCycle "wake") 1)
!(test (modeLiveTransition) (Sleep Engaged))
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) execute-skill)
!(bind! &live-read (new-state (selectedHostCommand)))
!(test (py-call (live_cycle_probe.change_file 0)) 1)
!(test (== (modeLiveDispatch "native-failure" (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (Error read-file FileUnavailable))) True)
!(bind! &live-failure (new-state (get-state &last-operation-outcome)))
!(test (ingestOperationOutcome (get-state &live-failure)) OutcomeDuplicate)
!(change-state! &core-loop-new-message False)
!(test (modeLiveCycle "execution-failure") 1)
!(test (modeLiveTransition) (Engaged Rumination))
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Failure 1))
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)
!(test (signalTrueIn (modeLiveSignals) failure) True)
!(test (get-state &failure-count) 1)
!(test (modeLiveCycle "pending-recovery") 1)
!(test (constitutionalMode) Rumination)
!(test (signalTrueIn (modeLiveSignals) failure) False)
!(test (signalTrueIn (modeLiveSignals) stalled-progress) True)
!(test (get-state &failure-count) 1)

!(test (py-call (live_cycle_probe.change_file 1)) 1)
!(modeLiveInput)
!(test (modeLiveCycle "recovery-read") 1)
!(test (constitutionalMode) Rumination)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) execute-skill)
!(test (modeLiveDispatch "recovery-read" (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "live cycle approved content"))
!(bind! &live-success-ticket (new-state (coreLoopDispatchBegin)))
!(change-state! &core-loop-new-message False)
!(test (modeLiveCycle "resolved-recovery") 1)
!(test (modeLiveTransition) (Rumination Engaged))
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Success 0))
!(test (signalTrueIn (modeLiveSignals) stalled-progress) False)
!(test (get-state &failure-count) 1)

;; Policy is revoked before real provider anger extraction; Threat cannot grant it.
!(test (py-call (live_cycle_probe.policy 0)) 1)
!(modeLiveInput)
!(test (modeLiveCycle "threat-input") 1)
!(test (modeLiveTransition) (Engaged Threat))
!(test (or (signalRatioAtLeastIn (modeLiveSignals) user-angry classifier-score 0.0)
           (signalRatioAtLeastIn (modeLiveSignals) danger classifier-score 0.0)) True)
!(test (selectedHostCommand) ())
!(test (modeLiveDispatch "threat-denied" (get-state &live-success-ticket) (get-state &live-read))
   (DispatchResult Blocked MissingDecision none))
;; Also exercise the authoritative operation gate under Threat with a fresh ticket.
!(test (coreDispatchCommand (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill))
      (get-state &live-read)) (DispatchResult Blocked PermissionDenied none))
!(change-state! &core-loop-new-message False)
!(test (modeLiveCycle "cleared-threat") 1)
!(test (modeLiveTransition) (Threat Engaged))
!(test (signalRatioAtLeastIn (modeLiveSignals) user-angry classifier-score 0.0) False)
!(test (signalRatioAtLeastIn (modeLiveSignals) danger classifier-score 0.0) False)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)

;; Host confirms the exact recorded successful read fulfilled this bounded task.
!(test (py-call (live_modes_probe.complete)) 1)
!(test (collapse (cfv2-complete-current-frame-to-stm "Observed approved file content after repair"))
   (FRAME-COMPLETED-STORED-STM))
!(test (cfv2-frame-refs-by-status Active) ())
!(test (size-atom (cfv2-frame-refs-by-status Completed)) 1)
!(test (modeLiveCycle "completed-task") 1)
!(test (modeLiveTransition) (Engaged Sleep))
!(test (frameBundleCurrentId (activeFrameBundle)) ())
!(test (frameRuntimeTaskOpen (activeFrameBundle)) False)
!(test (modeLiveSignals) ())
!(test (selectedHostCommand) ())
!(test (modeLiveDispatch "sleep-old-ticket" (get-state &live-success-ticket) (get-state &live-read))
   (DispatchResult Blocked MissingDecision none))
!(test (modeLiveDispatch "sleep-legacy-ticket" LegacyDispatch (get-state &live-read))
   (DispatchResult Blocked MissingDecision none))
!(test (modeLiveCycle "continued-sleep") 1)
!(test (constitutionalMode) Sleep)
!(test (modeLiveSignals) ())
!(test (selectedHostCommand) ())
