(= (plnTermStv EvalA) (stv 0.2 0.9))
(= (plnTermStv EvalB) (stv 0.3 0.9))
(= (plnTermStv EvalC) (stv 0.4 0.9))
(= (plnTermStv EvalD) (stv 0.5 0.9))

(= (evaluationTestResult $policy $name)
   (validationValue
     (inferenceEvaluateScenario $policy (inferenceEvaluationScenario $name))))

(= (evaluationTestMetrics $policy $name)
   (let (inferenceEvaluation $actualPolicy $status $answer $applications $cost $trace)
        (evaluationTestResult $policy $name)
        ($status $applications $cost $answer)))

(= (evaluationTestFirstDerived $policy $name)
   (let (inferenceTraceStep $proposal $derived $state)
        (car-atom (inferenceEvaluationField (evaluationTestResult $policy $name) trace))
        $derived))

!(test (evaluationTestMetrics metamo competingPaths)
       (answered 1 0.25 ((stv 0.7220000000000001 0.81) (3 4))))
!(test (evaluationTestMetrics confidenceFirst competingPaths)
       (answered 1 0.25 ((stv 0.7220000000000001 0.81) (3 4))))
!(test (evaluationTestMetrics metamo irrelevantBeliefs)
       (answered 1 0.25 ((stv 0.7220000000000001 0.6400000000000001) (13 14))))
!(test (evaluationTestMetrics confidenceFirst irrelevantBeliefs)
       (budgetExhausted 1 0.25 ()))
!(test (evaluationTestMetrics metamo uncertainPremises)
       (budgetExhausted 1 0.25 ((stv 0.7220000000000001 0.06) (21 22))))
!(test (evaluationTestMetrics confidenceFirst uncertainPremises)
       (budgetExhausted 1 0.25 ((stv 0.7220000000000001 0.06) (21 22))))
!(test (evaluationTestMetrics metamo revision)
       (budgetExhausted 1 0.25 ()))
!(test (evaluationTestMetrics confidenceFirst revision)
       (budgetExhausted 1 0.25 ()))
!(test (evaluationTestMetrics metamo unreachable)
       (noCandidates 1 0.25 ()))
!(test (evaluationTestMetrics confidenceFirst unreachable)
       (noCandidates 1 0.25 ()))
!(test (evaluationTestMetrics metamo deductionChain)
       (answered 2 1.0 ((stv 0.5357142857142857 0.8) (51 52 53))))
!(test (evaluationTestMetrics confidenceFirst deductionChain)
       (budgetExhausted 2 1.0 ()))
!(test (evaluationTestMetrics metamo overlappingEvidence)
       (noCandidates 0 0.0 ()))
!(test (evaluationTestMetrics confidenceFirst overlappingEvidence)
       (noCandidates 0 0.0 ()))
!(test (evaluationTestMetrics metamo initialAnswer)
       (answered 0 0.0 ((stv 0.7 0.6) (71))))
!(test (evaluationTestMetrics confidenceFirst initialAnswer)
       (answered 0 0.0 ((stv 0.7 0.6) (71))))

!(test (evaluationTestFirstDerived metamo revision)
       (Sentence (Evidence (stv 0.6 0.6666666666666666)) (31 32)))
!(test (evaluationTestFirstDerived confidenceFirst revision)
       (Sentence (Evidence (stv 0.6 0.6666666666666666)) (31 32)))
!(test (evaluationTestFirstDerived confidenceFirst irrelevantBeliefs)
       (Sentence (Noise (stv 0.7220000000000001 0.9801)) (11 12)))
!(test (length
         (inferenceEvaluationField (evaluationTestResult metamo deductionChain) trace)) 2)
!(test (inferenceEvaluationSummary
         (validationValue
           (inferenceEvaluateConfidence
             (inferenceRequest Goal ((Sentence (Start (stv 0.9 0.8)) (1))) 0) 0)))
       ((policy confidenceFirst) (status budgetExhausted) (answer ())
        (ruleApplications 0) (estimatedCost 0.0)))
!(test (inferenceEvaluateConfidence (inferenceRequest Goal () 0) -1)
       (validationError invalid-step-budget -1))
!(test (collapse
         (inferenceNovelty Evidence
           ((Sentence (Evidence (stv 0.6 0.5)) (31))
            (Sentence (Evidence (stv 0.6 0.5)) (32)))))
       (0.0))

!(test (evaluationTestMetrics queryRelevance competingPaths)
       (budgetExhausted 1 0.25 ((stv 0.7220000000000001 0.16000000000000003) (1 2))))
!(test (evaluationTestMetrics queryRelevance irrelevantBeliefs)
       (answered 1 0.25 ((stv 0.7220000000000001 0.6400000000000001) (13 14))))
!(test (evaluationTestMetrics queryRelevance uncertainPremises)
       (budgetExhausted 1 0.25 ((stv 0.7220000000000001 0.06) (21 22))))
!(test (evaluationTestMetrics queryRelevance revision)
       (budgetExhausted 1 0.25 ()))
!(test (evaluationTestMetrics queryRelevance unreachable)
       (noCandidates 1 0.25 ()))
!(test (evaluationTestMetrics queryRelevance deductionChain)
       (answered 2 1.0 ((stv 0.5357142857142857 0.8) (51 52 53))))
!(test (evaluationTestMetrics queryRelevance overlappingEvidence)
       (noCandidates 0 0.0 ()))
!(test (evaluationTestMetrics queryRelevance initialAnswer)
       (answered 0 0.0 ((stv 0.7 0.6) (71))))

(= (evaluationTestCompetingRequest)
   (let (inferenceScenario $name $request $budget)
        (inferenceEvaluationScenario competingPaths)
        $request))

(= (evaluationTestStrongFirst)
   (let (inferenceRequest $query ($weak $weakRule $strong $strongRule) $index)
        (evaluationTestCompetingRequest)
        (inferenceRequest $query ($strong $strongRule $weak $weakRule) $index)))

!(test (inferenceEvaluationField
         (validationValue (inferenceEvaluateRelevance (evaluationTestStrongFirst) 1))
         answer)
       ((stv 0.7220000000000001 0.81) (3 4)))
!(test (inferenceEvaluationSummary
         (validationValue (inferenceEvaluateRelevance (evaluationTestCompetingRequest) 2)))
       ((policy queryRelevance) (status answered)
        (answer ((stv 0.7220000000000001 0.81) (3 4)))
        (ruleApplications 2) (estimatedCost 0.5)))
!(test (inferenceEvaluateRelevance (evaluationTestCompetingRequest) -1)
       (validationError invalid-step-budget -1))

(= (evaluationTestStrength $policy $scenario $expected)
   (let (inferenceEvaluation $name $status ((stv $s $c) $e) $steps $cost $trace)
        (evaluationTestResult $policy $scenario)
        ($status (and (> $s (- $expected 0.000001))
                      (< $s (+ $expected 0.000001))) $c $e $steps $cost)))

!(test (evaluationTestStrength metamo induction 0.525) (answered True 0.8 (81 82) 1 0.75))
!(test (evaluationTestStrength confidenceFirst induction 0.525) (answered True 0.8 (81 82) 1 0.75))
!(test (evaluationTestStrength queryRelevance induction 0.525) (answered True 0.8 (81 82) 1 0.75))
!(test (evaluationTestStrength metamo abduction 0.45) (answered True 0.8 (91 92) 1 0.75))
!(test (evaluationTestStrength confidenceFirst abduction 0.45) (answered True 0.8 (91 92) 1 0.75))
!(test (evaluationTestStrength queryRelevance abduction 0.45) (answered True 0.8 (91 92) 1 0.75))
