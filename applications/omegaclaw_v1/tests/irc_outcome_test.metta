;; Exact observation classification and existing callback/replay ownership.
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_operations.py))
!(change-state! &operation-provider callback-test-provider)
!(initOperationSession)
!(initOmegaClawMotivation)
(= (replyCommand) (quote (send "reply")))
(= (selectIrc $cycle $candidate $destination)
   (progn
      (change-state! &operation-context (OperationContext "session" $cycle "frame"))
      (change-state! &selected-host-operation
         (HostOperation $candidate (replyCommand)
            (PolicyOperation (candidate $candidate) (target "frame") (skill "send")
               (permissions ()) (egress ($destination)) (costs ())) () () (DispatchTicket $cycle)))
      (change-state! &selected-operation-decision
         (OperationDecision (get-state &operation-context) $candidate (replyCommand) (DispatchTicket $cycle)))))
(= (ircResult $destination $submission)
   (DispatchResult Executed Feasible (SendObservation $destination $submission)))
(= (ircOutcome $status $result)
   (OperationOutcome (get-state &selected-operation-decision)
      (attempted-command (replyCommand)) $status $result))
!(selectIrc 1 respond "irc:irc.example.org:6667:#room")
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1))) Success)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 3 3))) Success)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 0 0))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1 3))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete -1 -1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1.5 1.5))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete "1" "1"))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete True True))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1 extra))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Unknown 1 1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Uncertain WriteUncertain 0 1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Uncertain WriteUncertain 1 3))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Uncertain SubmissionInterrupted 1 3))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission NotSubmitted Disconnected 0 1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission NotSubmitted InvalidText 0 0))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission NotSubmitted SuppressedDuplicate 0 1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:6667:#room" Accepted)) Unobserved)
!(test (operationOutcomeStatus (replyCommand)
   (ircResult "irc:other.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(test (operationOutcomeStatus (quote (send "other"))
   (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(test (operationOutcomeStatus (replyCommand)
   (DispatchResult Executed Unknown (SendObservation "irc:irc.example.org:6667:#room"
      (TransportSubmission Submitted Complete 1 1)))) Unobserved)
!(bind! &confirmed (new-state (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1))))
!(test (ingestOperationOutcome (ircOutcome Unobserved (get-state &confirmed))) (OutcomeRejected InconsistentStatus))
!(change-state! &selected-answer-key "answer-key")
!(change-state! &operation-failure-streak 2)
!(test (ingestOperationOutcome (ircOutcome Success (get-state &confirmed))) OutcomeAccepted)
!(applyOperationOutcome "frame")
!(test (get-state &operation-feedback) (OperationFeedback Success 0))
!(test (get-state &answered-operation-key) "answer-key")
!(test (ingestOperationOutcome (ircOutcome Success (get-state &confirmed))) OutcomeDuplicate)
!(test (ingestOperationOutcome (ircOutcome Unobserved
   (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Uncertain WriteUncertain 0 1))))
   (OutcomeRejected ConflictingReplay))
!(applyOperationOutcome "frame")
!(test (get-state &operation-feedback) (OperationFeedback NoOutcome 0))
!(selectIrc 2 ask-clarification "irc:irc.example.org:6667:#room")
!(change-state! &selected-answer-key "must-not-mark-clarification")
!(test (ingestOperationOutcome (ircOutcome Success (get-state &confirmed))) OutcomeAccepted)
!(applyOperationOutcome "frame")
!(test (get-state &operation-feedback) (OperationFeedback Success 0))
!(test (get-state &answered-operation-key) "answer-key")
!(selectIrc 3 respond "irc:irc.example.org:6667:#room")
!(test (ingestOperationOutcome (ircOutcome Unobserved
   (ircResult "irc:irc.example.org:6667:#room" (TransportSubmission Uncertain WriteUncertain 1 3)))) OutcomeAccepted)
!(applyOperationOutcome "frame")
!(test (get-state &operation-feedback) (OperationFeedback Unobserved 0))
!(test (get-state &answered-operation-key) "answer-key")
;; No selected operation, wrong candidate or malformed/non-IRC route cannot succeed.
!(change-state! &selected-host-operation ())
!(test (operationOutcomeStatus (replyCommand) (get-state &confirmed)) Unobserved)
!(selectIrc 4 execute-skill "irc:irc.example.org:6667:#room")
!(test (operationOutcomeStatus (replyCommand) (get-state &confirmed)) Unobserved)
!(selectIrc 5 respond "local:stdout")
!(test (operationOutcomeStatus (replyCommand) (ircResult "local:stdout" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(selectIrc 5 respond "irc:bad")
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:bad" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(selectIrc 5 respond "irc:IRC.example.org:6667:#room")
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:IRC.example.org:6667:#room" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(selectIrc 5 respond "irc:irc.example.org:0:#room")
!(test (operationOutcomeStatus (replyCommand) (ircResult "irc:irc.example.org:0:#room" (TransportSubmission Submitted Complete 1 1))) Unobserved)
!(selectIrc 6 respond "irc:irc.example.org:6667:#room")
!(change-state! &operation-context (OperationContext "session" 7 "frame"))
!(test (operationOutcomeStatus (replyCommand) (get-state &confirmed)) Unobserved)

;; The channel wrapper preserves each contract and fails closed for extensions.
!(test (channelOutcomeStatus local (replyCommand) "local:stdout" Accepted) Success)
!(test (channelOutcomeStatus local (replyCommand) "local:other" Accepted) Unobserved)
!(test (channelOutcomeStatus telegram (replyCommand) "telegram:room" Accepted) Unobserved)
!(test (channelOutcomeStatus slack (replyCommand) "slack:room"
   (TransportSubmission Submitted Complete 1 1)) Unobserved)
!(test (sendOutcomeStatus (replyCommand)
   (DispatchResult Executed Feasible (SendObservation "slack:room" Accepted))) Unobserved)
!(test (sendOutcomeStatus (replyCommand)
   (DispatchResult Executed Feasible (SendObservation () Accepted))) Unobserved)
