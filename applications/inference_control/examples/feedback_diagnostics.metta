!(import! &self ../../../core/validation)
!(import! &self ../../../core/schema)
!(import! &self ../../../core/features)
!(import! &self ../../../core/state)
!(import! &self ../../../core/helper)
!(import! &self "../../../core/helpers.py")
!(import! &self ../../../core/runtime)
!(import! &self ../../common/openpsi_conventions)
!(import! &self ../../../openpsi/profile)
!(import! &self ../../../openpsi/appraisal)
!(import! &self ../../../magus/correlation)
!(import! &self ../../../magus/profile)
!(import! &self ../../../magus/goal_change)
!(import! &self ../../../magus/decision)
!(import! &self ../../../dynamics/stability)
!(import! &self ../../../dynamics/coherence)
!(import! &self ../../../category/diagnostics)
!(import! &self ../../../category/functors)
!(import! &self ../../../category/bimonad)
!(import! &self ../schema)
!(import! &self ../state)
!(import! &self ../pln)
!(import! &self ../stimulus)
!(import! &self ../planning)
!(import! &self ../appraisal_profile)
!(import! &self ../decision_profile)
!(import! &self ../selection)
!(import! &self ../bundle)
!(import! &self ../execution)
!(import! &self ../outcome)
!(import! &self ../reasoning_loop)
!(import! &self ../evaluation)
!(import! &self ../evaluation_scenarios)
(= (plnTermStv EvalA) (stv 0.2 0.9))
(= (plnTermStv EvalB) (stv 0.3 0.9))
(= (plnTermStv EvalC) (stv 0.4 0.9))
(= (plnTermStv EvalD) (stv 0.5 0.9))
(= (feedbackDiagnosticRequest)
   (let (inferenceScenario $name $request $budget)
        (inferenceEvaluationScenario feedbackTradeoff)
        $request))
(= (feedbackDiagnosticFirst)
   (validationValue
     (inferenceControlTransition
       (inferenceControlDefaultState) (feedbackDiagnosticRequest))))
(= (feedbackDiagnosticBatch)
   (let* (($outcome (feedbackDiagnosticFirst))
          ($nextRequest (inferenceOutcomeNextRequest $outcome))
          ($attempted ((inferenceExecutionProposal
                         (inferenceOutcomeExecution $outcome)))))
         (inferenceControlBuildBatch $nextRequest $attempted)))
(= (feedbackDiagnosticRows $assessments)
   (if (== $assessments ())
       ()
       (let* (($assessment (car-atom $assessments))
              ($annotation (inferenceAssessmentAnnotation $assessment))
              ($proposal (inferenceAnnotationProposal $annotation))
              ($term (inferenceAnnotationTerm $annotation))
              ($rule (inferenceProposalRule $proposal))
              ($score (inferenceAssessmentScore $assessment))
              ($rest (feedbackDiagnosticRows (cdr-atom $assessments))))
             (if (== $term (Inheritance EvalB EvalD))
                 (cons-atom ($rule $score) $rest)
                 $rest))))
(= (feedbackDiagnosticScores $state)
   (feedbackDiagnosticRows
     (validationValue
       (inferenceAssessBatch $state (feedbackDiagnosticBatch)))))
(= (feedbackDiagnosticState $goalsFrom $modulatorsFrom)
   (motivationState (inferenceControlSchema)
     (stateGoals $goalsFrom) (stateModulators $modulatorsFrom)))
(= (feedbackDiagnosticOneModulator $name $initial $updated)
   (let ($v $a $ap $r $t $s) (stateModulators $initial)
        (let ($uv $ua $uap $ur $ut $us) (stateModulators $updated)
             (motivationState
               (inferenceControlSchema) (stateGoals $initial)
               (case $name
                 ((valence ($uv $a $ap $r $t $s))
                  (arousal ($v $ua $ap $r $t $s))
                  (approach ($v $a $uap $r $t $s))
                  (resolution ($v $a $ap $ur $t $s))
                  (threshold ($v $a $ap $r $ut $s))
                  (securing ($v $a $ap $r $t $us))))))))
(= (feedbackDiagnosticModulatorRows $names $initial $updated)
   (if (== $names ())
       ()
       (let $name (car-atom $names)
            (cons-atom
              ($name
                (feedbackDiagnosticScores
                  (feedbackDiagnosticOneModulator $name $initial $updated)))
              (feedbackDiagnosticModulatorRows
                (cdr-atom $names) $initial $updated)))))
(= (feedbackDiagnosticReport)
   (let* (($initial (inferenceControlDefaultState))
          ($updated (inferenceOutcomeState (feedbackDiagnosticFirst)))
          ($goalsOnly (feedbackDiagnosticState $updated $initial))
          ($modulatorsOnly (feedbackDiagnosticState $initial $updated)))
         ((initialGoals (stateGoals $initial))
          (updatedGoals (stateGoals $updated))
          (initialModulators (stateModulators $initial))
          (updatedModulators (stateModulators $updated))
          (initialScores (feedbackDiagnosticScores $initial))
          (updatedScores (feedbackDiagnosticScores $updated))
          (goalsOnlyScores (feedbackDiagnosticScores $goalsOnly))
          (modulatorsOnlyScores (feedbackDiagnosticScores $modulatorsOnly))
          (updatedWithoutApproachScores
            (feedbackDiagnosticScores
              (feedbackDiagnosticOneModulator
                approach $updated $initial)))
          (oneModulatorScores
            (feedbackDiagnosticModulatorRows
              (inferenceControlModulatorNames) $initial $updated)))))
!(feedbackDiagnosticReport)

