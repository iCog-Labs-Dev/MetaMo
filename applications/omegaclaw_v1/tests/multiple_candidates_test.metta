;; A real admitted Core task awaiting its first execution. The registry,
;; generator, gates, scheduling, appraisal and numeric scorer are unchanged.
;; Only external provider/memory boundaries are doubled.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send query))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Explain the available project documentation")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(change-state! &prevmsg "Explain the available project documentation")
!(change-state! &active-task "Explain the available project documentation")
!(change-state! &task-open True)
;; Ingestion is complete; no fresh message or execution observation is pending.
!(change-state! &new-msg-flag False)

(= (multiCandidateNames $actions)
   (map-atom $actions $action (actionId $action)))
(= (multiCandidateGates $bundle $actions)
   (map-atom $actions $action (feasibilityGate $bundle (actionId $action))))
(= (multiCandidateScores $bundle $state $actions)
   (map-atom $actions $action
      ((actionId $action) (omegaclawScoreForBundle $bundle $state $action))))

!(bind! &multi-first (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &multi-first)) 1)
!(test (policyOutputMode (car-atom (get-state &multi-first))) Engaged)
!(test (policyOutputFeasibility (car-atom (get-state &multi-first))) Admitted)
!(test (policyOutputOperation (car-atom (get-state &multi-first))) respond)
!(bind! &multi-bundle (new-state (activeFrameBundle)))
!(bind! &multi-generated (new-state (candidatesToActions)))
!(test (multiCandidateNames (get-state &multi-generated))
   (respond retrieve-memory search-knowledge defer ask-clarification))
!(test (multiCandidateGates (get-state &multi-bundle) (get-state &multi-generated))
   ((GateDecision Admitted Feasible) (GateDecision Admitted Feasible)
    (GateDecision Admitted Feasible) (GateDecision Admitted Feasible)
    (GateDecision Admitted Feasible)))
!(test (candidateRejections) ())
;; There are two competitors even after scheduling precedence, not just two
;; feasible candidates of which only one ever reaches numeric comparison.
!(bind! &multi-scheduled
   (new-state (scheduleAdmittedActions (getSignals) (get-state &multi-generated))))
!(test (multiCandidateNames (get-state &multi-scheduled)) (respond ask-clarification))
!(test (size-atom (get-state &multi-scheduled)) 2)
!(test (frameRuntimeExecutionObserved (get-state &multi-bundle)) "")
!(test (get-state &task-execution-observed) "")
!(test (resultQuestionNeedsResponseForBundle (get-state &multi-bundle)) False)
!(test (executionContinuationNeededForBundle (get-state &multi-bundle)) False)
!(test (get-state &success-count) 0)
!(test (get-state &failure-count) 0)
!(println! (GeneratedCandidates (multiCandidateNames (get-state &multi-generated))))
!(println! (DefaultScores (multiCandidateScores (get-state &multi-bundle)
   (motivosToMetamoState) (get-state &multi-scheduled))))
;; Default scores saturate at 1.0; the existing first-in-order tie rule applies.
!(test (omegaclawScoreForBundle (get-state &multi-bundle)
   (motivosToMetamoState) (candidateToAction respond)) 1.0)
!(test (omegaclawScoreForBundle (get-state &multi-bundle)
   (motivosToMetamoState) (candidateToAction ask-clarification)) 1.0)

;; Change motivational inputs through the existing adapter to break the tie.
;; This is a controlled state change, not an execution-feedback claim. Keep
;; the task, registry, candidate rules and all scoring functions unchanged.
!(replaceGoal responsiveness 0.05)
!(replaceGoal cooperate 0.05)
!(bind! &multi-comparison-state
   (new-state (decisionContext
      (omegaclawBimonadWithDecision (omegaclawDecisionForBundle (get-state &multi-bundle)))
      (motivosToMetamoState) (appraisalToStimulus))))
!(test (> (omegaclawScoreForBundle (get-state &multi-bundle)
             (get-state &multi-comparison-state) (candidateToAction ask-clarification))
          (omegaclawScoreForBundle (get-state &multi-bundle)
             (get-state &multi-comparison-state) (candidateToAction respond))) True)
;; The higher-scoring candidate wins even though it remains second in the list.
!(test (actionId (decisionAction (omegaclawDecideForBundle
   (get-state &multi-bundle) (get-state &multi-comparison-state)
   (get-state &multi-generated)))) ask-clarification)
!(change-state! &consecutive-safety-wins 0)
!(bind! &multi-second (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &multi-second)) 1)
!(test (policyOutputOperation (car-atom (get-state &multi-second))) ask-clarification)
!(test (policyOutputFeasibility (car-atom (get-state &multi-second))) Admitted)
!(test (multiCandidateNames (candidatesToActions))
   (multiCandidateNames (get-state &multi-generated)))
!(test (== (activeFrameBundle) (get-state &multi-bundle)) True)
!(test (lastAttentionDirective)
   (schedulerAttentionDirective (get-state &multi-bundle)
      (car-atom (get-state &multi-second))))
!(test (get-state &cycle-count) 2)
!(test (get-state &failure-count) 0)
!(test (get-state &success-count) 0)
!(test (getSignals) ())
!(println! (ChangedStateScores (multiCandidateScores (get-state &multi-bundle)
   (get-state &multi-comparison-state) (get-state &multi-scheduled))))
!(println! (SelectedPolicy (car-atom (get-state &multi-second))))
!(test (py-call (offline_guard.optional_modules_absent)) 1)
