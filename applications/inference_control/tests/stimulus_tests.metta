!(import! &self ../stimulus)
!(import! &self ../../../core/features)
!(import! &self ../pln)

(= (plnTermStv Upgrade) (stv 0.2 0.9))
(= (plnTermStv Sandboxed) (stv 0.3 0.9))
(= (plnTermStv Safe) (stv 0.4 0.9))
(= (plnTermStv Approved) (stv 0.5 0.9))

(= (inferenceTestFirst)
   (Sentence ((Implication Upgrade Sandboxed) (stv 0.8 0.9)) (1)))
(= (inferenceTestSecond)
   (Sentence ((Implication Sandboxed Safe) (stv 0.7 0.8)) (2)))
(= (inferenceTestBridge)
   (Sentence ((Implication Safe Approved) (stv 0.9 0.9)) (3)))
(= (inferenceTestUnrelated)
   (Sentence ((Implication Upgrade Faster) (stv 0.95 0.9)) (4)))
(= (inferenceTestBeliefs)
   ((inferenceTestFirst) (inferenceTestSecond) (inferenceTestBridge) (inferenceTestUnrelated)))
(= (inferenceTestProposal)
   (plnProposal deduction (inferenceTestFirst) (inferenceTestSecond)))
(= (inferenceTestQuery) (Implication Upgrade Approved))
(= (inferenceTestAnnotation)
   (inferenceAnnotateProposal (inferenceTestProposal) (inferenceTestQuery) (inferenceTestBeliefs)))

!(test (inferencePredictedTerm (inferenceTestProposal)) (Implication Upgrade Safe))
!(test (inferenceIsBridge (Implication Upgrade Safe) (inferenceTestQuery)
                    (inferenceTestBridge)) True)
!(test (inferenceIsBridge (Implication Upgrade Faster) (inferenceTestQuery)
                    (inferenceTestBridge)) False)
!(test (inferenceProposalContext (inferenceTestProposal) (inferenceTestQuery) (inferenceTestBeliefs))
       ((inferenceTestFirst) (inferenceTestSecond) (inferenceTestBridge)))
!(test (is-member (inferenceTestUnrelated) (inferenceAnnotationContext (inferenceTestAnnotation)))
       False)
!(test (inferenceAnnotationProposal (inferenceTestAnnotation)) (inferenceTestProposal))
!(test (inferenceAnnotationTerm (inferenceTestAnnotation)) (Implication Upgrade Safe))
!(test (featureMapGet (inferenceAnnotationFeatures (inferenceTestAnnotation))
                      query_relevance -1.0) 0.75)
!(test (featureMapGet (inferenceAnnotationFeatures (inferenceTestAnnotation))
                      novelty -1.0) 1.0)
!(test (featureMapGet (inferenceAnnotationFeatures (inferenceTestAnnotation))
                      premise_confidence -1.0) 0.8)
!(test (featureMapGet (inferenceAnnotationFeatures (inferenceTestAnnotation))
                      estimated_cost -1.0) 0.5)
!(test (featureMapGet (inferenceAnnotationFeatures (inferenceTestAnnotation))
                      estimated_risk -1.0) 0.19999999999999996)

!(test (inferenceQueryRelevance (Implication Upgrade Approved)
                          (inferenceTestQuery) ()) 1.0)
!(test (inferenceQueryRelevance (Implication Upgrade Faster)
                          (inferenceTestQuery) ()) 0.0)
!(test (inferenceNovelty (Implication Upgrade Sandboxed) (inferenceTestBeliefs)) 0.0)
!(test (inferenceNovelty (Implication Upgrade Safe) (inferenceTestBeliefs)) 1.0)
!(test (inferenceEstimatedCost
         (plnProposal modus-ponens
           (Sentence (Upgrade (stv 0.8 0.9)) (5))
           (Sentence ((Implication Upgrade Safe) (stv 0.7 0.8)) (6))))
       0.25)
!(test (inferencePredictedTerm
         (plnProposal modus-ponens
           (Sentence (Upgrade (stv 0.8 0.9)) (5))
           (Sentence ((Implication Upgrade Safe) (stv 0.7 0.8)) (6))))
       Safe)
!(test (inferencePredictedTerm
         (plnProposal revision
           (inferenceTestFirst)
           (Sentence ((Implication Upgrade Sandboxed) (stv 0.7 0.6)) (5))))
       (Implication Upgrade Sandboxed))
!(test (inferenceIsBridge (Inheritance A B) (Inheritance A D)
                    (Sentence ((Inheritance B D) (stv 0.8 0.9)) (7))) True)
!(test (inferenceIsBridge Safe Approved (inferenceTestBridge)) True)
!(test (length (inferenceAnnotateProposals ((inferenceTestProposal))
                                    (inferenceTestQuery) (inferenceTestBeliefs))) 1)
!(test (inferenceAnnotationTerm
         (inferenceAnnotateProposal
           (plnProposePair (inferenceTestFirst) (inferenceTestSecond))
           (inferenceTestQuery) (inferenceTestBeliefs)))
       (Implication Upgrade Safe))
!(test (inferenceProposalContext (inferenceTestProposal)
                           (Implication Upgrade Faster) (inferenceTestBeliefs))
       ((inferenceTestFirst) (inferenceTestSecond)))
!(test (inferenceBestBridge
         (Implication Upgrade Safe) (inferenceTestQuery)
         ((Sentence ((Implication Safe Approved) (stv 0.8 0.6)) (7))
          (inferenceTestBridge)))
       (inferenceTestBridge))
