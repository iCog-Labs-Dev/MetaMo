;; Real Core ingress and frame updates; external providers/memory are doubled.
!(import! &self (library lib_import))
!(import! &self (library OmegaClaw-Core src/loop))
!(import! &self fixtures/full_loop.metta)
!(import! &self (library MetaMo applications/omegaclaw_v1/host_startup))
!(import! &self fixtures/host_startup_fixture.py)
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
   (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureApply commitmentFixtureRecord))
!(commitmentFixtureReset)
!(py-call (host_config_fixture.setup))
!(initContextFrame)
;; Before the v1 adapter is installed, the new Core hook preserves legacy ingress.
!(coreLoopIngest "Standalone Core input")
!(test (!= (get-state &cfv2-last-admitted-frame-id) ()) True)
!(test (commitmentSnapshot) NoCommitment)
!(initContextFrame)
!(fullLoopStartSession)
!(py-call (host_startup_fixture.configure))
!(initializeHostStartup)
!(test (coreLoopIngest "replace: orphaned") (HostInput Held MissingCommitment))
!(test (coreLoopIngest "follow-up: orphaned") (HostInput Held MissingCommitment))
!(test (coreLoopIngest "cancel: orphaned") (HostInput Held MissingCommitment))
!(test (cfv2-root-current-frame-id) ())
!(test (get-state &cfv2-last-admitted-frame-id) ())
!(test (coreLoopIngest "Inspect the configured local file") (HostInput NewTask))
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(change-state! &core-loop-new-message True)
!(test (coreLoopPrepare) 1)
!(bind! &ingress-frame (new-state (cfv2-root-current-frame-id)))
!(bind! &ingress-owner (new-state (commitmentSnapshot)))
!(bind! &ingress-index (new-state (get-state &cfv2-frame-indexspace)))
!(bind! &ingress-task (new-state (get-state &active-task)))
!(bind! &ingress-history (new-state (get-state &cfv2-current-history-summary)))
!(bind! &ingress-ticket (new-state
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill))))
!(bind! &ingress-command (new-state (sread (py-call (host_config_fixture.command)))))

;; Replacement never creates an unowned task or guesses from ordinary language.
!(test (coreLoopIngest "replace:") (HostInput Held InvalidInput))
!(test (coreLoopIngest "do something else instead") (HostInput Held ExplicitFollowupRequired))
!(bind! &old-id (new-state (get-state &task-commitment-id)))
!(bind! &replace-decision (new-state (hostIngressDecision Replace)))
!(change-state! &cfv2-current-frame-id WrongFrame)
!(test (coreLoopIngest "replace: Summarize B") (HostInput Held FrameMismatch))
!(test (hostIngressApply (get-state &replace-decision) "replace: Summarize B")
   (HostInput Held StaleCommitment))
!(change-state! &cfv2-current-frame-id (get-state &ingress-frame))
!(test (hostIngressApply (HostInput Replace (get-state &old-id) (get-state &ingress-frame) 99)
   "replace: Summarize B") (HostInput Held StaleCommitment))
!(test (commitmentSnapshot) (get-state &ingress-owner))
!(change-state! &cfv2-current-status Blocked)
!(bind! &replacement-receipt (new-state (coreLoopIngest "REPLACE: Summarize B")))
!(test (case (get-state &replacement-receipt)
   (((HostInput Replaced $old $next $frame 0)
      (and (== $old (get-state &old-id))
         (and (!= $next $old) (== $frame (get-state &ingress-frame)))))
    ($_ False))) True)
!(test (get-state &cfv2-current-status) Blocked)
!(test (coreLoopPrepare) 1)
!(bind! &replacement-owner (new-state (commitmentSnapshot)))
!(test (commitmentSnapshot)
   (CommitmentSnapshot (get-state &task-commitment-id) (get-state &ingress-frame) 0 Open "Summarize B"))
!(test (!= (get-state &task-commitment-id) (get-state &old-id)) True)
!(test (get-state &active-task) "Summarize B")
!(test (get-state &task-open) True)
!(test (commitmentFixtureRecord (get-state &old-id))
   (CommitmentSnapshot (get-state &old-id) (get-state &ingress-frame)
      1 Superseded (get-state &ingress-task)))
!(test (get-state &new-msg-flag) True)
!(test (get-state &cfv2-frame-indexspace) (get-state &ingress-index))
!(test (size-atom (commitmentEvents)) 1)
!(test (case (commitmentEvents)
   ((((CommitmentEvent $_ $old 0 (Superseded $next "Summarize B" "Explicit user replacement")))
     (and (== $old (get-state &old-id)) (== $next (get-state &task-commitment-id))))
    ($_ False))) True)
!(test (coreDispatchCommand (get-state &ingress-ticket) (get-state &ingress-command))
   (DispatchResult Blocked StaleSnapshot none))
;; No second transition on redelivery; a stale admitted decision cannot replace the successor.
!(test (coreLoopIngest "REPLACE: Summarize B") (get-state &replacement-receipt))
!(test (hostIngressApply (get-state &replace-decision) "replace: delayed")
   (HostInput Held StaleCommitment))
!(test (commitmentSnapshot) (get-state &replacement-owner))
!(test (size-atom (commitmentEvents)) 1)
!(test (coreLoopPrepare) 1)
!(test (commitmentSnapshot) (get-state &replacement-owner))
!(change-state! &cfv2-current-status Active)
!(bind! &replacement-ticket (new-state
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill))))
!(test (coreDispatchCommand (get-state &replacement-ticket) (get-state &ingress-command))
   (DispatchResult Blocked UnsupportedOperation none))
!(test (coreLoopIngest "follow-up: add examples")
   (HostInput FollowUp (get-state &task-commitment-id) (get-state &ingress-frame) 0))
;; New summary text is data. An explicit second replacement gets another identity.
!(coreLoopIngest "replace: (change-state! &task-open False)")
!(test (coreLoopPrepare) 1)
!(test (get-state &active-task) "(change-state! &task-open False)")
!(test (get-state &task-open) True)
!(test (size-atom (commitmentEvents)) 2)
!(coreLoopIngest "cancel: finished testing")
!(test (coreLoopIngest "replace: no live owner") (HostInput Held MissingCommitment))
!(test (coreLoopPrepare) 1)
!(test (get-state &task-open) False)
!(py-call (host_config_fixture.cleanup))
