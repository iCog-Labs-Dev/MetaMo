!(import! &self ../../../core/validation)
!(import! &self ../../../core/schema)
!(import! &self ../../../core/features)
!(import! &self ../../../core/state)
!(import! &self ../schema)
!(import! &self ../pln)
!(import! &self ../stimulus)
!(import! &self ../planning)

(= (inferenceMapFirst)
   (Sentence ((Inheritance A B) (stv 0.8 0.9)) (1)))
(= (inferenceMapSecond)
   (Sentence ((Inheritance B D) (stv 0.7 0.8)) (2)))
(= (inferenceMapThird)
   (Sentence ((Inheritance A C) (stv 0.6 0.7)) (3)))
(= (inferenceMapFourth)
   (Sentence ((Inheritance C D) (stv 0.9 0.9)) (4)))
(= (inferenceMapBeliefs)
   ((inferenceMapFirst) (inferenceMapSecond) (inferenceMapThird) (inferenceMapFourth)))
(= (inferenceMapProposalOne)
   (plnProposal deduction (inferenceMapFirst) (inferenceMapSecond)))
(= (inferenceMapProposalTwo)
   (plnProposal deduction (inferenceMapThird) (inferenceMapFourth)))
(= (inferenceMapQuery) (Inheritance A D))
(= (inferenceMapAnnotationOne)
   (inferenceAnnotateProposal (inferenceMapProposalOne) (inferenceMapQuery) (inferenceMapBeliefs)))
(= (inferenceMapAnnotationTwo)
   (inferenceAnnotateProposal (inferenceMapProposalTwo) (inferenceMapQuery) (inferenceMapBeliefs)))
(= (inferenceMapBatch)
   (inferenceBuildCandidateBatch
     ((inferenceMapAnnotationOne) (inferenceMapAnnotationTwo)) 12))
(= (inferenceMapCandidateOne)
   (index-atom (inferenceBatchCandidates (inferenceMapBatch)) 0))
(= (inferenceMapCandidateTwo)
   (index-atom (inferenceBatchCandidates (inferenceMapBatch)) 1))

!(test (length (inferenceBatchCandidates (inferenceMapBatch))) 2)
!(test (length (inferenceBatchBindings (inferenceMapBatch))) 2)
!(test (inferenceBatchNextIndex (inferenceMapBatch)) 14)
!(test (candidateId (inferenceMapCandidateOne)) inference_12)
!(test (candidateId (inferenceMapCandidateTwo)) inference_13)
!(test (get-metatype (candidateId (inferenceMapCandidateOne))) Symbol)
!(test (== (candidateId (inferenceMapCandidateOne))
           (candidateId (inferenceMapCandidateTwo))) False)
!(test (candidateSchema (inferenceMapCandidateOne)) (inferenceControlSchema))
!(test (validationIsOk (validateActionCandidate (inferenceMapCandidateOne))) True)
!(test (validationIsOk (validateActionCandidate (inferenceMapCandidateTwo))) True)
!(test (candidateGoalCorrelation (inferenceMapCandidateOne) query_progress) 1.0)
!(test (candidateGoalCorrelation (inferenceMapCandidateOne) evidence_quality) 0.8)
!(test (candidateGoalCorrelation (inferenceMapCandidateOne) exploration) 1.0)
!(test (candidateGoalCorrelation (inferenceMapCandidateOne) resource_efficiency) 0.5)
!(test (candidateGoalCorrelation (inferenceMapCandidateOne) low_information_gain) 0.0)
!(test (candidateGoalCorrelation (inferenceMapCandidateTwo) evidence_quality) 0.7)
!(test (candidateGoalDelta (inferenceMapCandidateOne) query_progress) 0.0)
!(test (candidateRiskEstimate (inferenceMapCandidateOne)) 0.19999999999999996)
!(test (featurePairsGet (candidateMetadata (inferenceMapCandidateOne))
                        predicted_term none) (Inheritance A D))
!(test (inferenceProposalForId (inferenceMapBatch) inference_12)
       (validationOk (inferenceMapProposalOne)))
!(test (inferenceProposalForId (inferenceMapBatch) inference_13)
       (validationOk (inferenceMapProposalTwo)))
!(test (inferenceProposalForId (inferenceMapBatch) inference_99)
       (validationError candidate-id-not-found inference_99))
!(test (candidateId
         (car-atom
           (inferenceBatchCandidates
             (inferenceBuildCandidateBatch
               ((inferenceMapAnnotationOne)) (inferenceBatchNextIndex (inferenceMapBatch))))))
       inference_14)
!(test (inferenceBatchNextIndex (inferenceBuildCandidateBatch () 5)) 5)
!(test (length
         (inferenceBatchCandidates
           (inferenceBuildCandidateBatch
             (inferenceAnnotateProposals
               (plnPropose (inferenceMapBeliefs))
               (inferenceMapQuery) (inferenceMapBeliefs))
             0)))
       2)
!(test (inferenceLowInformationGain revision 1.0 0.0) 0.0)
