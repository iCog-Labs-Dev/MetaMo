;; Real selection/tickets with an observable controlled execution effect.
!(import! &self fixtures/boundary_loop)
!(test (boundaryStart) 1)
!(bind! &boundary-effects (new-state 0))

(= (outcome-test-failure)
   (progn
      (change-state! &boundary-effects (+ (get-state &boundary-effects) 1))
      (quote (Error boundary-handler failed))))

(= (boundaryInstall $variant)
   (progn
      (boundaryProvision $variant)
      (py-call (host_config_fixture.install_failure_handler))))

!(test (boundaryInstall "allowed") 1)
!(test (boundaryCycle invalidation) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) respond)
!(bind! &stale-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &stale-command (new-state (selectedHostCommand)))
!(bind! &before-mutation (new-state (frameStateForMetaMo)))
;; Change-and-restore must still invalidate the ticket through the host revision.
!(test (py-call (host_config_fixture.set_frame_status "Blocked")) 1)
!(test (py-call (host_config_fixture.set_frame_status "Active")) 1)
!(test (frameStateForMetaMo) (get-state &before-mutation))
!(test (fullLoopDispatch invalidation (get-state &stale-ticket) (get-state &stale-command))
   (DispatchResult Blocked StaleSnapshot none))
!(test (get-state &boundary-effects) 0)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 0))
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) respond)
!(test (!= (coreLoopDispatchBegin) (get-state &stale-ticket)) True)
!(test (get-state &failure-count) 0)
;; A new cycle selects again, but explicit revocation prevents its invocation.
!(bind! &revoked-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &revoked-command (new-state (selectedHostCommand)))
!(test (py-call (host_mode_fixture.revoke_failure_handler)) 1)
!(test (fullLoopDispatch invalidation (get-state &revoked-ticket) (get-state &revoked-command))
   (DispatchResult Blocked StaleSnapshot none))
!(test (get-state &boundary-effects) 0)
;; Restoring the exact binding cannot revive the selected old ticket.
!(test (boundaryInstall "allowed") 1)
!(test (fullLoopDispatch invalidation (get-state &revoked-ticket) (get-state &revoked-command))
   (DispatchResult Blocked StaleSnapshot none))
!(test (get-state &boundary-effects) 0)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 0))
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) respond)
!(test (!= (coreLoopDispatchBegin) (get-state &revoked-ticket)) True)
;; Revoke policy after scoring, before dispatch; old selection remains blocked.
!(bind! &policy-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &policy-command (new-state (selectedHostCommand)))
!(test (boundaryInstall "permission-denied") 1)
!(test (fullLoopDispatch invalidation (get-state &policy-ticket) (get-state &policy-command))
   (DispatchResult Blocked StaleSnapshot none))
!(test (get-state &boundary-effects) 0)

;; permission-denied: rejected work never reaches scoring or an execution fallback.
!(test (boundaryInstall "permission-denied") 1)
!(test (boundaryCycle invalidation) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (policyOutputFeasibility (get-state &last-meta-mo-policy-output)) Rejected)
!(test (policyOutputPriority (get-state &last-meta-mo-policy-output)) 0)
!(test (get-state &operation-admitted-actions) ())
!(test (selectedHostCommand) ())
!(test (tpContains (candidateRejections) (CandidateRejection respond PermissionDenied)) True)
!(test (fullLoopDispatch invalidation (coreLoopDispatchBegin) (quote (outcome-test-failure)))
   (DispatchResult Blocked MissingDecision none))
!(test (get-state &boundary-effects) 0)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 0))
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (get-state &success-count) 0)
!(test (get-state &failure-count) 0)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)

;; budget-denied: rejected work never reaches scoring or an execution fallback.
!(test (boundaryInstall "budget-denied") 1)
!(test (boundaryCycle invalidation) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (policyOutputFeasibility (get-state &last-meta-mo-policy-output)) Rejected)
!(test (policyOutputPriority (get-state &last-meta-mo-policy-output)) 0)
!(test (get-state &operation-admitted-actions) ())
!(test (selectedHostCommand) ())
!(test (tpContains (candidateRejections) (CandidateRejection respond BudgetExhausted)) True)
!(test (fullLoopDispatch invalidation (coreLoopDispatchBegin) (quote (outcome-test-failure)))
   (DispatchResult Blocked MissingDecision none))
!(test (get-state &boundary-effects) 0)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 0))
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (get-state &success-count) 0)
!(test (get-state &failure-count) 0)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)

;; empty: rejected work never reaches scoring or an execution fallback.
!(test (boundaryProvision "empty") 1)
!(test (boundaryCycle invalidation) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (policyOutputFeasibility (get-state &last-meta-mo-policy-output)) Rejected)
!(test (policyOutputPriority (get-state &last-meta-mo-policy-output)) 0)
!(test (get-state &operation-admitted-actions) ())
!(test (selectedHostCommand) ())
!(test (tpContains (candidateRejections) (CandidateRejection respond UnsupportedOperation)) True)
!(test (fullLoopDispatch invalidation (coreLoopDispatchBegin) (quote (outcome-test-failure)))
   (DispatchResult Blocked MissingDecision none))
!(test (get-state &boundary-effects) 0)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 0))
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (get-state &success-count) 0)
!(test (get-state &failure-count) 0)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)

;; Only fresh authorization plus fresh selection can finally enter the handler.
!(test (boundaryInstall "allowed") 1)
!(test (boundaryCycle invalidation) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) respond)
!(bind! &fresh-ticket (new-state (coreLoopDispatchBegin)))
!(test (!= (get-state &fresh-ticket) (get-state &revoked-ticket)) True)
!(test (fullLoopDispatch invalidation (get-state &revoked-ticket) (get-state &revoked-command))
   (DispatchResult Blocked UnselectedOperation none))
!(test (get-state &boundary-effects) 0)
!(test (== (fullLoopDispatch invalidation (get-state &fresh-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (Error boundary-handler failed))) True)
!(test (get-state &boundary-effects) 1)
!(test (== (fullLoopDispatch invalidation (get-state &fresh-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (Error boundary-handler failed))) True)
!(test (get-state &boundary-effects) 1)
!(change-state! &new-msg-flag False)
!(test (boundaryCycle invalidation) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Failure 1))
!(test (constitutionalMode) Rumination)
!(test (get-state &failure-count) 1)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)
!(test (py-call (host_config_fixture.cleanup)) 1)
!(fullLoopFinish invalidation)

