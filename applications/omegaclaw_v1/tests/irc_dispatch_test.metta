;; External inference/memory doubled; real appraisal, capture, gate and handlers.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send read-file))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
!(import! &self fixtures/prepared_response_fixture.py)
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &send-test-channel (new-state local))
(= (commchannel) (get-state &send-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Inspect the file")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Use the native symbol ID to exercise generated operation target preservation.
!(change-state! &cfv2-current-frame-id configured-frame)
!(change-state! &active-task "Inspect the file")
!(change-state! &task-open True)
!(change-state! &new-msg-flag False)
!(initMetaMoDispatch)
!(py-call (host_config_fixture.setup))
;; Startup installer preserves the native symbol target.
!(py-call (host_dispatch_config.configure_startup (py-call (prepared_response_fixture.configure "allowed"))))
!(py-call (host_dispatch_config.provision_startup))
!(bind! &read-bundle (new-state (prepareTaskStateForMetaMo)))
!(retainSelectedOperation execute-skill (captureCandidateOperations (get-state &read-bundle)))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (py-call (prepared_response_fixture.retain_read)) 1)

!(import! &self (library OmegaClaw-Core channels/irc.py))
!(import! &self fixtures/irc_routing_fixture.py)
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/irc_dispatch.pl)
   (installIrcTestGate))
!(change-state! &send-test-channel irc)
!(test (py-call (irc_routing_fixture.connect "same")) 1)
!(test (py-call (irc_routing_fixture.provision)) 1)
!(test (dispatchRoutingAllowed ("irc:irc.example.org:6667:#room")) True)
!(test (dispatchRoutingAllowed ("irc:other.example.org:6667:#room")) False)
!(test (sread (py-call (irc_routing_fixture.queue "answer"))) (ResponsePreparationQueued))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (selectedHostCommand) (quote (send "observed reply")))
!(bind! &irc-ticket (new-state (selectedHostTicket)))
!(coreLoopDispatchCommand (get-state &irc-ticket) (selectedHostCommand))
!(test (py-call (irc_routing_fixture.writes)) 1)
;; IRC submission observation/classification is F1.12/F1.13; do not invent success.
!(test (operationOutcomeStatus (selectedHostCommand) (DispatchResult Executed Feasible ())) Unobserved)
!(change-state! &lastsend "")
!(coreLoopDispatchCommand (get-state &irc-ticket) (selectedHostCommand))
!(test (py-call (irc_routing_fixture.writes)) 1)

;; Captured ticket cannot survive server transition.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &irc-stale-ticket (new-state (selectedHostTicket)))
!(py-call (irc_routing_fixture.connect "server"))
!(test (coreLoopDispatchCommand (get-state &irc-stale-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (selectedHostCommand) ())
!(test (py-call (irc_routing_fixture.writes)) 1)

;; Captured ticket cannot survive port transition.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &irc-stale-ticket (new-state (selectedHostTicket)))
!(py-call (irc_routing_fixture.connect "port"))
!(test (coreLoopDispatchCommand (get-state &irc-stale-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (selectedHostCommand) ())
!(test (py-call (irc_routing_fixture.writes)) 1)

;; Captured ticket cannot survive channel transition.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &irc-stale-ticket (new-state (selectedHostTicket)))
!(py-call (irc_routing_fixture.connect "channel"))
!(test (coreLoopDispatchCommand (get-state &irc-stale-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (selectedHostCommand) ())
!(test (py-call (irc_routing_fixture.writes)) 1)

;; Captured ticket cannot survive same transition.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &irc-stale-ticket (new-state (selectedHostTicket)))
!(py-call (irc_routing_fixture.connect "same"))
!(test (coreLoopDispatchCommand (get-state &irc-stale-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)

;; Captured ticket cannot survive disconnect transition.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &irc-stale-ticket (new-state (selectedHostTicket)))
!(py-call (irc_routing_fixture.disconnect))
!(test (coreLoopDispatchCommand (get-state &irc-stale-ticket) (selectedHostCommand))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (irc_routing_fixture.writes)) 1)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (selectedHostCommand) ())
!(test (py-call (irc_routing_fixture.writes)) 1)

;; A reconnect while the provider is preparing invalidates publication.
!(py-call (irc_routing_fixture.connect "same"))
!(sread (py-call (irc_routing_fixture.queue "reconnect")))
!(test (!= (policyOutputOperation (motivationContextBlock)) respond) True)
!(test (get-state &prepared-host-operation) ())
!(test (py-call (irc_routing_fixture.writes)) 1)
;; Reconnect after publication cannot let a new ticket adopt the old preparation.
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(prepareTaskStateForMetaMo)
!(py-call (irc_routing_fixture.prepare_then_reconnect))
!(test (hostRowsForCandidate respond (captureCandidateOperations (activeFrameBundle))) ())
;; Attempt to disconnect between the final gate and the actual send: the writer
;; waits for the handler to finish, then updates the route. No new transport used.
!(sread (py-call (irc_routing_fixture.queue "answer")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (installIrcTestGate) True)
!(change-state! &lastsend "")
!(test (operationOutcomeStatus (selectedHostCommand)
   (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand))) Unobserved)
!(test (py-call (irc_routing_fixture.finish_writer)) 1)
!(test (py-call (irc_routing_fixture.writes)) 2)
!(test (py-call (irc_routing_fixture.route_lock_available)) 1)
!(test (dispatchRoutingAllowed ("irc:irc.example.org:6667:#room")) False)
!(test (py-call (host_config_fixture.cleanup)) 1)
