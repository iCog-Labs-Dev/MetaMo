!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/tests/fixtures/typed_policy))

(= (checkTyped $global $frame $operation)
   (typedOperationPolicyGate $global $frame $operation execute-skill "policy-frame"))
(= (checkGlobal $scope)
   (checkTyped $scope (typedScopeFixture (FrameTarget "policy-frame")) (typedOperationFixture)))
(= (checkFrame $scope)
   (checkTyped (typedScopeFixture Global) $scope (typedOperationFixture)))
(= (checkOperation $operation)
   (checkTyped (typedScopeFixture Global) (typedScopeFixture (FrameTarget "policy-frame")) $operation))
!(test (checkGlobal (typedScopeFixture Global)) (GateDecision Admitted Feasible))
!(test (checkGlobal ()) (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkFrame "compacted policy") (GateDecision Rejected InvalidFramePolicy))
!(test (checkOperation ()) (GateDecision Rejected InvalidOperation))
!(test (checkFrame (typedScopeFixture (FrameTarget "other-frame"))) (GateDecision Rejected InvalidFramePolicy))

;; Both scopes must grant; frame policy cannot override a global rejection.
!(test (checkGlobal (typedPolicyFixture Global () ("files.read") () () (typedBudgetFixture)))
   (GateDecision Rejected SkillNotAllowed))
!(test (checkFrame (typedPolicyFixture (FrameTarget "policy-frame") () ("files.read") () () (typedBudgetFixture)))
   (GateDecision Rejected SkillNotAllowed))
!(test (checkGlobal (typedPolicyFixture Global ("read-file") () () () (typedBudgetFixture)))
   (GateDecision Rejected PermissionDenied))
!(test (checkFrame (typedPolicyFixture (FrameTarget "policy-frame") ("read-file") () () () (typedBudgetFixture)))
   (GateDecision Rejected PermissionDenied))
!(test (checkGlobal (typedPolicyFixture Global ("read-file") ("files.read") () ((DenySkill "read-file")) (typedBudgetFixture)))
   (GateDecision Rejected ConstraintDenied))
!(test (checkFrame (typedPolicyFixture (FrameTarget "policy-frame") ("read-file") ("files.read") () ((RequirePermission "admin")) (typedBudgetFixture)))
   (GateDecision Rejected PermissionDenied))
!(test (checkGlobal (typedPolicyFixture Global ("read-file") ("files.read") () ((UnknownConstraint "permit")) (typedBudgetFixture)))
   (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkGlobal (typedPolicyFixture Global ("read-file") ("files.read") () ((MaxCost "commands" "units" 0)) (typedBudgetFixture)))
   (GateDecision Rejected ConstraintDenied))

(= (egressOperation $destinations)
   (PolicyOperation (candidate execute-skill) (target "policy-frame")
      (skill "read-file") (permissions ("files.read")) (egress $destinations) (costs ())))
!(test (checkOperation (egressOperation ("channel:test"))) (GateDecision Admitted Feasible))
!(test (checkOperation (egressOperation ("channel:other"))) (GateDecision Rejected EgressDenied))
!(test (checkTyped (typedScopeFixture Global)
   (typedPolicyFixture (FrameTarget "policy-frame") ("read-file") ("files.read") ("channel:test") ((DenyEgress "channel:test")) ())
   (egressOperation ("channel:test"))) (GateDecision Rejected EgressDenied))
!(test (checkTyped (typedScopeFixture Global)
   (typedPolicyFixture (FrameTarget "policy-frame") ("read-file") ("files.read") () () ())
   (egressOperation ("channel:test"))) (GateDecision Rejected EgressDenied))

(= (budgetScope $budget)
   (typedPolicyFixture Global ("read-file") ("files.read") () () $budget))
!(test (checkGlobal (budgetScope ())) (GateDecision Rejected MissingResourceBudget))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 1 Open)))) (GateDecision Admitted Feasible))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 0 Open)))) (GateDecision Rejected BudgetExhausted))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 10 Closed)))) (GateDecision Rejected BudgetExhausted))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 10 Exhausted)))) (GateDecision Rejected BudgetExhausted))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "tokens" 10 Open)))) (GateDecision Rejected ResourceUnitMismatch))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" -1 Open)))) (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" "10" Open)))) (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 10 Unknown)))) (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkGlobal (budgetScope ((ResourceBudget "commands" "units" 10 Open) (ResourceBudget "commands" "units" 20 Open))))
   (GateDecision Rejected InvalidGlobalPolicy))
!(test (checkOperation (PolicyOperation (candidate execute-skill) (target "policy-frame") (skill "read-file") (permissions ()) (egress ()) (costs ((ResourceCost "commands" "units" -1)))))
   (GateDecision Rejected InvalidOperation))
!(test (checkOperation (PolicyOperation (candidate execute-skill) (target "other") (skill "read-file") (permissions ()) (egress ()) (costs ())))
   (GateDecision Rejected TargetMismatch))
!(test (checkOperation (PolicyOperation (candidate respond) (target "policy-frame") (skill "read-file") (permissions ()) (egress ()) (costs ())))
   (GateDecision Rejected OperationMismatch))
!(test (tpQuantity True) False)
!(test (tpQuantity 9007199254740992) False)
!(test (tpList ids ("read-file" "read-file")) False)
!(test (tpList ids "not a list") False)

;; Native Core symbols remain distinct from text IDs; only frame targets gain
;; this compatibility. Skills and permissions must still be explicit strings.
(= (nativeFrameOperation $id)
   (PolicyOperation (candidate execute-skill) (target $id) (skill "read-file")
      (permissions ("files.read")) (egress ()) (costs ())))
(= (nativeFrameCheck $id $operation)
   (typedOperationPolicyGate (typedScopeFixture Global)
      (typedScopeFixture (FrameTarget $id)) $operation execute-skill $id))
!(test (nativeFrameCheck Frame-native (nativeFrameOperation Frame-native))
   (GateDecision Admitted Feasible))
!(test (nativeFrameCheck Frame-native (nativeFrameOperation "Frame-native"))
   (GateDecision Rejected TargetMismatch))
!(test (nativeFrameCheck "Frame-native" (nativeFrameOperation Frame-native))
   (GateDecision Rejected TargetMismatch))
!(test (nativeFrameCheck Frame-native (nativeFrameOperation Frame-other))
   (GateDecision Rejected TargetMismatch))
!(test (nativeFrameCheck Frame-native (nativeFrameOperation (Frame-native)))
   (GateDecision Rejected InvalidOperation))
!(test (tpFrameId ()) False)
!(test (tpFrameId "") False)
!(test (tpFrameId 42) False)
!(test (tpFrameId True) False)
!(test (tpId files.read) False)
!(test (tpOperationValid (PolicyOperation (candidate execute-skill)
   (target Frame-native) (skill read-file) (permissions ()) (egress ()) (costs ()))) False)
