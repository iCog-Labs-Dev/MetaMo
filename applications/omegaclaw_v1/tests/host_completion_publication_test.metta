;; Real F2.5 predicate and commitment APIs; no model/provider or channel invoked.
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library OmegaClaw-Core src/dispatch))
!(import! &self fixtures/completion_evidence.metta)
!(import_prolog_functions_from_file
    (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
    (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureApply
     commitmentFixtureComplete commitmentFixtureOutcomes commitmentFixtureOutcome commitmentFixtureEpoch))
!(commitmentFixtureReset)
!(commitmentFixtureOpen "task" frame "Read A and B")
!(change-state! &cfv2-current-frame-id frame)
!(change-state! &cfv2-current-status Active)
!(change-state! &operation-context (completionContext))
!(bind! &epoch-before-completion (new-state (commitmentFixtureEpoch)))
(= (publishEvidence $evidence)
    (commitmentFixtureComplete "completion-outcome" "completion-event" (requirements) $evidence))
!(test (publishEvidence ((aEvidence))) (CommitmentRejected IncompleteEvidence))
!(test (publishEvidence ((aEvidence) (bEvidence))) (CommitmentRejected IncompleteEvidence))
!(test (publishEvidence ((aEvidence) (bEvidence) (answerEvidence Unobserved "local:stdout" Unknown)))
    (CommitmentRejected IncompleteEvidence))
!(test (publishEvidence ((aEvidence) (readEvidence (completionOwner) (readB) Failure (Error read-file "failed")) (ackEvidence)))
    (CommitmentRejected IncompleteEvidence))
!(test (commitmentSnapshot) (completionOwner))
!(test (commitmentFixtureOutcomes) ())
!(test (commitmentEvents) ())
!(test (commitmentFixtureEpoch) (get-state &epoch-before-completion))
;; Exact native frame and live session are required; caller cannot choose context.
!(change-state! &cfv2-current-frame-id "frame")
!(test (publishEvidence (allEvidence)) (CommitmentRejected IncompleteEvidence))
!(change-state! &cfv2-current-frame-id frame)
!(change-state! &operation-context (OperationContext "other-session" 3 frame))
!(test (publishEvidence (allEvidence)) (CommitmentRejected IncompleteEvidence))
!(change-state! &operation-context (completionContext))
!(test (commitmentFixtureComplete "" "event" (requirements) (allEvidence))
    (CommitmentRejected InvalidCompletion))
!(test (commitmentFixtureComplete "outcome" "event" malformed (allEvidence))
    (CommitmentRejected InvalidCompletion))
!(test (commitmentFixtureComplete "outcome" "event"
    (CompletionRequirements (CommitmentSnapshot "task" frame 1 Open "Read A and B") ((readA) (readB)) (requiredAnswer))
    (allEvidence)) (CommitmentRejected StaleCommitment))
;; The successful check publishes exactly one outcome and one Completed event.
!(test (publishEvidence (allEvidence)) (CommitmentApplied "completion-event" "task" Completed 1))
!(test (> (commitmentFixtureEpoch) (get-state &epoch-before-completion)) True)
!(bind! &epoch-after-completion (new-state (commitmentFixtureEpoch)))
!(test (commitmentSnapshot) (CommitmentSnapshot "task" frame 1 Completed "Read A and B"))
!(test (commitmentFixtureOutcomes) ((CompletionOutcome "completion-outcome" "task" 0 Completed)))
!(test (commitmentEvents) ((CommitmentEvent "completion-event" "task" 0 (Completed "completion-outcome"))))
!(test (get-state &cfv2-current-status) Active)
!(test (publishEvidence (allEvidence)) (CommitmentApplied "completion-event" "task" Completed 1))
!(test (commitmentFixtureEpoch) (get-state &epoch-after-completion))
!(test (size-atom (commitmentEvents)) 1)
!(test (size-atom (commitmentFixtureOutcomes)) 1)
!(test (commitmentFixtureComplete "different-outcome" "completion-event" (requirements) (allEvidence))
    (CommitmentRejected ConflictingReplay))
!(test (commitmentFixtureComplete "new-outcome" "new-event" (requirements) (allEvidence))
    (CommitmentRejected StaleCommitment))
;; Replay only acknowledges the old publication; it never terminates the next owner.
!(commitmentFixtureOpen "next" frame "New task")
!(test (publishEvidence (allEvidence)) (CommitmentApplied "completion-event" "task" Completed 1))
!(test (commitmentSnapshot) (CommitmentSnapshot "next" frame 0 Open "New task"))
;; Replacement and cancellation beat a late completion publication.
!(commitmentFixtureReset)
!(commitmentFixtureOpen "task" frame "Read A and B")
!(commitmentFixtureApply (CommitmentEvent "replace" "task" 0 (Superseded "next" "New task" "User replaced")))
!(test (publishEvidence (allEvidence)) (CommitmentRejected StaleCommitment))
!(test (commitmentSnapshot) (CommitmentSnapshot "next" frame 0 Open "New task"))
!(test (commitmentFixtureOutcomes) ())
!(commitmentFixtureReset)
!(commitmentFixtureOpen "task" frame "Read A and B")
!(commitmentFixtureApply (CommitmentEvent "cancel" "task" 0 (Abandoned "User cancelled")))
!(test (publishEvidence (allEvidence)) (CommitmentRejected StaleCommitment))
!(test (commitmentFixtureOutcomes) ())
;; An outcome ID already recorded as failed cannot be relabelled Completed.
!(commitmentFixtureReset)
!(commitmentFixtureOpen "task" frame "Read A and B")
!(commitmentFixtureOutcome "completion-outcome" "task" 0 Failed)
!(test (publishEvidence (allEvidence)) (CommitmentRejected PublicationConflict))
!(test (commitmentSnapshot) (completionOwner))
!(test (commitmentEvents) ())
!(test (commitmentFixtureOutcomes) ((CompletionOutcome "completion-outcome" "task" 0 Failed)))
