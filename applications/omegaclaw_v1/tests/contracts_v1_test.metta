;; Exercise the actual MeTTa publication/consumer boundary using the same
;; wire fixtures as the standalone host contract test.
!(import! &self (library lib_import))
!(import_prolog_function swrite)
!(import! &self (library MetaMo applications/omegaclaw_v1/contracts))
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/contracts_v1.pl)
   (contractFixtureRecord contractFixtureContext))

!(test (integrationValidateRecord (contractFixtureRecord FrameStateBundle)) (ContractValid FrameStateBundle 1))
!(test (integrationValidateRecord (contractFixtureRecord MetaMoPolicyOutput)) (ContractValid MetaMoPolicyOutput 1))
!(test (integrationValidateRecord (contractFixtureRecord AttentionDirective)) (ContractValid AttentionDirective 1))
!(test (integrationValidateRecord (contractFixtureRecord ReasonerMotivationalProposal)) (ContractValid ReasonerMotivationalProposal 1))
!(test (integrationValidateRecord (contractFixtureRecord ExecutionOutcome)) (ContractValid ExecutionOutcome 1))
!(test (integrationValidateRecord (contractFixtureRecord FrameVerificationEvidence)) (ContractValid FrameVerificationEvidence 1))

(= (contractRoundTrip $schema)
   (let* (($record (contractFixtureRecord $schema))
          ((IntegrationRecord $_ (record-id $id) (producer $producer)
             (context $context) (payload $payload)) $record))
      (== (integrationMakeRecord $schema $id $producer $context
              (integrationConsumeRecord $schema $record)) $record)))
!(test (contractRoundTrip FrameStateBundle) True)
!(test (contractRoundTrip MetaMoPolicyOutput) True)
!(test (contractRoundTrip AttentionDirective) True)
!(test (contractRoundTrip ReasonerMotivationalProposal) True)
!(test (contractRoundTrip ExecutionOutcome) True)
!(test (contractRoundTrip FrameVerificationEvidence) True)
;; Exercise parser boolean representation, not just native fixture terms.
!(test (integrationValidateRecord (sread (swrite (contractFixtureRecord FrameStateBundle))))
   (ContractValid FrameStateBundle 1))

(= (publicationFixturePayload $schema)
   (integrationConsumeRecord $schema (contractFixtureRecord $schema)))
!(test (publishFrameStateBundle "snapshot-1" "host-A" (contractFixtureContext)
   (publicationFixturePayload FrameStateBundle)) (contractFixtureRecord FrameStateBundle))
!(test (publishMetaMoPolicyOutput "record-1" "adapter-A" (contractFixtureContext)
   (publicationFixturePayload MetaMoPolicyOutput)) (contractFixtureRecord MetaMoPolicyOutput))
!(test (publishAttentionDirective "record-1" "adapter-A" (contractFixtureContext)
   (publicationFixturePayload AttentionDirective)) (contractFixtureRecord AttentionDirective))
!(test (publishReasonerProposal "record-1" "adapter-A" (contractFixtureContext)
   (publicationFixturePayload ReasonerMotivationalProposal)) (contractFixtureRecord ReasonerMotivationalProposal))
!(test (publishExecutionOutcome "record-1" "adapter-A" (contractFixtureContext)
   (publicationFixturePayload ExecutionOutcome)) (contractFixtureRecord ExecutionOutcome))
!(test (publishFrameVerificationEvidence "record-1" "adapter-A" (contractFixtureContext)
   (publicationFixturePayload FrameVerificationEvidence)) (contractFixtureRecord FrameVerificationEvidence))
!(test (integrationValidateRecord (integrationStartupPolicy "p1" "metamo" Engaged)) (ContractValid MetaMoPolicyOutput 1))
!(test (integrationValidateRecord (integrationStartupAttention "a1" "adapter")) (ContractValid AttentionDirective 1))
!(test (integrationConsumeRecord MetaMoPolicyOutput (integrationStartupPolicy "p1" "metamo" Engaged))
   (MetaMoPolicyOutput (mode Engaged) (operation-class none) (feasibility Rejected)
      (reason NotInitialized) (priority 0) (proposal None)))
!(test (integrationConsumeRecord AttentionDirective (integrationStartupAttention "a1" "adapter"))
   (AttentionDirective (decision None) (target None) (slice None) (task none)
      (admission Rejected) (reason NotInitialized) (priority 0) (source MetaMo)))
!(test (integrationConsumeRecord ExecutionOutcome (FrameVerificationEvidence broken))
   (ContractRejection MalformedRecord None None None))
!(test (integrationValidateRecord
   (integrationAttentionFromPolicy "directive" "adapter"
      (contractFixtureRecord MetaMoPolicyOutput) "frame-1" CurrentFrameTask))
   (ContractValid AttentionDirective 1))
!(test (integrationRecordReference (integrationStartupPolicy "p1" "metamo" Engaged))
   (RecordRef "metamo" "p1"))
!(test (legacyStartupAttentionDirective)
   (AttentionDirective (target ()) (slice None) (task none) (admission Rejected)
      (reason NotInitialized) (priority 0) (source MetaMo)))
