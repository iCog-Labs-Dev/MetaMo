;; Full motivationContextBlock with real Core ingestion and projection.
;; Only external providers and long-term memory are doubled; no channel or
;; command execution is involved. Use a fresh common-launcher process.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send query))

;; Exercise the real persistence orchestration against empty external memory.
!(bind! &bridge-memory-queries (new-state 0))
!(bind! &bridge-memory-payload (new-state ""))
(= (query $key)
   (let $_ (change-state! &bridge-memory-queries
              (+ (get-state &bridge-memory-queries) 1)) ""))
(= (remember $payload)
   (let $_ (change-state! &bridge-memory-payload $payload) True))

!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(initContextFrame)
!(initOmegaClawMotivation)

!(ctx-ingest-user-message "Summarize the first task")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(bind! &bridge-first-frame (new-state (get-state &cfv2-current-frame-id)))
!(change-state! &prevmsg "Summarize the first task")
!(change-state! &new-msg-flag True)
!(change-state! &task-open True)
!(change-state! &active-task "Summarize the first task")
!(bind! &bridge-before-state (new-state (motivosToMetamoState)))
;; Capture all results to detect both missing and duplicate bridge alternatives.
!(bind! &bridge-first-results (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &bridge-first-results)) 1)
!(test (policyOutputOperation (car-atom (get-state &bridge-first-results))) respond)
!(test (policyOutputFeasibility (car-atom (get-state &bridge-first-results))) Admitted)
!(test (get-state &last-meta-mo-policy-output) (car-atom (get-state &bridge-first-results)))
!(test (lastAttentionDirective)
   (schedulerAttentionDirective (activeFrameBundle) (get-state &last-meta-mo-policy-output)))
!(test (frameBundleCurrentId (activeFrameBundle)) (get-state &bridge-first-frame))
!(test (frameBundleRelations (activeFrameBundle)) ())
!(test (bundleNeedsRelationVerification (activeFrameBundle)) False)
!(test (idleAutonomyActive) False)
!(test (get-state &bridge-memory-queries) 1)
!(test (get-state &motivation-restored) True)
!(test (get-state &motivation-save-countdown) (- (persistenceInterval) 1))
;; The full tail ran exactly once, including write-back, homeostasis and cleanup.
!(test (!= (motivosToMetamoState) (get-state &bridge-before-state)) True)
!(test (get-state &last-motivation-decision)
   (metamoActionToDecision (candidateToAction respond)
      (omegaclawScoreForBundle (activeFrameBundle) (motivosToMetamoState)
         (candidateToAction respond))))
!(test (get-state &cycle-count) 1)
!(test (get-state &failure-count) 0)
!(test (get-state &success-count) 0)
!(test (get-state &failure-streak) 0)
!(test (frameRuntimeError (activeFrameBundle)) "")
!(test (frameRuntimeResults (activeFrameBundle)) "")
!(test (get-state &last-results-seen) "")
!(test (getSignals) ())

;; Real ingestion of a second frame produces a nonempty provider relation.
!(ctx-ingest-user-message "Summarize the second task")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
!(change-state! &prevmsg "Summarize the second task")
!(change-state! &active-task "Summarize the second task")
!(bind! &bridge-second-results (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &bridge-second-results)) 1)
!(test (policyOutputOperation (car-atom (get-state &bridge-second-results))) respond)
!(test (size-atom (frameBundleRelations (activeFrameBundle))) 1)
!(test (bundleNeedsRelationVerification (activeFrameBundle)) False)
!(test (frameBundleRelations (activeFrameBundle))
   (frameStateBoundRelations (cfv2-get-relation (get-state &cfv2-current-frame-id))))
!(test (get-state &cycle-count) 2)

;; A host error reaches real appraisal while the fresh user message still
;; requires a response. Execution continuation is a separate integration task.
!(change-state! &error "observed execution failure")
!(change-state! &motivation-save-countdown 0)
!(bind! &bridge-failed-results (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &bridge-failed-results)) 1)
!(test (policyOutputOperation (car-atom (get-state &bridge-failed-results))) respond)
!(test (policyOutputMode (car-atom (get-state &bridge-failed-results))) Rumination)
!(test (> (extractAppraisalDim risk) 0.0) True)
!(test (get-state &cycle-count) 3)
!(test (get-state &failure-count) 1)
!(test (get-state &failure-streak) 1)
!(test (get-state &bridge-memory-queries) 1)
!(test (!= (get-state &bridge-memory-payload) "") True)
!(test (get-state &motivation-save-countdown) (persistenceInterval))
!(test (getSignals) ())

;; Idle startup with no current frame still returns one explicit no-action.
!(initContextFrame)
!(change-state! &new-msg-flag False)
!(change-state! &task-open False)
!(change-state! &active-task "")
!(change-state! &prevmsg "")
!(change-state! &lastresults "")
!(change-state! &error "")
!(bind! &bridge-idle-results (new-state (collapse (motivationContextBlock))))
!(test (size-atom (get-state &bridge-idle-results)) 1)
!(test (policyOutputOperation (car-atom (get-state &bridge-idle-results))) none)
!(test (policyOutputMode (car-atom (get-state &bridge-idle-results))) Sleep)
!(test (idleAutonomyActive) True)
!(test (get-state &cycle-count) 4)
!(test (get-state &failure-count) 1)
!(test (get-state &success-count) 0)
!(test (get-state &failure-streak) 0)
!(test (getSignals) ())
!(test (py-call (offline_guard.optional_modules_absent)) 1)
