(= (plnTermStv EvalA) (stv 0.2 0.9))
(= (plnTermStv EvalB) (stv 0.3 0.9))
(= (plnTermStv EvalC) (stv 0.4 0.9))
(= (plnTermStv EvalD) (stv 0.5 0.9))
(= (thresholdTestRequest $name)
   (let (inferenceScenario $scenario $request $budget)
        (inferenceEvaluationScenario $name)
        $request))
(= (thresholdTestResult $name $budget $minimumConfidence)
   (validationValue
     (inferenceEvaluateThresholdAware
       (inferenceControlDefaultState)
       (thresholdTestRequest $name) $budget $minimumConfidence)))
(= (thresholdTestRules $trace)
   (if (== $trace ())
       ()
       (let (inferenceTraceStep (plnProposal $rule $first $second) $derived $state)
            (car-atom $trace)
            (cons-atom $rule (thresholdTestRules (cdr-atom $trace))))))
(= (thresholdTestSummary $name $budget $minimumConfidence)
   (let $result (thresholdTestResult $name $budget $minimumConfidence)
        ((inferenceEvaluationSummary $result)
         (thresholdTestRules (inferenceEvaluationField $result trace)))))

!(test (thresholdTestSummary feedbackTradeoff 2 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.5208333333333334 0.65) (111 112 113)))
         (ruleApplications 2) (estimatedCost 1.25))
        (induction deduction)))
!(test (thresholdTestSummary feedbackTradeoff 2 0.7)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.578125 0.8) (111 112 114)))
         (ruleApplications 2) (estimatedCost 1.5))
        (induction abduction)))
!(test (thresholdTestSummary feedbackTradeoff 2 0.8)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.578125 0.8) (111 112 114)))
         (ruleApplications 2) (estimatedCost 1.5))
        (induction abduction)))
!(test (thresholdTestSummary feedbackTradeoff 2 0.9)
       (((policy thresholdAware) (status budgetExhausted)
         (answer ((stv 0.5208333333333334 0.65) (111 112 113)))
         (ruleApplications 2) (estimatedCost 1.25))
        (induction deduction)))
!(test (thresholdTestSummary feedbackTradeoff 1 0.7)
       (((policy thresholdAware) (status budgetExhausted) (answer ())
         (ruleApplications 1) (estimatedCost 0.75))
        (induction)))
!(test (thresholdTestSummary competingPaths 1 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.7220000000000001 0.81) (3 4)))
         (ruleApplications 1) (estimatedCost 0.25))
        (modus-ponens)))
!(test (thresholdTestSummary irrelevantBeliefs 1 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.7220000000000001 0.6400000000000001) (13 14)))
         (ruleApplications 1) (estimatedCost 0.25))
        (modus-ponens)))
!(test (thresholdTestSummary uncertainPremises 1 0.5)
       (((policy thresholdAware) (status budgetExhausted)
         (answer ((stv 0.7220000000000001 0.06) (21 22)))
         (ruleApplications 1) (estimatedCost 0.25))
        (modus-ponens)))
!(test (thresholdTestSummary induction 1 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.525 0.8) (81 82)))
         (ruleApplications 1) (estimatedCost 0.75))
        (induction)))
!(test (thresholdTestSummary abduction 1 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.44999999999999996 0.8) (91 92)))
         (ruleApplications 1) (estimatedCost 0.75))
        (abduction)))
!(test (thresholdTestSummary overlappingEvidence 3 0.5)
       (((policy thresholdAware) (status noCandidates) (answer ())
         (ruleApplications 0) (estimatedCost 0.0))
        ()))
!(test (thresholdTestSummary initialAnswer 0 0.5)
       (((policy thresholdAware) (status answered)
         (answer ((stv 0.7 0.6) (71)))
         (ruleApplications 0) (estimatedCost 0.0))
        ()))
!(test (inferenceEvaluateThresholdAware
         (inferenceControlDefaultState) (thresholdTestRequest feedbackTradeoff) -1 0.7)
       (validationError invalid-step-budget -1))
!(test (inferenceEvaluateThresholdAware
         (inferenceControlDefaultState) (thresholdTestRequest feedbackTradeoff) 2 1.1)
       (validationError invalid-minimum-confidence 1.1))
!(test (inferenceEvaluationSummary
         (validationValue
           (inferenceEvaluateThresholdAware
             (inferenceControlDefaultState)
             (inferenceRequest Goal
               ((Sentence (Start (stv 0.9 0.8)) (1))
                (Sentence ((Implication Start Goal) (stv 0.8 0.8)) (2))) 0)
             1 0.7)))
       ((policy thresholdAware) (status budgetExhausted)
        (answer ((stv 0.7220000000000001 0.6400000000000001) (1 2)))
        (ruleApplications 1) (estimatedCost 0.25)))

