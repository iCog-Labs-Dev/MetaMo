(= (tradingMoodValue $currentMood $name)
    (clipUnit (featurePairsGet $currentMood $name 0.5))
)

(= (tradingCandidateMetadata $actionId $features $risk)
    (let* (
        ($riskValue (clipUnit $risk))
        ($opportunity (featureMapNumericUnit $features opportunity 0.0))
        ($exposure (featureMapNumericUnit $features exposure 0.0))
        ($confidence (featureMapNumericUnit $features confidence 0.5))
        ($momentum (featureMapNumeric $features momentum 0.0))
        ($return (featureMapNumeric $features return 0.0))
        ($pnl (featureMapNumeric $features pnl 0.0))
        ($volatility (featureMapNumericUnit $features volatility 0.0))
        ($stress (featureMapNumericUnit $features stress 0.0))
        ($uncertainty (featureMapNumericUnit $features uncertainty 0.0))
        ($cost (featureMapNumericUnit $features cost 0.0))
    )
        (
            (risk $riskValue)
            (opportunity $opportunity)
            (exposure $exposure)
            (confidence $confidence)
            (momentum $momentum)
            (return $return)
            (pnl $pnl)
            (volatility $volatility)
            (stress $stress)
            (uncertainty $uncertainty)
            (cost $cost)
            (source deterministic)
            (policy $actionId)
        )
    )
)

(= (tradingBuyCandidate $features $currentMood)
    (let* (
        ($risk (featureMapNumericUnit $features risk 0.0))
        ($opportunity (featureMapNumericUnit $features opportunity 0.0))
        ($confidence (featureMapNumericUnit $features confidence 0.5))
        ($regime (featureMapNumericUnit $features uncertainty 0.0))
        ($liquidity (featureMapNumericUnit $features friction 0.0))
        ($transactionCost (featureMapNumericUnit $features cost 0.0))
        ($signal (featureMapNumeric $features momentum 0.0))
        ($positiveSignal (positivePart $signal))
        ($negativeSignal (positivePart (- 0.0 $signal)))
        ($arousal (tradingMoodValue $currentMood arousal))
        ($approach (tradingMoodValue $currentMood approach))
        ($buyPressure (clipUnit (+ (+ (* 0.55 $positiveSignal) (* 0.30 $confidence)) (* 0.15 $approach))))
        ($riskLoad (clipUnit (+ (+ (* 0.35 $risk) (* 0.20 $regime)) (+ (* 0.10 $liquidity) (* 0.35 $negativeSignal)))))
        ($corrs (tradingCorrelationVector
            (
                (capital (- 0.28 (* 0.30 $riskLoad)))
                (profit (- (* 1.00 $buyPressure) 0.05))
                (safety (- 0.24 (* 0.32 $riskLoad)))
                (opportunity (* 0.90 $buyPressure))
                (liquidity (- 0.20 (* 0.55 $liquidity)))
                (discipline (- 0.22 (* 0.10 $arousal)))
                (drawdown (* 0.25 $risk))
                (overtrading (+ (* 0.30 $transactionCost) (* 0.15 $regime)))
                (recklessness (* 0.40 $riskLoad))
                (illiquidity (* 0.65 $liquidity))
                (chasing (max-atom ($negativeSignal (featureMapNumericUnit $features stress 0.0))))
                (staleness (* 0.20 (- 1.0 $confidence)))
            )
        ))
        ($riskEstimate (clipUnit (+ 0.08 (* 0.70 $riskLoad))))
        ($delta (tradingDeltaVector
            (
                (transcendence 0.020)
                (profit 0.025)
                (opportunity 0.025)
                (recklessness 0.010)
            )
        ))
    )
        (actionCandidate buy (tradingSchema) $corrs $delta (tradingCandidateMetadata buy $features $riskEstimate))
    )
)

(= (tradingSellCandidate $features $currentMood)
    (let* (
        ($risk (featureMapNumericUnit $features risk 0.0))
        ($drawdown (featureMapNumericUnit $features stress 0.0))
        ($exposure (featureMapNumericUnit $features exposure 0.0))
        ($opportunity (featureMapNumericUnit $features opportunity 0.0))
        ($liquidity (featureMapNumericUnit $features friction 0.0))
        ($signal (featureMapNumeric $features momentum 0.0))
        ($negativeSignal (positivePart (- 0.0 $signal)))
        ($caution (tradingMoodValue $currentMood securing))
        ($riskPressure (max-atom ($risk $drawdown $negativeSignal)))
        ($exitPressure (* $riskPressure $riskPressure))
        ($corrs (tradingCorrelationVector
            (
                (capital (+ 0.08 (* 0.80 $exitPressure)))
                (profit (- 0.0 (* 0.35 $opportunity)))
                (safety (+ 0.10 (* 0.85 $exitPressure)))
                (opportunity (- 0.20 (* 0.30 $opportunity)))
                (liquidity (+ 0.10 (* 0.20 $liquidity)))
                (discipline (+ 0.15 (* 0.25 $caution)))
                (drawdown (- -0.35 (* 0.45 $drawdown)))
                (overtrading (* 0.60 (- 1.0 $exitPressure)))
                (recklessness (- 0.15 (* 0.60 $exitPressure)))
                (illiquidity (- -0.20 (* 0.25 $liquidity)))
                (chasing (- -0.35 (* 0.25 $drawdown)))
                (staleness -0.10)
            )
        ))
        ($riskEstimate (clipUnit (+ 0.04 (* 0.20 $liquidity))))
        ($delta (tradingDeltaVector
            (
                (individuation 0.020)
                (capital 0.025)
                (safety 0.030)
                (drawdown -0.025)
                (recklessness -0.030)
                (chasing -0.020)
            )
        ))
    )
        (actionCandidate sell (tradingSchema) $corrs $delta (tradingCandidateMetadata sell $features $riskEstimate))
    )
)

(= (tradingReduceCandidate $features $currentMood)
    (let* (
        ($risk (featureMapNumericUnit $features risk 0.0))
        ($drawdown (featureMapNumericUnit $features stress 0.0))
        ($exposure (featureMapNumericUnit $features exposure 0.0))
        ($opportunity (featureMapNumericUnit $features opportunity 0.0))
        ($signal (featureMapNumeric $features momentum 0.0))
        ($negativeSignal (positivePart (- 0.0 $signal)))
        ($excessExposure (positivePart (- $exposure 0.65)))
        ($riskPressure (max-atom ($risk $drawdown $negativeSignal)))
        ($corrs (tradingCorrelationVector
            (
                (capital (+ (+ 0.08 (* 0.45 $riskPressure)) (* 0.20 $excessExposure)))
                (profit (- 0.05 (* 0.25 $opportunity)))
                (safety (+ (+ 0.12 (* 0.50 $riskPressure)) (* 0.15 $excessExposure)))
                (opportunity (* -0.15 $opportunity))
                (liquidity 0.15)
                (discipline (+ (+ 0.15 (* 0.30 $riskPressure)) (* 0.20 $excessExposure)))
                (drawdown (- -0.20 (* 0.25 $drawdown)))
                (overtrading (* 0.50 (- 1.0 $riskPressure)))
                (recklessness (- 0.15 (* 0.35 $riskPressure)))
                (illiquidity -0.05)
                (chasing -0.20)
                (staleness -0.05)
            )
        ))
        ($riskEstimate (clipUnit (+ 0.05 (* 0.25 $risk))))
        ($delta (tradingDeltaVector
            (
                (capital 0.015)
                (safety 0.020)
                (discipline 0.015)
                (recklessness -0.020)
            )
        ))
    )
        (actionCandidate reduce (tradingSchema) $corrs $delta (tradingCandidateMetadata reduce $features $riskEstimate))
    )
)

(= (tradingHoldCandidate $features $currentMood)
    (let* (
        ($risk (featureMapNumericUnit $features risk 0.0))
        ($opportunity (featureMapNumericUnit $features opportunity 0.0))
        ($confidence (featureMapNumericUnit $features confidence 0.5))
        ($regime (featureMapNumericUnit $features uncertainty 0.0))
        ($signal (featureMapNumeric $features momentum 0.0))
        ($positiveSignal (positivePart $signal))
        ($negativeSignal (positivePart (- 0.0 $signal)))
        ($exposure (featureMapNumericUnit $features exposure 0.0))
        ($corrs (tradingCorrelationVector
            (
                (capital (+ 0.12 (* 0.25 $risk)))
                (profit (* 0.35 (* $positiveSignal $exposure)))
                (safety (+ 0.15 (* 0.30 $regime)))
                (opportunity (* 0.18 $positiveSignal))
                (liquidity 0.15)
                (discipline (+ 0.25 (* 0.15 $regime)))
                (drawdown (* 0.10 $risk))
                (overtrading -0.30)
                (recklessness (* (* $risk $exposure) 0.40))
                (illiquidity -0.05)
                (chasing (* (* $negativeSignal $exposure) 0.35))
                (staleness (* 0.20 (- 1.0 $confidence)))
            )
        ))
        ($riskEstimate (clipUnit (+ 0.03 (* 0.20 $risk))))
        ($delta (tradingDeltaVector ((discipline 0.010) (overtrading -0.020))))
    )
        (actionCandidate hold (tradingSchema) $corrs $delta (tradingCandidateMetadata hold $features $riskEstimate))
    )
)

(= (tradingCurrentMoodFromState $state)
    (
        (arousal (stateModulator $state arousal))
        (approach (stateModulator $state approach))
        (securing (stateModulator $state securing))
        (threshold (stateModulator $state threshold))
    )
)

(= (tradingBuildCandidates $state $observation)
    (let* (
        ($features (tradingStimulusFeatures $observation))
        ($mood (tradingCurrentMoodFromState $state))
        ($exposure (featureMapNumericUnit $features exposure 0.0))
    )
        (if (tradingObservationMapper $observation holding)
            (if (< $exposure 0.80)
                (
                    (tradingBuyCandidate $features $mood)
                    (tradingSellCandidate $features $mood)
                    (tradingReduceCandidate $features $mood)
                    (tradingHoldCandidate $features $mood)
                )
                (
                    (tradingSellCandidate $features $mood)
                    (tradingReduceCandidate $features $mood)
                    (tradingHoldCandidate $features $mood)
                )
            )
            (
                (tradingBuyCandidate $features $mood)
                (tradingHoldCandidate $features $mood)
            )
        )
    )
)
