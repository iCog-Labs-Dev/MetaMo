(= (plnTermStv EvalA) (stv 0.2 0.9))
(= (plnTermStv EvalB) (stv 0.3 0.9))
(= (plnTermStv EvalC) (stv 0.4 0.9))
(= (plnTermStv EvalD) (stv 0.5 0.9))

(= (inferenceScenarioReport $name)
   (let* (($scenario (inferenceEvaluationScenario $name))
          ((inferenceScenario $scenarioName $request $budget) $scenario)
          ($controlled (validationValue (inferenceEvaluateScenario metamo $scenario)))
          ($reference (validationValue (inferenceEvaluateScenario confidenceFirst $scenario)))
          ($relevance (validationValue (inferenceEvaluateScenario queryRelevance $scenario))))
         ((scenario $name)
          (budget $budget)
          (budgetUnit ruleApplications)
          (minimumConfidence (INFERENCE_CONTROL_MIN_CONFIDENCE))
          (metamo (inferenceEvaluationSummary $controlled))
          (proposalConfidenceBaseline (inferenceEvaluationSummary $reference))
          (queryRelevanceBaseline (inferenceEvaluationSummary $relevance)))))

!(inferenceScenarioReport competingPaths)
!(inferenceScenarioReport irrelevantBeliefs)
!(inferenceScenarioReport uncertainPremises)
!(inferenceScenarioReport revision)
!(inferenceScenarioReport unreachable)
!(inferenceScenarioReport deductionChain)
!(inferenceScenarioReport overlappingEvidence)
!(inferenceScenarioReport initialAnswer)
!(inferenceScenarioReport induction)
!(inferenceScenarioReport abduction)

(= (inferenceTraceReport $trace $index)
   (if (== $trace ())
       ()
       (let (inferenceTraceStep $proposal $derived
              (motivationState $schema $goals $modulators))
            (car-atom $trace)
            (cons-atom
              ((stepNumber $index) (proposal $proposal) (derived $derived)
               (goals $goals) (modulators $modulators))
              (inferenceTraceReport (cdr-atom $trace) (+ $index 1))))))

!((scenario deductionChain)
  (goalNames (inferenceControlGoalNames))
  (modulatorNames (inferenceControlModulatorNames))
  (initialGoals (stateGoals (inferenceControlDefaultState)))
  (initialModulators (stateModulators (inferenceControlDefaultState)))
  (trace
    (inferenceTraceReport
      (inferenceEvaluationField
        (validationValue
          (inferenceEvaluateScenario metamo (inferenceEvaluationScenario deductionChain)))
        trace)
      1)))
