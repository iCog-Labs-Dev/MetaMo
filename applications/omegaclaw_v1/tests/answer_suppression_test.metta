;; External inference/memory doubled; real appraisal, capture, gate and handlers.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send read-file))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
!(import! &self fixtures/prepared_response_fixture.py)
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &send-test-channel (new-state local))
(= (commchannel) (get-state &send-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Inspect the file")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Use the native symbol ID to exercise generated operation target preservation.
!(change-state! &cfv2-current-frame-id configured-frame)
!(change-state! &active-task "Inspect the file")
!(change-state! &task-open True)
!(change-state! &new-msg-flag False)
!(initMetaMoDispatch)
!(py-call (host_config_fixture.setup))
;; Startup installer preserves the native symbol target.
!(py-call (host_dispatch_config.configure_startup (py-call (prepared_response_fixture.configure "allowed"))))
!(py-call (host_dispatch_config.provision_startup))
!(bind! &read-bundle (new-state (prepareTaskStateForMetaMo)))
!(retainSelectedOperation execute-skill (captureCandidateOperations (get-state &read-bundle)))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (py-call (prepared_response_fixture.retain_read)) 1)
!(py-call (host_config_fixture.capture_local_output))
!(test (sread (py-call (prepared_response_fixture.queue "answer"))) (ResponsePreparationQueued))
!(test (py-call (prepared_response_fixture.calls)) 0)
;; The normal bridge invokes preparation/capture before real admission/scoring.
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.calls)) 1)
!(test (selectedHostCommand) (quote (send "observed reply")))
!(test (py-call (host_config_fixture.local_send_count)) 0)
!(bind! &reply-ticket (new-state (selectedHostTicket)))
!(test (coreLoopDispatchBegin) (get-state &reply-ticket))
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (quote (send "substituted")))
   (DispatchResult Blocked UnselectedOperation none))
!(test (py-call (host_config_fixture.local_send_count)) 0)
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(change-state! &lastsend "")
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (py-call (host_config_fixture.local_send_count)) 1)
;; Consume accepted response exactly once and retain the task answer marker.
!(bind! &original-answer (new-state (get-state &last-operation-outcome)))
!(applyOperationOutcome configured-frame)
!(bind! &original-key (new-state (get-state &answered-operation-key)))
!(test (!= (get-state &original-key) ()) True)
!(test (ingestOperationOutcome (get-state &original-answer)) OutcomeDuplicate)
!(applyOperationOutcome configured-frame)
!(test (get-state &operation-feedback) (OperationFeedback NoOutcome 0))
!(test (get-state &answered-operation-key) (get-state &original-key))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction AlreadyAnswered))
!(test (py-call (prepared_response_fixture.calls)) 1)
;; Re-reading changed content in the SAME input/task permits a new preparation.
!(py-call (host_config_fixture.replace_file_content))
!(bind! &next-read-bundle (new-state (prepareTaskStateForMetaMo)))
!(retainSelectedOperation execute-skill (captureCandidateOperations (get-state &next-read-bundle)))
!(test (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand))
   (DispatchResult Executed Feasible "changed after invocation"))
!(py-call (prepared_response_fixture.retain_read))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.calls)) 2)
;; An uncertain send cannot replace the accepted marker. No retry is scheduled.
!(change-state! &lastsend "")
!(py-call (host_config_fixture.fail_local_flush))
!(bind! &uncertain-ticket (new-state (selectedHostTicket)))
!(bind! &uncertain-command (new-state (selectedHostCommand)))
!(test (coreLoopDispatchCommand (get-state &uncertain-ticket) (get-state &uncertain-command))
   (DispatchResult Unobserved ExecutionUncertain none))
!(py-call (host_config_fixture.restore_local_flush))
!(applyOperationOutcome configured-frame)
!(test (get-state &operation-feedback) (OperationFeedback Unobserved 0))
!(test (get-state &answered-operation-key) (get-state &original-key))
!(change-state! &lastsend "")
!(test (coreLoopDispatchCommand (get-state &uncertain-ticket) (get-state &uncertain-command))
   (DispatchResult Unobserved ExecutionUncertain none))
!(test (py-call (host_config_fixture.local_send_count)) 2)
!(motivationContextBlock)
!(test (preparedHostBinding) ())
!(test (py-call (prepared_response_fixture.calls)) 2)
;; A fresh explicit host queue may try again; uncertainty never claimed delivery.
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.calls)) 3)
!(change-state! &lastsend "observed reply")
!(test (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" SuppressedDuplicate)))
!(applyOperationOutcome configured-frame)
!(test (get-state &operation-feedback) (OperationFeedback Unobserved 0))
!(test (get-state &answered-operation-key) (get-state &original-key))
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(change-state! &lastsend "")
!(test (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(applyOperationOutcome configured-frame)
!(test (!= (get-state &answered-operation-key) (get-state &original-key)) True)
!(test (get-state &task-open) True)
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(motivationContextBlock)
!(test (get-state &prepared-host-operation) (ResponseNoAction AlreadyAnswered))
!(test (py-call (prepared_response_fixture.calls)) 4)
;; A different task owner cannot inherit suppression from the previous task.
!(change-state! &active-task "New inspection task")
!(sread (py-call (prepared_response_fixture.queue "ready")))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (py-call (prepared_response_fixture.calls)) 5)
;; Session reset cannot carry the previous answer marker into a new task run.
!(initOperationSession)
!(test (get-state &answered-operation-key) ())
!(test (get-state &selected-answer-key) ())
!(test (py-call (host_config_fixture.finish_local_capture)) 1)
!(test (py-call (host_config_fixture.cleanup)) 1)
