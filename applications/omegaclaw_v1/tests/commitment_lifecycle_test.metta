!(import! &self "../../../../repos/OmegaClaw-Core/src/helper.py")
!(import! &self ../../../../repos/OmegaClaw-Core/src/context)
!(import! &self (library MetaMo applications/omegaclaw_v1/tests/fixtures/minimal_loop))
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
   (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureOutcome commitmentFixtureApply))
!(initMinimalLoopFixture)
!(commitmentFixtureReset)
!(test (commitmentFixtureOpen "task-1" "frame-1" "Read the file") (CommitmentOpened "task-1"))
!(prepareTaskStateForMetaMo)
!(test (get-state &task-open) True)
!(test (get-state &active-task) "Read the file")

;; Zero motivation, decay/writeback, homeostasis and Sleep cannot end a task.
!(replaceGoal progress 0.0)
!(writeBackMetamoState (decayMetamoState (motivosToMetamoState)))
!(runHomeostasis)
!(setConstitutionalMode Sleep)
!(test (commitmentSnapshot) (CommitmentSnapshot "task-1" "frame-1" 0 Open "Read the file"))
!(test (commitmentEvents) ())
!(test (get-state &task-open) True)
!(test (get-state &active-task) "Read the file")

;; Neither a terminal-looking candidate nor result text is a completion event.
!(change-state! &new-msg-flag False)
!(change-state! &lastresults "Done successfully")
!(change-state! &error "")
!(change-state! &last-motivation-decision (decision respond execute execute 0.0))
!(test (completeTaskIfTerminal respond) False)
!(test (completeTaskIfTerminal repair-failure) False)
!(test (completeTaskIfTerminal defer) False)
!(test (completeTaskIfTerminal none) False)
!(test (completePreviousTaskIfSuccessful) False)
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)
!(test (commitmentFixtureApply (quote (CommitmentEvent "e1" "task-1" 0 (Completed "missing"))))
   (CommitmentRejected CompletionNotConfirmed))

;; Only a host-confirmed outcome for this exact commitment/revision permits completion.
!(commitmentFixtureOutcome "outcome-1" "task-1" 0 Completed)
!(test (commitmentFixtureApply (quote (CommitmentEvent "e1" "task-1" 0 (Completed "outcome-1"))))
   (CommitmentApplied "e1" "task-1" Completed 1))
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) False)
!(test (get-state &active-task) "")
!(test (get-state &task-execution-observed) "")
!(test (commitmentEvents) ((CommitmentEvent "e1" "task-1" 0 (Completed "outcome-1"))))

;; Abandonment records its reason; a missing reason leaves the new task open.
!(commitmentFixtureOpen "task-2" "frame-1" "Second task")
!(test (commitmentFixtureApply (quote (CommitmentEvent "e2" "task-2" 0 (Abandoned ""))))
   (CommitmentRejected ReasonRequired))
!(prepareTaskStateForMetaMo)
!(test (get-state &task-open) True)
!(test (commitmentFixtureApply (quote (CommitmentEvent "e2" "task-2" 0 (Abandoned "User cancelled"))))
   (CommitmentApplied "e2" "task-2" Abandoned 1))
!(prepareTaskStateForMetaMo)
!(test (get-state &task-open) False)

;; Supersession atomically closes the predecessor and opens the named replacement.
!(commitmentFixtureOpen "task-3" "frame-1" "Old task")
!(prepareTaskStateForMetaMo)
!(change-state! &task-execution-observed "old observations")
!(test (commitmentFixtureApply (quote (CommitmentEvent "e3" "task-3" 0
   (Superseded "task-4" "Replacement task" "User changed the requirement"))))
   (CommitmentApplied "e3" "task-3" Superseded 1))
!(prepareTaskStateForMetaMo)
!(test (get-state &task-open) True)
!(test (get-state &active-task) "Replacement task")
!(test (get-state &task-execution-observed) "")
!(test (commitmentSnapshot) (CommitmentSnapshot "task-4" "frame-1" 0 Open "Replacement task"))
!(test (commitmentFixtureApply (quote (CommitmentEvent "late" "task-3" 0 (Completed "outcome-1"))))
   (CommitmentRejected AlreadyTerminal))
!(prepareTaskStateForMetaMo)
!(test (get-state &task-open) True)

;; A new message alone does not replace or terminate the commitment.
!(change-state! &new-msg-flag True)
!(change-state! &active-task "unadmitted replacement")
!(prepareTaskStateForMetaMo)
!(test (get-state &active-task) "Replacement task")
!(test (get-state &task-open) True)
