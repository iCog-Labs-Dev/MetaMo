;; Registry-driven transitions over the existing signals and bounded snapshot.
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))

(= (modeTestBundle $id)
   (FrameStateBundle
      (root (FrameStateRoot root $id (mode Fast) () ()))
      (current (FrameStateCurrent (id $id) (parent ()) UserDirective
         (status Active) (frame-mode Fast) (priority 1.0)
         (goal-summary task) (history-summary history) (deliverable-summary result)
         (results-summary "") (budget open-budget) (constraints ()) (certified-method ())))
      (index (active ()) (completed ())) (relations ()) (runtime ())))

(= (modeTestRefresh $id)
   (let $_ (refreshConstitutionalMode (modeTestBundle $id)) (constitutionalMode)))

;; No new signal facts are generated by selection or transition bookkeeping.
!(clearSignals)
!(setConstitutionalMode Engaged)
!(test (modeTestRefresh ()) Sleep)
!(test (modeTestRefresh frame-a) Engaged)
!(test (getSignals) ())
!(test (frameBundleRootMode (modeTestBundle frame-a)) Fast)
!(test (frameBundleCurrentMode (modeTestBundle frame-a)) Fast)

;; Wake from the current snapshot or either existing wake signal.
!(setConstitutionalMode Sleep)
!(addSignal user-waiting 0.3)
!(test (modeTestRefresh ()) Engaged)
!(clearSignals)
!(test (modeTestRefresh ()) Sleep)
!(addSignal execution-request 0.85)
!(test (modeTestRefresh ()) Engaged)
!(test (getSignals) ((signal execution-request 0.85)))

;; Every configured recovery signal enters Rumination; clearing it releases
;; recovery to Engaged with a frame and Sleep without a frame.
!(clearSignals)
!(addSignal failure 0.8)
!(test (modeTestRefresh frame-a) Rumination)
!(test (schedulingPriorityForCandidate (getSignals) self-improve) Recovery)
!(clearSignals)
!(test (modeTestRefresh frame-a) Engaged)
!(addSignal repeated-failure 0.85)
!(test (modeTestRefresh ()) Rumination)
!(clearSignals)
!(test (modeTestRefresh ()) Sleep)
!(addSignal stalled-progress 0.35)
!(test (modeTestRefresh frame-a) Rumination)
!(test (constitutionalModeValid Recovery) False)

;; Real refresh resolves simultaneous recovery, wake, and sleep conditions.
!(addSignal user-waiting 0.3)
!(test (modeTestRefresh ()) Rumination)
!(addSignal danger 0.9)
!(test (modeTestRefresh ()) Threat)
!(test (schedulingPriorityForCandidate (getSignals) defer) Threat-remediation)
!(test (getSignals)
   ((signal stalled-progress 0.35) (signal user-waiting 0.3) (signal danger 0.9)))

;; Inclusive entry/exit thresholds provide hysteresis from registry data.
;; Changing the same trigger also changes scheduling promotion.
!(remove-atom &self (ModeSignalTrigger threat danger 0.0 0.0))
!(add-atom &self (ModeSignalTrigger threat danger 0.8 0.4))
!(clearSignals)
!(setConstitutionalMode Engaged)
!(addSignal danger 0.79)
!(test (modeTestRefresh frame-a) Engaged)
!(test (schedulingPriorityForCandidate (getSignals) defer) Sleep)
!(addSignal danger 0.8)
!(test (modeTestRefresh frame-a) Threat)
!(test (schedulingPriorityForCandidate (getSignals) defer) Threat-remediation)
!(addSignal danger 0.4)
!(test (modeTestRefresh frame-a) Threat)
;; Scheduling uses entry evidence, independently of held constitutional posture.
!(test (schedulingPriorityForCandidate (getSignals) defer) Sleep)
!(addSignal danger 0.39)
!(test (modeTestRefresh frame-a) Engaged)
!(remove-atom &self (ModeSignalTrigger threat danger 0.8 0.4))
!(add-atom &self (ModeSignalTrigger threat danger 0.0 0.0))

;; A trigger mapping can be changed without editing either evaluator.
!(remove-atom &self (ModeSignalTrigger recovery failure 0.0 0.0))
!(clearSignals)
!(addSignal failure 1)
!(test (modeTestRefresh frame-a) Engaged)
!(test (schedulingPriorityForCandidate (getSignals) self-improve) Rumination)
!(add-atom &self (ModeSignalTrigger recovery failure 0.0 0.0))
!(test (modeTestRefresh frame-a) Rumination)

;; Timing parameters: two consecutive threat evaluations, then hold/cooldown
;; for two complete refreshes before a less urgent transition is allowed.
!(remove-atom &self (ModeTransitionParameters Threat 1 0 0))
!(add-atom &self (ModeTransitionParameters Threat 2 2 2))
!(clearSignals)
!(setConstitutionalMode Engaged)
!(addSignal danger 1)
!(test (modeTestRefresh frame-a) Engaged)
!(test (modeTransitionState) (ModeTransitionState Engaged 1 Threat 1 0))
!(clearSignals)
!(test (modeTestRefresh frame-a) Engaged)
!(test (modeTransitionState) (ModeTransitionState Engaged 2 none 0 0))
!(addSignal danger 1)
!(test (modeTestRefresh frame-a) Engaged)
!(test (modeTestRefresh frame-a) Threat)
!(test (modeTransitionState) (ModeTransitionState Threat 0 none 0 2))
!(clearSignals)
!(test (modeTestRefresh frame-a) Threat)
!(test (modeTransitionState) (ModeTransitionState Threat 1 Engaged 1 1))
!(test (modeTestRefresh frame-a) Threat)
!(test (modeTransitionState) (ModeTransitionState Threat 2 Engaged 2 0))
!(test (modeTestRefresh frame-a) Engaged)

;; Higher urgency bypasses timing, not evidence confirmation.
!(test (modeTransitionStep (ModeTransitionState Sleep 0 none 0 5)
   ((signal danger 1)) False) (ModeTransitionState Sleep 1 Threat 1 4))
!(test (modeTransitionStep (ModeTransitionState Sleep 1 Threat 1 4)
   ((signal danger 1)) False) (ModeTransitionState Threat 0 none 0 2))
!(remove-atom &self (ModeTransitionOption urgent-bypass True))
!(add-atom &self (ModeTransitionOption urgent-bypass False))
!(test (modeTransitionStep (ModeTransitionState Sleep 1 Threat 1 4)
   ((signal danger 1)) False) (ModeTransitionState Sleep 2 Threat 2 3))
!(remove-atom &self (ModeTransitionOption urgent-bypass False))
!(add-atom &self (ModeTransitionOption urgent-bypass True))
!(remove-atom &self (ModeTransitionParameters Threat 2 2 2))
!(add-atom &self (ModeTransitionParameters Threat 1 0 0))

;; Hold and cooldown are independent, and expired cooldown never goes negative.
!(remove-atom &self (ModeTransitionParameters Threat 1 0 0))
!(add-atom &self (ModeTransitionParameters Threat 1 2 0))
!(test (modeTransitionStep (ModeTransitionState Threat 0 none 0 0) () True)
   (ModeTransitionState Threat 1 Engaged 1 0))
!(remove-atom &self (ModeTransitionParameters Threat 1 2 0))
!(add-atom &self (ModeTransitionParameters Threat 1 0 0))
!(test (modeTransitionStep (ModeTransitionState Threat 9 none 0 1) () True)
   (ModeTransitionState Threat 10 Engaged 1 0))
!(test (modeTransitionStep (ModeTransitionState Threat 10 Engaged 1 0) () True)
   (ModeTransitionState Engaged 0 none 0 0))

;; Collision ranks are data; ties keep the first declared matching rule.
!(remove-atom &self (ModeTransitionRule threat Threat 40))
!(add-atom &self (ModeTransitionRule threat Threat 30))
!(test (modeTargetFromContext ((signal danger 1) (signal failure 1)) False Engaged) Rumination)
!(remove-atom &self (ModeTransitionRule threat Threat 30))
!(add-atom &self (ModeTransitionRule threat Threat 40))
!(test (modeTargetFromContext ((signal danger 1) (signal failure 1)) False Engaged) Threat)

;; No trigger means the registry default, if context rules have been removed.
!(remove-atom &self (ModeContextTrigger wake frame-present))
!(remove-atom &self (ConstitutionalModeDefault Engaged))
!(add-atom &self (ConstitutionalModeDefault Sleep))
!(test (modeTargetFromContext () True Engaged) Sleep)
!(remove-atom &self (ConstitutionalModeDefault Sleep))
!(add-atom &self (ConstitutionalModeDefault Engaged))
!(add-atom &self (ModeContextTrigger wake frame-present))

;; Explicit setters reset timing; invalid setters preserve both state values.
!(setConstitutionalMode Sleep)
!(test (modeTransitionState) (ModeTransitionState Sleep 0 none 0 0))
!(test (setConstitutionalMode Recovery) (ModeRejected Recovery))
!(test (constitutionalMode) Sleep)
!(test (modeTransitionState) (ModeTransitionState Sleep 0 none 0 0))
!(clearSignals)
!(test (modeTestRefresh frame-a) Engaged)
