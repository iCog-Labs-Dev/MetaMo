;; Focused tests for FrameStateBundle and FrameStateRuntime accessors.

!(import! &self (library lib_import))
!(import! &self "../../../../../repos/OmegaClaw-Core/src/helper.py")
!(import! &self ../../../../../repos/OmegaClaw-Core/src/context)
!(import! &self (library MetaMo core/state))
!(import! &self (library MetaMo core/state_accessors))
!(import! &self (library MetaMo core/helper))
!(import! &self (library MetaMo core/helpers.py))
!(import! &self (library MetaMo applications/omegaclaw_v1/utils))
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/context_integration)
!(import! &self ../../../../../MetaMo/applications/omegaclaw_v1/contexts/context_accessors)

(= (accessorTestBundle)
   (FrameStateBundle
      (root (FrameStateRoot root-id current-id (mode Fast)
             root-budget root-constraints))
      (current (FrameStateCurrent
         (id current-id) (parent parent-id) UserDirective (status Active)
         (frame-mode Fast) (priority 0.8) (goal-summary compact-goal)
         (history-summary compact-history) (deliverable-summary compact-deliverable)
         (results-summary compact-results) (budget open-budget)
         (constraints compact-constraints) (certified-method certified-method)))
      (index (active (active-frame)) (completed (completed-frame)))
      (relations (relation-evidence))
      (runtime (FrameStateRuntime
         (new-message True) (message-present True) (message-summary compact-message)
         (task-open True) (task-execution-observed compact-observed)
         (active-task-summary compact-task) (last-results-summary compact-results)
         (error compact-error) (wake-loops 3) (next-wake-at 7)
         (budget-state open-budget)))))

!(test (frameBundleRoot (accessorTestBundle))
      (FrameStateRoot root-id current-id (mode Fast) root-budget root-constraints))
!(test (frameBundleCurrentId (accessorTestBundle)) current-id)
!(test (frameBundleCurrent (accessorTestBundle))
      (FrameStateCurrent
         (id current-id) (parent parent-id) UserDirective (status Active)
         (frame-mode Fast) (priority 0.8) (goal-summary compact-goal)
         (history-summary compact-history) (deliverable-summary compact-deliverable)
         (results-summary compact-results) (budget open-budget)
         (constraints compact-constraints) (certified-method certified-method)))
!(test (frameBundleIndex (accessorTestBundle))
      (index (active (active-frame)) (completed (completed-frame))))
!(test (frameBundleRelations (accessorTestBundle)) (relation-evidence))
!(test (frameBundleRuntime (accessorTestBundle))
      (FrameStateRuntime
         (new-message True) (message-present True) (message-summary compact-message)
         (task-open True) (task-execution-observed compact-observed)
         (active-task-summary compact-task) (last-results-summary compact-results)
         (error compact-error) (wake-loops 3) (next-wake-at 7)
         (budget-state open-budget)))

!(test (frameBundleCurrentStatus (accessorTestBundle)) Active)
!(test (frameBundleCurrentMode (accessorTestBundle)) Fast)
!(test (frameBundleCurrentPriority (accessorTestBundle)) 0.8)
!(test (frameBundleCurrentBudget (accessorTestBundle)) open-budget)
!(test (frameBundleCurrentHistory (accessorTestBundle)) compact-history)
!(test (frameBundleRootMode (accessorTestBundle)) Fast)
!(test (frameRuntimeNewMessage (accessorTestBundle)) True)
!(test (frameRuntimeMessagePresent (accessorTestBundle)) True)
!(test (frameRuntimeMessage (accessorTestBundle)) compact-message)
!(test (frameRuntimeTaskOpen (accessorTestBundle)) True)
!(test (frameRuntimeActiveTask (accessorTestBundle)) compact-task)
!(test (frameRuntimeResults (accessorTestBundle)) compact-results)
!(test (frameRuntimeError (accessorTestBundle)) compact-error)
!(test (frameRuntimeExecutionObserved (accessorTestBundle)) compact-observed)
!(test (frameRuntimeText ()) "")
!(test (frameRuntimeText compact-message) compact-message)
!(test (bundle-runtime-has-error (accessorTestBundle)) True)
!(test (bundle-runtime-has-new-message (accessorTestBundle)) True)
!(test (bundle-current-status (accessorTestBundle)) Active)
!(test (bundle-current-budget-state (accessorTestBundle)) open-budget)
!(test (bundle-current-priority (accessorTestBundle)) 0.8)
