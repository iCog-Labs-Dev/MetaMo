;; Real task-owned maintenance through the normal publication/selection/dispatch loop.
!(import! &self fixtures/boundary_loop)
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/host_maintenance.pl)
   (maintenanceFixtureQueue maintenanceFixtureTotal maintenanceFixtureRemaining maintenanceFixtureRevoke maintenanceFixtureDependency
    maintenanceFixtureBatch maintenanceFixtureProbe maintenanceFixtureWork maintenanceFixtureProcessed
    maintenanceFixtureDirectDenied maintenanceFixtureSlow maintenanceFixtureIdleTotal maintenanceFixtureRegistrationDenied))
(: ProbeProcessedType Type)
(: ProbeProcessed (-> Number ProbeProcessedType))

;; Idle accounting uses a real session budget and ticket, with no frame/commitment.
!(commitmentFixtureReset)
!(initContextFrame)
!(fullLoopStartSession)
!(test (py-call (host_mode_fixture.setup)) 1)
!(test (maintenanceFixtureQueue "no-idle-policy" ((MemoryRentCharge "idle-memory" 3)))
   (MaintenanceRejected InvalidBatch))
!(test (py-call (host_mode_fixture.provision_idle "allowed")) 1)
;; Bridge-owned corrections stay undispatchable even if assigned a sweep class.
!(test (maintenanceFixtureRegistrationDenied motivational-decay) True)
!(test (maintenanceFixtureWork motivational-decay "duplicate-decay" (a)) (MaintenanceRejected InvalidBatch))
!(add-atom &self (MaintenanceWork homeostatic-correction BoundedSweep (MaintenanceWorkLimits 8 0 0 1000)))
!(test (maintenanceFixtureRegistrationDenied homeostatic-correction) True)
!(test (maintenanceFixtureWork homeostatic-correction "duplicate-homeostasis" (a)) (MaintenanceRejected InvalidBatch))
!(remove-atom &self (MaintenanceWork homeostatic-correction BoundedSweep (MaintenanceWorkLimits 8 0 0 1000)))
!(test (get-state &cfv2-current-frame-id) ())
!(test (commitmentSnapshot) NoCommitment)
!(test (maintenanceFixtureQueue "idle-1" ((MemoryRentCharge "idle-memory" 3))) (MaintenanceQueued "idle-1"))
!(test (boundaryCycle idle-accounting) 1)
!(test (constitutionalMode) Sleep)
!(test (selectedHostCommand) (quote (host-maintenance memory-rent)))
!(bind! &idle-session (new-state (index-atom (get-state &operation-context) 1)))
!(bind! &idle-operation (new-state (get-state &selected-host-operation)))
!(test (sessionMaintenanceBundleValid (activeFrameBundle) "another-session") False)
!(test (let (HostOperation $_ $_ (PolicyOperation $_ (target $target) $_ $_ $_ $_) $_ $_ $_)
   (get-state &idle-operation) $target) (SessionTarget (get-state &idle-session)))
!(test (let (HostOperation $_ $_ $_ $global $scope $_) (get-state &idle-operation)
   (typedOperationPolicyGate $global $scope
      (PolicyOperation (candidate respond) (target (SessionTarget (get-state &idle-session)))
         (skill "send") (permissions ("channels.send")) (egress ())
         (costs ((ResourceCost "commands" "units" 1)))) respond (SessionTarget (get-state &idle-session))))
   (GateDecision Rejected InvalidOperation))
!(bind! &idle-ticket (new-state (selectedHostTicket)))
!(bind! &idle-motivation (new-state (motivosToMetamoState)))
!(bind! &idle-self-model (new-state (getSelfModel)))
!(bind! &idle-corrections (new-state (lastHomeostaticCorrections)))
!(test (py-call (host_mode_fixture.provision_idle "allowed")) 1)
!(test (fullLoopDispatch idle (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "idle-1" 1 (MemoryRentAccounted 3))))
!(test (get-state &cfv2-current-frame-id) ())
!(test (commitmentSnapshot) NoCommitment)
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 3)
;; Dispatch settles observed rent without repeating the bridge's corrections.
!(test (motivosToMetamoState) (get-state &idle-motivation))
!(test (getSelfModel) (get-state &idle-self-model))
!(test (lastHomeostaticCorrections) (get-state &idle-corrections))
!(test (budgetAvailability (BudgetAccountId "host" (SessionTarget (get-state &idle-session)) "commands" "units"))
   (ResourceBudget "commands" "units" 1 Open))
!(test (maintenanceFixtureQueue "idle-2" ((MemoryRentCharge "idle-memory" 2))) (MaintenanceQueued "idle-2"))
!(bind! &idle-root-constraints (new-state (get-state &cfv2-global-constraints)))
!(change-state! &cfv2-global-constraints
   (cons-atom (DenySkill "host-maintenance") (get-state &idle-root-constraints)))
!(test (boundaryCycle idle-root-policy-denied) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 3)
!(change-state! &cfv2-global-constraints (get-state &idle-root-constraints))
!(test (boundaryCycle idle-before-wake) 1)
!(bind! &idle-wake-ticket (new-state (selectedHostTicket)))
!(change-state! &prevmsg "A new user request")
!(change-state! &new-msg-flag True)
!(test (coreDispatchCommand (get-state &idle-wake-ticket) (quote (host-maintenance memory-rent)))
   (DispatchResult Blocked StaleSnapshot none))
!(test (boundaryCycle incoming-before-ingestion) 1)
!(test (constitutionalMode) Engaged)
!(test (selectedHostCommand) ())
!(test (get-state &cfv2-current-frame-id) ())
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 3)
!(fullLoopIngest "Inspect the configured documentation")
!(test (commitmentFixtureOpen "idle-user-task" (get-state &cfv2-current-frame-id) "Inspect the configured documentation")
   (CommitmentOpened "idle-user-task"))
!(bind! &idle-user-owner (new-state (commitmentSnapshot)))
!(test (sread (py-call (host_dispatch_config.provision_admitted_task))) (TaskProvisioning Installed))
;; Ordinary task work still passes its own policy gate; it cannot use the session account.
!(test (coreDispatchCommand (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill))
   (sread (py-call (host_config_fixture.command))))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 3)
;; Clear focus using Core's existing API, preserving the open task record and commitment.
!(cfv2-clear-current-frame-cache)
!(change-state! &prevmsg "")
!(change-state! &new-msg-flag False)
!(test (py-call (host_mode_fixture.provision_idle "allowed")) 1)
!(test (py-call (host_mode_fixture.provision_idle "permission-denied")) 1)
!(test (boundaryCycle idle-denied) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 3)
!(test (py-call (host_mode_fixture.provision_idle "budget-denied")) 1)
!(test (boundaryCycle idle-exhausted) 1)
!(test (selectedHostCommand) ())
!(test (py-call (host_mode_fixture.provision_idle "allowed")) 1)
!(test (boundaryCycle idle-second) 1)
!(test (fullLoopDispatch idle (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "idle-2" 1 (MemoryRentAccounted 5))))
!(test (maintenanceFixtureQueue "idle-3" ((MemoryRentCharge "idle-memory" 1))) (MaintenanceQueued "idle-3"))
!(test (py-call (host_mode_fixture.provision_idle "larger-ceiling")) 1)
!(test (boundaryCycle idle-spent) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureRemaining) 1)
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 5)
!(test (commitmentSnapshot) (get-state &idle-user-owner))
!(test (get-state &success-count) 0)

;; A new session cannot inherit queued work or dispatch a ticket from the previous one.
!(bind! &idle-stale-ticket (new-state
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame defer))))
!(test (initOperationSession) True)
!(change-state! &idle-session (index-atom (get-state &operation-context) 1))
!(test (coreDispatchCommand (get-state &idle-stale-ticket) (quote (host-maintenance memory-rent)))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (host_mode_fixture.provision_idle "allowed")) 1)
!(test (boundaryCycle new-idle-session) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureRemaining) 0)
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 0)
!(test (commitmentSnapshot) (get-state &idle-user-owner))
!(test (maintenanceFixtureQueue "fresh-idle" ((MemoryRentCharge "fresh-memory" 1))) (MaintenanceQueued "fresh-idle"))
!(test (boundaryCycle fresh-idle-owner) 1)
!(test (fullLoopDispatch idle (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "fresh-idle" 1 (MemoryRentAccounted 1))))
!(test (maintenanceFixtureIdleTotal (get-state &idle-session)) 1)
!(test (py-call (host_mode_fixture.provision_idle "removed")) 1)
!(test (maintenanceFixtureQueue "revoked-idle" ((MemoryRentCharge "fresh-memory" 1))) (MaintenanceRejected InvalidBatch))
!(test (boundaryCycle idle-disabled) 1)
!(test (selectedHostCommand) ())

;; Existing task-owned maintenance still uses its own task policies and ownership.
!(test (boundaryStart) 1)
!(test (boundaryProvision "maintenance") 1)
!(bind! &maintenance-owner (new-state (commitmentSnapshot)))
!(change-state! &new-msg-flag False)
;; Hold Sleep while this frame is active; frame-less maintenance is a separate host scope.
!(remove-atom &self (ModeTransitionParameters Sleep 1 0 0))
!(add-atom &self (ModeTransitionParameters Sleep 1 20 0))
!(remove-atom &self (ModeTransitionOption urgent-bypass True))
!(add-atom &self (ModeTransitionOption urgent-bypass False))
!(setConstitutionalMode Sleep)
!(test (boundaryCycle empty-maintenance) 1)
!(test (constitutionalMode) Sleep)
!(test (selectedHostCommand) ())
!(test (signalQuantityAtLeastIn (lastFactualSignals) sweep-ready-items count 1) False)
!(test (maintenanceFixtureTotal) 0)

!(test (maintenanceFixtureQueue "rent-1" ((MemoryRentCharge "memory-a" 2) (MemoryRentCharge "memory-b" 3)))
   (MaintenanceQueued "rent-1"))
!(test (maintenanceFixtureQueue "rent-1" ((MemoryRentCharge "memory-a" 2) (MemoryRentCharge "memory-b" 3)))
   (MaintenanceQueued "rent-1"))
!(test (maintenanceFixtureQueue "rent-1" ((MemoryRentCharge "memory-a" 4)))
   (MaintenanceRejected ConflictingBatch))
!(test (boundaryCycle pending-maintenance) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) defer)
!(test (selectedHostCommand) (quote (host-maintenance memory-rent)))
!(test (signalTrueIn (lastFactualSignals) sweep-handler-available) True)
!(test (signalQuantityAtLeastIn (lastFactualSignals) sweep-ready-items count 2) True)
!(test (let $fact (signalFactIn (lastFactualSignals) sweep-ready-items)
   (hostSignalFactSupported (activeFrameBundle) $fact)) True)
!(test (maintenanceFixtureTotal) 0)
!(bind! &maintenance-ticket (new-state (selectedHostTicket)))
!(test (maintenanceFixtureDirectDenied) True)
!(test (maintenanceFixtureTotal) 0)
!(bind! &maintenance-command (new-state (selectedHostCommand)))
!(test (fullLoopDispatch maintenance (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "rent-1" 2 (MemoryRentAccounted 5))))
!(test (maintenanceFixtureTotal) 5)
!(test (maintenanceFixtureRemaining) 0)
!(test (index-atom (get-state &last-operation-outcome) 3) Success)
!(test (dispatchSelectedHostCommand (get-state &maintenance-ticket) (get-state &maintenance-command))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "rent-1" 2 (MemoryRentAccounted 5))))
!(test (maintenanceFixtureTotal) 5)
!(test (maintenanceFixtureQueue "rent-1" ((MemoryRentCharge "memory-a" 2) (MemoryRentCharge "memory-b" 3)))
   (MaintenanceDuplicate "rent-1"))
!(test (boundaryCycle consumed-maintenance) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureRemaining) 0)
!(test (signalTrueIn (lastFactualSignals) progress-made) False)
!(test (get-state &success-count) 0)

;; The real host handler respects the item limit across cycles and retains the remainder.
!(test (maintenanceFixtureBatch "rent-bounded" 17) (MaintenanceQueued "rent-bounded"))
!(test (boundaryCycle bounded-maintenance) 1)
!(test (fullLoopDispatch maintenance (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "rent-bounded" 16 (MemoryRentAccounted 21))))
!(test (maintenanceFixtureRemaining) 1)
!(test (boundaryCycle remainder-maintenance) 1)
!(test (fullLoopDispatch maintenance (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-rent "rent-bounded" 1 (MemoryRentAccounted 22))))
!(test (maintenanceFixtureRemaining) 0)
!(test (commitmentSnapshot) (get-state &maintenance-owner))

;; Normal task policy still denies maintenance without its permission or command budget.
!(test (maintenanceFixtureQueue "rent-2" ((MemoryRentCharge "memory-c" 7))) (MaintenanceQueued "rent-2"))
!(test (boundaryProvision "maintenance-denied") 1)
!(test (boundaryCycle denied-maintenance) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureTotal) 22)
!(test (maintenanceFixtureRemaining) 1)
!(test (boundaryProvision "maintenance-budget") 1)
!(test (boundaryCycle exhausted-maintenance) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureTotal) 22)

;; Dependency absence removes readiness, but host-only work needs no reasoner selection.
!(test (boundaryProvision "maintenance") 1)
!(test (maintenanceFixtureDependency "not-loaded") True)
!(test (boundaryCycle missing-engine) 1)
!(test (selectedHostCommand) ())
!(test (signalTrueIn (lastFactualSignals) sweep-handler-available) False)
!(test (maintenanceFixtureDependency Host) True)
!(test (boundaryCycle host-only) 1)
!(test (selectedHostCommand) (quote (host-maintenance memory-rent)))
!(test (maintenanceFixtureRevoke) True)
!(test (let (DispatchResult $status $_ $_)
   (dispatchSelectedHostCommand (selectedHostTicket) (selectedHostCommand)) $status) Blocked)
!(test (maintenanceFixtureTotal) 22)

;; A fresh user request retains independently valid native work ahead of a pending sweep.
!(test (maintenanceFixtureDependency Host) True)
!(test (boundaryProvision "maintenance-interactive") 1)
!(remove-atom &self (ModeTransitionOption urgent-bypass False))
!(add-atom &self (ModeTransitionOption urgent-bypass True))
!(change-state! &new-msg-flag True)
!(test (boundaryCycle native-wake) 1)
!(test (constitutionalMode) Engaged)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) respond)
!(test (car-atom (selectedHostCommand)) read-file)
!(test (maintenanceFixtureTotal) 22)

;; The same connection supports a registered Rumination adapter, with explicit engine absence.
;; This worker is a test probe; no native compression or learning support is claimed.
!(test (boundaryProvision "maintenance-restructure") 1)
!(change-state! &new-msg-flag False)
!(remove-atom &self (ModeTransitionParameters Rumination 1 0 0))
!(add-atom &self (ModeTransitionParameters Rumination 1 20 0))
!(remove-atom &self (ModeTransitionOption urgent-bypass True))
!(add-atom &self (ModeTransitionOption urgent-bypass False))
!(setConstitutionalMode Rumination)
!(test (maintenanceFixtureProbe "not-loaded") True)
!(test (maintenanceFixtureWork memory-compression "probe-1" (a b)) (MaintenanceQueued "probe-1"))
!(test (boundaryCycle missing-restructuring-engine) 1)
!(test (selectedHostCommand) ())
!(test (signalTrueIn (lastFactualSignals) restructuring-handler-available) False)
!(test (maintenanceFixtureProbe Host) True)
!(setConstitutionalMode Sleep)
!(test (boundaryCycle wrong-posture) 1)
!(test (selectedHostCommand) ())
!(test (maintenanceFixtureProcessed) 0)
!(setConstitutionalMode Rumination)
!(test (boundaryCycle supported-restructuring-adapter) 1)
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) self-improve)
;; A retained Rumination selection grants no authority after switching to Sleep.
!(bind! &restructuring-ticket (new-state (selectedHostTicket)))
!(bind! &restructuring-command (new-state (selectedHostCommand)))
!(setConstitutionalMode Sleep)
!(test (let (DispatchResult $status $_ $_)
   (dispatchSelectedHostCommand (get-state &restructuring-ticket) (get-state &restructuring-command)) $status) Blocked)
!(test (maintenanceFixtureProcessed) 0)
!(setConstitutionalMode Rumination)
!(test (boundaryCycle restructuring-after-sleep) 1)
!(test (fullLoopDispatch maintenance-probe (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (MaintenanceCompleted memory-compression "probe-1" 2 (ProbeProcessed 2))))
!(test (maintenanceFixtureProcessed) 2)

;; A maintenance result must preserve existing task recovery rather than resolve it.
!(change-state! &operation-failure-streak 2)
!(bind! &maintenance-recovery-before (new-state (get-state &host-recovery)))
!(recordOperationRecovery Failure (get-state &cfv2-current-frame-id))
!(bind! &maintenance-protected-recovery (new-state (get-state &host-recovery)))
!(test (operationRecoveryLive) True)
!(test (applyTaskOperationFeedback (quote (host-maintenance memory-rent)) Success
   (get-state &cfv2-current-frame-id)) True)
!(test (get-state &operation-failure-streak) 2)
!(test (get-state &host-recovery) (get-state &maintenance-protected-recovery))
!(change-state! &host-recovery (get-state &maintenance-recovery-before))
!(change-state! &operation-failure-streak 0)
!(test (commitmentSnapshot) (get-state &maintenance-owner))

;; A bounded adapter timeout neither commits its probe effect nor becomes success.
!(test (maintenanceFixtureWork memory-compression "probe-timeout" (c)) (MaintenanceQueued "probe-timeout"))
!(test (maintenanceFixtureSlow) True)
!(remove-atom &self (MaintenanceWork memory-compression Restructuring (MaintenanceWorkLimits 8 8 0 1000)))
!(add-atom &self (MaintenanceWork memory-compression Restructuring (MaintenanceWorkLimits 8 8 0 1)))
!(test (boundaryCycle bounded-timeout) 1)
!(test (fullLoopDispatch maintenance-timeout (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Unobserved ExecutionUncertain none))
!(test (maintenanceFixtureProcessed) 2)
!(test (boundaryCycle after-timeout) 1)
!(test (selectedHostCommand) ())
!(test (signalTrueIn (lastFactualSignals) restructuring-handler-available) False)
!(test (commitmentSnapshot) (get-state &maintenance-owner))

;; Closed ownership cannot lend its queued work to another scheduling cycle.
!(test (commitmentFixtureApply
   (quote (CommitmentEvent "maintenance-close" "boundary-task" 0 (Abandoned "operator cancelled"))))
   (CommitmentApplied "maintenance-close" "boundary-task" Abandoned 1))
!(test (boundaryCycle closed-owner) 1)
!(test (selectedHostCommand) ())
!(test (signalQuantityAtLeastIn (lastFactualSignals) restructuring-ready-items count 1) False)
!(test (maintenanceFixtureProcessed) 2)
