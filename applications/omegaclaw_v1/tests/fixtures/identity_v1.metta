;; Shared, host-shaped data for integration publication and consumer checks.
;; Frame IDs are existing native IDs, not allocated by the identity adapter.
(= (identityFixtureRelation)
   (FrameStateRelation (identityPair id "relation-native") (revision 0)
      (source-frame "Frame-20260921T091500000001Z") (target-frame "frame-other")
      (relation-type DependsOn) (reason "Dependency") (confidence 0.7) (evidence-status Unverified)))
(= (identityFixturePayload)
   (FrameStateBundle
      (root (FrameStateRoot (identityPair id "root-native") (revision 3)
         (current-frame-id "Frame-20260921T091500000001Z") (mode Slow)
         (global-budget (BudgetRef (identityProducer host) "global-budget" 2))
         (global-constraints (ConstraintsRef (identityProducer host) "global-constraints" 1))))
      (current (FrameStateCurrent (identityPair id "Frame-20260921T091500000001Z") (revision 4)
         (parent None) (source "user-A") (status Active) (frame-mode Slow) (priority 0.5)
         (goal-summary "Task") (history-summary "") (deliverable-summary "") (results-summary "")
         (budget (BudgetRef (identityProducer host) "frame-budget" 2))
         (constraints (ConstraintsRef (identityProducer host) "frame-constraints" 1)) (certified-method "")))
      (index (FrameStateIndex
         (active ((FrameIndexRef (identityPair id "Frame-20260921T091500000001Z") (revision 4) (status Active))
                  (FrameIndexRef (identityPair id "frame-other") (revision 1) (status Active)))) (completed ())))
      (relations ((identityFixtureRelation)))
      (runtime (FrameStateRuntime (new-message False) (message-present False) (message-summary "")
         (task-open True) (task-execution-observed ()) (active-task-summary "Task")
         (last-results-summary "") (error "") (wake-loops 0) (next-wake-at None)
         (budget-state (BudgetRef (identityProducer host) "frame-budget" 2))))
      (policy (HostPolicyRef (identityProducer host) "policy-native" 7))))

(= (identityFixtureAdopt $_ ($kind $id $rev))
   (identityOK (identityAdoptEntity $kind $id $rev (NativeEntity $id))))
(= (identityFixtureEntities)
   (identityEvery identityFixtureAdopt ()
      ((FrameRef "root-native" 3) (FrameRef "Frame-20260921T091500000001Z" 4)
       (FrameRef "frame-other" 1) (BudgetRef "global-budget" 2) (BudgetRef "frame-budget" 2)
       (ConstraintsRef "global-constraints" 1) (ConstraintsRef "frame-constraints" 1)
       (HostPolicyRef "policy-native" 7))))
(= (identityFixtureDecision $proposal $operation)
   (MetaMoPolicyOutput (mode Engaged) (operation-class $operation)
      (feasibility Admitted) (reason Feasible) (priority 0.7) (proposal $proposal)))
(= (identityFixtureDirective $decision $operation $target)
   (AttentionDirective (decision $decision) (target $target) (slice CurrentFrameTask)
      (task $operation) (admission Admitted) (reason Feasible) (priority 0.7) (source MetaMo)))
(= (identityFixtureProposal $observation)
   (ReasonerMotivationalProposal (source nars) (kind propose-candidate)
      (target (FrameTarget "Frame-20260921T091500000001Z")) (candidate repair-failure)
      (claim (Recommend repair-failure)) (support (Truth 1 0.8)) (confidence 0.8)
      (evidence (EvidenceReferences ($observation))) (prediction (Expected Recovered))))
(= (identityFixtureFrames)
   ((FrameRef (identityProducer host) "Frame-20260921T091500000001Z" 4)
    (FrameRef (identityProducer host) "frame-other" 1)))
(= (identityFixtureRelations) ((RelationRef (identityProducer host) "relation-native" 0)))
(= (identityFixtureEvidence $execution $observation)
   (FrameVerificationEvidence (relation (RelationRef (identityProducer host) "relation-native" 0))
      (source-frame "Frame-20260921T091500000001Z") (target-frame "frame-other")
      (relation-type DependsOn) (reason "Observed dependency") (prior-confidence 0.7)
      (evidence-status Confirmed) (observed-at 1800000000000) (observations ($observation))
      (execution $execution)))
(= (identityFixtureOutcome $decision $directive $proposal $dispatch $execution $observations $verification)
   (ExecutionOutcome (decision $decision) (directive $directive) (proposal $proposal)
      (dispatch $dispatch) (execution $execution) (frame "Frame-20260921T091500000001Z")
      (status Completed) (reason ObservedSuccess) (observed-at 1800000000000)
      (execution-evidence $observations) (verification $verification)))

;; Pure fixture edits preserve field order and let negative tests change one
;; causal link without making the whole record malformed by construction.
(= (identityFixtureSet $record $key $value)
   (let ($tag $fields) (decons-atom $record)
      (cons-atom $tag (map-atom $fields $field
         (case $field (
            (($name $_) (if (== $name $key) (identityPair $name $value) $field))
            ($_ $field)))))))
