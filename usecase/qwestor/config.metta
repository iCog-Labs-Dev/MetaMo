
;; Return schema and profile identifiers used by the Qwestor bundle
(= (qwestorSchemaConfig)
    (
        (QWESTOR_SCHEMA_ID qwestor)
        (QWESTOR_DECISION_PROFILE_ID qwestor_magus_additive)
        (QWESTOR_APPRAISAL_PROFILE_ID qwestor_openpsi)
    )
)

;; Return application-modulator learning and target-tracking rates
(= (qwestorLearningRates)
    (
        (URGENCY_ALPHA 0.60)
        (RISK_AVERSION_ALPHA 0.45)
        (ERROR_TOLERANCE_ALPHA 0.40)
        (FAILURE_RETENTION 0.80)
        (FAILURE_SIGNAL_GAIN 0.55)
        (USER_EXPERTISE_ALPHA 0.45)
        (TOPIC_FAMILIARITY_ALPHA 0.35)
        (CREATIVITY_ALPHA 0.40)
    )
)

;; Return coefficients used to derive the four OpenPsi stimulus features
(= (qwestorFeatureWeights)
    (
        (NOVELTY_FAMILIARITY_WEIGHT 0.30)
        (NOVELTY_COMPLEXITY_WEIGHT 0.25)
        (NOVELTY_REFLECTION_WEIGHT 0.15)
        (NOVELTY_EXTERNAL_BONUS 0.30)
        (CONDUCIVENESS_FAMILIARITY_WEIGHT 0.40)
        (CONDUCIVENESS_CLARITY_WEIGHT 0.20)
        (CONDUCIVENESS_VALENCE_WEIGHT 0.20)
        (CONDUCIVENESS_FAILURE_WEIGHT 0.20)
        (CONDUCIVENESS_VERIFICATION_WEIGHT 0.40)
        (CONDUCIVENESS_AMBIGUITY_PENALTY 0.30)
        (RISK_THRESHOLD_WEIGHT 0.30)
        (RISK_FAILURE_WEIGHT 0.20)
        (RISK_UNFAMILIARITY_WEIGHT 0.10)
        (RISK_VERIFICATION_WEIGHT 0.60)
        (RISK_AMBIGUITY_PENALTY 0.30)
        (EFFORT_COMPLEXITY_WEIGHT 0.20)
        (EFFORT_AMBIGUITY_WEIGHT 0.10)
        (EFFORT_PLAN_BONUS 0.50)
        (EFFORT_MULTI_SOURCE_BONUS 0.40)
    )
)

;; Return Qwestor application-appraisal and feedback coefficients
(= (qwestorAppraisalWeights)
    (
        (CREATIVITY_NOVELTY_WEIGHT 0.50)
        (CREATIVITY_REFLECTION_WEIGHT 0.30)
        (CREATIVITY_RECOVERY_WEIGHT 0.20)
        (HALLUCINATE_RISK_WEIGHT 0.45)
        (HALLUCINATE_VERIFICATION_WEIGHT 0.25)
        (HALLUCINATE_FAILURE_WEIGHT 0.20)
        (HALLUCINATE_UNFAMILIARITY_WEIGHT 0.10)
        (REDUNDANT_EXPERTISE_WEIGHT 0.45)
        (REDUNDANT_FAMILIARITY_WEIGHT 0.35)
        (REDUNDANT_LOW_NOVELTY_WEIGHT 0.20)
        (RABBIT_HOLE_EFFORT_WEIGHT 0.35)
        (RABBIT_HOLE_MULTI_SOURCE_WEIGHT 0.25)
        (RABBIT_HOLE_REFLECTION_WEIGHT 0.20)
        (RABBIT_HOLE_URGENCY_WEIGHT 0.20)
        (PREMATURE_COMPLEXITY_WEIGHT 0.40)
        (PREMATURE_AMBIGUITY_WEIGHT 0.30)
        (PREMATURE_PLAN_WEIGHT 0.20)
        (PREMATURE_LOW_RESOLUTION_WEIGHT 0.10)
    )
)

;; Return decision, availability, and response-style configuration
(= (qwestorDecisionConfig)
    (
        (LAMBDA_INDIVIDUATION 0.50)
        (LAMBDA_TRANSCENDENCE 0.50)
        (OVERGOAL_DELTA_SCALE 0.01)
        (ANTI_GOAL_DELTA_SCALE 0.16)
        (PRIMARY_GOAL_DELTA_SCALE 0.18)
        (CANDIDATE_DELTA_WEIGHT 0.25)
        (MAX_GOAL_DELTA 0.10)
        (SECONDARY_STYLE_MARGIN 0.08)
    )
)

;; Return neutral previous-outcome values used on the first turn
(= (qwestorOutcomeDefaults)
    (
        (short_help 0.50)
        (long_help 0.50)
        (grounding 0.50)
        (safety 0.50)
        (progress 0.50)
        (novel_yield 0.50)
        (original_yield 0.50)
        (breakthrough_yield 0.50)
        (coherence 0.50)
        (social_quality 0.50)
        (efficiency 0.50)
        (accuracy 0.50)
    )
)

