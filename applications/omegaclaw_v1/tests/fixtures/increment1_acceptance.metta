;; External inference/memory doubled; real appraisal, capture, gate and handlers.
!(import! &self offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self offline_services/frame_relation.py)
!(import! &self offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send read-file))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self host_config_fixture.py)
!(import! &self prepared_response_fixture.py)
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &send-test-channel (new-state local))
(= (commchannel) (get-state &send-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Inspect the file")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Use the native symbol ID to exercise generated operation target preservation.
!(change-state! &cfv2-current-frame-id configured-frame)
!(change-state! &active-task "Inspect the file")
!(change-state! &task-open True)
!(change-state! &new-msg-flag False)
!(initMetaMoDispatch)
!(py-call (host_config_fixture.setup))
;; Startup installer preserves the native symbol target.
!(py-call (host_dispatch_config.configure_startup (py-call (prepared_response_fixture.configure "allowed"))))
!(py-call (host_dispatch_config.provision_startup))
!(import! &self (library OmegaClaw-Core channels/irc.py))
!(import! &self irc_routing_fixture.py)
!(import! &self irc_submission_fixture.py)
!(import! &self increment1_acceptance.py)
!(change-state! &send-test-channel (acceptanceChannel))
!(test (py-call (increment1_acceptance.start (acceptanceChannel))) 1)
!(bind! &read-bundle (new-state (prepareTaskStateForMetaMo)))
!(retainSelectedOperation execute-skill (captureCandidateOperations (get-state &read-bundle)))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(test (py-call (prepared_response_fixture.retain_read)) 1)
!(test (py-call (increment1_acceptance.reads)) 1)
!(test (sread (py-call (increment1_acceptance.queue))) (ResponsePreparationQueued))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (selectedHostCommand) (quote (send "File says: observed local file content")))
!(bind! &reply-ticket (new-state (selectedHostTicket)))
!(bind! &reply-command (new-state (selectedHostCommand)))
;; F1.A3: substituted text causes zero effects, then the real answer can execute.
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (quote (send "substituted")))
   (DispatchResult Blocked UnselectedOperation none))
!(test (py-call (increment1_acceptance.effects)) 0)
;; F1.A1: the wire/stdout message contains the actual real-file observation.
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (get-state &reply-command)) (acceptanceSuccess))
!(test (py-call (increment1_acceptance.delivered "File says: observed local file content")) 1)
;; F1.A6: clear channel suppression; the ticket ledger must prevent another effect.
!(change-state! &lastsend "")
!(py-call (increment1_acceptance.clear_marker))
!(test (coreLoopDispatchCommand (get-state &reply-ticket) (get-state &reply-command)) (acceptanceSuccess))
!(test (py-call (increment1_acceptance.effects)) 1)
;; F1.A8: execute the idle decision, and inspect both real dispatch and channel effects.
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (selectedHostCommand) ())
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Blocked MissingDecision none))
!(test (py-call (increment1_acceptance.effects)) 1)
!(test (py-call (increment1_acceptance.reads)) 1)
!(test (py-call (increment1_acceptance.calls)) 1)
!(bind! &accepted-key (new-state (get-state &answered-operation-key)))
!(test (!= (get-state &accepted-key) ()) True)
;; F1.A2: explicit host question through the same selected, gated send path.
;; Generated clarification selection is outside increment 1 (F4.2).
!(retainSelectedOperation ask-clarification (captureCandidateOperations (prepareTaskStateForMetaMo)))
!(test (selectedHostCommand) (quote (send "Which file?")))
!(test (coreLoopDispatchCommand (selectedHostTicket) (selectedHostCommand)) (acceptanceSuccess))
!(test (py-call (increment1_acceptance.delivered "Which file?")) 1)
!(applyOperationOutcome configured-frame)
!(test (get-state &answered-operation-key) (get-state &accepted-key))
;; F1.A4: the prepared command cannot follow a changed route.
!(py-call (prepared_response_fixture.new_input))
!(sread (py-call (increment1_acceptance.queue)))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &route-ticket (new-state (selectedHostTicket)))
!(bind! &route-command (new-state (selectedHostCommand)))
!(py-call (increment1_acceptance.change_route))
!(test (coreLoopDispatchCommand (get-state &route-ticket) (get-state &route-command))
   (DispatchResult Blocked StaleSnapshot none))
!(test (py-call (increment1_acceptance.effects)) 2)
!(py-call (increment1_acceptance.restore_route))

;; F1.A5: denied global egress prunes prepared sends before selection.
!(py-call (increment1_acceptance.provision "global"))
!(py-call (prepared_response_fixture.new_input))
!(sread (py-call (increment1_acceptance.queue)))
!(test (!= (policyOutputOperation (motivationContextBlock)) respond) True)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected EgressDenied))
!(test (!= (selectedHostCommand) (quote (send "File says: observed local file content"))) True)
!(test (py-call (increment1_acceptance.effects)) 2)

;; F1.A5: denied frame egress prunes prepared sends before selection.
!(py-call (increment1_acceptance.provision "frame"))
!(py-call (prepared_response_fixture.new_input))
!(sread (py-call (increment1_acceptance.queue)))
!(test (!= (policyOutputOperation (motivationContextBlock)) respond) True)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected EgressDenied))
!(test (!= (selectedHostCommand) (quote (send "File says: observed local file content"))) True)
!(test (py-call (increment1_acceptance.effects)) 2)

;; F1.A7: uncertainty is retained, never accepted or automatically resent.
!(py-call (increment1_acceptance.provision "allowed"))
!(py-call (prepared_response_fixture.new_input))
!(sread (py-call (increment1_acceptance.queue)))
!(test (policyOutputOperation (motivationContextBlock)) respond)
!(bind! &uncertain-ticket (new-state (selectedHostTicket)))
!(bind! &uncertain-command (new-state (selectedHostCommand)))
!(change-state! &lastsend "")
!(py-call (increment1_acceptance.clear_marker))
!(py-call (increment1_acceptance.fail_send))
!(test (coreLoopDispatchCommand (get-state &uncertain-ticket) (get-state &uncertain-command)) (acceptanceUncertain))
!(py-call (increment1_acceptance.restore_send))
!(applyOperationOutcome configured-frame)
!(test (get-state &operation-feedback) (OperationFeedback Unobserved 0))
!(test (get-state &answered-operation-key) (get-state &accepted-key))
!(test (coreLoopDispatchCommand (get-state &uncertain-ticket) (get-state &uncertain-command)) (acceptanceUncertain))
!(test (py-call (increment1_acceptance.effects)) 3)
!(bind! &calls-before-idle (new-state (py-call (increment1_acceptance.calls))))
!(motivationContextBlock)
!(test (preparedHostBinding) ())
!(test (!= (selectedHostCommand) (get-state &uncertain-command)) True)
!(coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
;; An independently bound clarification may be selected. The uncertain answer
;; itself must not be resent: one accepted plus one uncertain attempt only.
!(test (py-call (increment1_acceptance.delivered "File says: observed local file content")) 2)
!(test (py-call (increment1_acceptance.calls)) (get-state &calls-before-idle))
!(test (get-state &task-open) True)
!(test (py-call (increment1_acceptance.finish)) 1)
!(test (py-call (host_config_fixture.cleanup)) 1)
