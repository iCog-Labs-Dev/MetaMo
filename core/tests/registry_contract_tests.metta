!(import! &self ../validation)
!(import! &self ../schema)
!(import! &self ../features)
!(import! &self ../state)
!(import! &self ../helper)
!(import! &self "../helpers.py")
!(import! &self ../../openpsi/profile)
!(import! &self ../../openpsi/appraisal)
!(import! &self ../../magus/correlation)
!(import! &self ../../magus/profile)
!(import! &self ../../magus/goal_change)
!(import! &self ../../magus/decision)
!(import! &self ../../dynamics/stability)
!(import! &self ../../dynamics/coherence)
!(import! &self ../../category/merge)
!(import! &self ../../category/diagnostics)
!(import! &self ../../category/functors)
!(import! &self ../../category/bimonad)
!(import! &self ../runtime)
!(import! &self ../registry)

(= (registryStimulus $raw) $raw)
(= (registryFeatures $state $stimulus) $stimulus)
(= (registryCoreDeltas $state $features) ((valence 0.0)))
(= (registryAppDeltas $state $features) ())
(= (registryFeedback $state $stimulus $features) (goalChangeFeedback ()))
(= (registrySchema)
    (motivationSchema registry (magusGoalSchema (help) () (individuation transcendence help) individuation transcendence) (modulatorSchema (valence threshold securing) () (valence threshold securing)) decision appraisal)
)
(= (registryProfile)
    (decisionProfile registry (registrySchema) ((help (valence))) (help) () () () () () none 0.01 0.02 0.05 0.0 0.1)
)
(= (registryAppraisal)
    (appraisalProfile registry (valence) registryFeatures registryCoreDeltas registryAppDeltas registryFeedback 1.0 ())
)
(= (registryCandidates $state $stimulus)
    ((actionCandidate answer (registrySchema) (0.0 0.0 0.8) 0.0 (0.0 0.0 0.0) ()))
)
(= (registryBundle)
    (applicationBundle registry (registrySchema) (registryAppraisal) (registryProfile) defaultGoalChangeDeltaG (makeDefaultStabilityPolicy) (makeDefaultCoherencePolicy) (makeDefaultParallelMergePolicy) registryStimulus registryCandidates ())
)

!(test
    (bimonadMerge (buildMetaMoFromBundle (registryBundle)))
    (makeDefaultParallelMergePolicy)
)

!(test
    (bimonadStability (buildValidatedMetaMoFromBundle (registryBundle)))
    (makeDefaultStabilityPolicy)
)
