;; Full host-to-mode cycles. Only external services and a failing handler are doubled.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send query))
(= (query $key) "")
(= (remember $payload) True)
(= (pin $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library OmegaClaw-Core src/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
!(import! &self fixtures/host_mode_fixture.py)
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
   (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureOutcome commitmentFixtureApply))
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(commitmentFixtureReset)
!(initContextFrame)
!(initOmegaClawMotivation)
!(initMetaMoDispatch)
!(initOperationSession)
!(test (py-call (host_mode_fixture.setup)) 1)
!(test (py-call (lib_llm_ext.semantic_response (frameStateRuntimeSummary "Controlled danger observation" 1200) "((signal danger 0.9))")) 1)
!(test (py-call (lib_llm_ext.semantic_response (frameStateRuntimeSummary "Controlled anger observation" 1200) "((signal user-angry 0.9))")) 1)
(= (outcome-test-failure) (quote (Error test-handler failed)))
(= (modeTestCycle)
   (let $outputs (collapse (motivationContextBlock))
      (progn
         (println! (HostModeTrace (lastModeObservation) $outputs))
         (size-atom $outputs))))
(= (modeTestSignals)
   (let (ModeObservation $_ $_ $signals $_ $_) (lastModeObservation) $signals))
(= (modeTestHas $kind)
   (modeSignalMeetsThreshold $kind 0.0 (modeTestSignals)))
(= (modeTestProvision)
   (py-call (host_mode_fixture.provision (get-state &cfv2-current-frame-id))))

;; Enter Sleep from real empty host state, then admit a real user task.
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Sleep)
!(test (selectedHostCommand) ())
!(ctx-ingest-user-message "Explain the project documentation")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Match the existing typed dispatch fixtures: a host-assigned String frame ID.
!(change-state! &cfv2-current-frame-id "mode-frame")
!(bind! &mode-frame (new-state (get-state &cfv2-current-frame-id)))
!(commitmentFixtureOpen "mode-task" (get-state &mode-frame) "Explain the project documentation")
!(change-state! &prevmsg "Explain the project documentation")
!(change-state! &new-msg-flag True)
!(test (modeTestProvision) 1)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (modeTestHas user-waiting) True)
!(test (modeTestHas stalled-progress) False)
!(test (getSignals) ())

;; Controlled execution failure passes real policy, dispatch, and correlation.
!(test (py-call (host_config_fixture.install_failure_handler)) 1)
!(test (modeTestCycle) 1)
!(test (== (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (Error test-handler failed))) True)
!(bind! &mode-failure (new-state (get-state &last-operation-outcome)))
!(test (ingestOperationOutcome (get-state &mode-failure)) OutcomeDuplicate)
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Rumination)
!(test (modeTestHas failure) True)
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)
!(test (get-state &failure-count) 1)
;; A denied/no-action dispatch is an observation, not recovery resolution.
!(test (let (DispatchResult $status $_ $_)
   (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand)) $status) Blocked)
!(test (modeTestCycle) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Blocked 1))
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)
!(test (get-state &failure-count) 1)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Rumination)
!(test (modeTestHas failure) False)
!(test (modeTestHas stalled-progress) True)
!(test (get-state &failure-count) 1)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback NoOutcome 1))
!(test (ingestOperationOutcome (get-state &mode-failure)) (OutcomeRejected StaleCycle))

;; Restore the real reader. A fresh request makes the configured response
;; eligible; only its observed success resolves the same owner's recovery.
!(test (modeTestProvision) 1)
!(change-state! &prevmsg "Explain the project documentation")
!(change-state! &new-msg-flag True)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Rumination)
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (modeTestHas progress-made) True)
!(test (modeTestHas stalled-progress) False)
!(test (get-state &failure-count) 1)
!(test (get-state &success-count) 1)
!(test (modeTestCycle) 1)
!(test (modeTestHas progress-made) False)
!(test (get-state &success-count) 1)

;; Semantic provider boundary produces threat; mode and policy remain real.
!(change-state! &prevmsg "Controlled danger observation")
!(change-state! &new-msg-flag True)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Threat)
!(test (modeTestHas danger) True)
!(bind! &threat-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &threat-command (new-state (selectedHostCommand)))
!(test (py-call (host_mode_fixture.provision (get-state &mode-frame) True)) 1)
!(test (let (DispatchResult $status $_ $_)
   (coreLoopDispatchCommand (get-state &threat-ticket) (get-state &threat-command)) $status) Blocked)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Threat)
!(test (selectedHostCommand) ())
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (modeTestHas danger) False)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (modeTestProvision) 1)

;; Both supported threat producers work; timing is still registry-owned.
!(change-state! &prevmsg "Controlled anger observation")
!(change-state! &new-msg-flag True)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Threat)
!(test (modeTestHas user-angry) True)
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (modeTestHas user-angry) False)

;; Full-loop confirmations, hold, and cooldown use the unchanged evaluator.
!(remove-atom &self (ModeTransitionParameters Threat 1 0 0))
!(add-atom &self (ModeTransitionParameters Threat 2 2 2))
!(change-state! &prevmsg "Controlled danger observation")
!(change-state! &new-msg-flag True)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (modeTestCycle) 1)
!(test (modeTransitionState) (ModeTransitionState Threat 0 none 0 2))
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Threat)
!(test (modeTestHas danger) False)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Threat)
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(remove-atom &self (ModeTransitionParameters Threat 2 2 2))
!(add-atom &self (ModeTransitionParameters Threat 1 0 0))

;; Pending recovery cannot follow work into a different frame or session.
(= (modeTestFail)
   (progn
      (modeTestProvision)
      (py-call (host_config_fixture.install_failure_handler))
      (change-state! &prevmsg "Explain the project documentation")
      (change-state! &new-msg-flag True)
      (modeTestCycle)
      (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))))
!(test (== (modeTestFail) (DispatchResult Executed Feasible (Error test-handler failed))) True)
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)
!(change-state! &cfv2-current-frame-id "other-frame")
!(test (modeTestCycle) 1)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(change-state! &cfv2-current-frame-id (get-state &mode-frame))
!(test (modeTestCycle) 1)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (== (modeTestFail) (DispatchResult Executed Feasible (Error test-handler failed))) True)
!(bind! &old-session-failure (new-state (get-state &last-operation-outcome)))
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)
!(test (initOperationSession) True)
!(test (get-state &host-recovery) NoRecovery)
!(test (get-state &recovery-view) NoRecovery)
!(test (ingestOperationOutcome (get-state &old-session-failure)) (OutcomeRejected WrongSession))
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)

;; Terminal commitment bookkeeping clears an outstanding recovery too.
!(test (== (modeTestFail) (DispatchResult Executed Feasible (Error test-handler failed))) True)
!(change-state! &new-msg-flag False)
!(test (modeTestCycle) 1)
!(test (frameRuntimeRecovery (activeFrameBundle)) RecoveryPending)

;; Completion is an explicit host event, followed by real frame completion.
!(commitmentFixtureOutcome "mode-done" "mode-task" 0 Completed)
!(test (commitmentFixtureApply
   (quote (CommitmentEvent "mode-close" "mode-task" 0 (Completed "mode-done"))))
   (CommitmentApplied "mode-close" "mode-task" Completed 1))
;; Closing the commitment resolves recovery while the current frame remains.
!(test (modeTestCycle) 1)
!(test (constitutionalMode) Engaged)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) False)
!(cfv2-mark-current-frame-completed "Observed requested result")
!(cfv2-clear-current-frame-cache)
!(test (modeTestCycle) 1)
!(test (frameBundleCurrentId (activeFrameBundle)) ())
!(test (frameRuntimeTaskOpen (activeFrameBundle)) False)
!(test (constitutionalMode) Sleep)
!(test (selectedHostCommand) ())
!(test (policyOutputOperation (get-state &last-meta-mo-policy-output)) none)
!(test (get-state &failure-count) 4)
!(test (frameRuntimeRecovery (activeFrameBundle)) NoRecovery)
!(test (py-call (host_config_fixture.cleanup)) 1)
