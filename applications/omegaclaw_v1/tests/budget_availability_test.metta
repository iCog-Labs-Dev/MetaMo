!(import! &self (library lib_import))
!(import! &self (library MetaMo applications/omegaclaw_v1/contexts/typed_policy))
!(import! &self (library MetaMo applications/omegaclaw_v1/budget_accounting))

(= (availabilityId $scope)
   (BudgetAccountId "host" $scope "commands" "units"))
(= (availabilityAccounts)
   ((BudgetAccount (availabilityId Global) 10 3 4 Open 7)
    (BudgetAccount (availabilityId (FrameTarget frameA)) 10 2 3 Closed 4)
    (BudgetAccount (availabilityId (FrameTarget "frameA")) 10 10 0 Exhausted 9)
    (BudgetAccount (BudgetAccountId "other" Global "commands" "units") 20 0 0 Open 0)
    (BudgetAccount (BudgetAccountId "host" Global "tokens" "tokens") 9007199254740991 1 1 Open 1)
    (BudgetAccount (BudgetAccountId "host" Global "commands" "other-unit") 8 1 1 Open 0)
    (BudgetAccount (availabilityId (FrameTarget zero)) 5 2 3 Open 0)))

!(test (budgetAvailability (availabilityId Global))
   (BudgetAccountingRejected AccountsNotInitialized))
!(test (get-state &budget-account-state) BudgetAccountsUninitialized)
!(test (initBudgetAccounts (availabilityAccounts)) (BudgetAccountsInitialized 7))
!(test (budgetAvailability (availabilityId Global)) (ResourceBudget "commands" "units" 3 Open))
!(test (budgetAvailability (availabilityId (FrameTarget frameA))) (ResourceBudget "commands" "units" 5 Closed))
!(test (budgetAvailability (availabilityId (FrameTarget "frameA"))) (ResourceBudget "commands" "units" 0 Exhausted))
!(test (budgetAvailability (availabilityId (FrameTarget zero))) (ResourceBudget "commands" "units" 0 Open))
!(test (budgetAvailability (BudgetAccountId "other" Global "commands" "units")) (ResourceBudget "commands" "units" 20 Open))
!(test (budgetAvailability (BudgetAccountId "host" Global "tokens" "tokens")) (ResourceBudget "tokens" "tokens" 9007199254740989 Open))
!(test (budgetAvailability (BudgetAccountId "host" Global "commands" "other-unit")) (ResourceBudget "commands" "other-unit" 6 Open))
!(test (budgetAvailability (availabilityId (FrameTarget missing))) (BudgetAccountingRejected MissingBudgetAccount))
!(test (budgetAvailability (BudgetAccountId "missing" Global "commands" "units")) (BudgetAccountingRejected MissingBudgetAccount))
!(test (budgetAvailability (BudgetAccountId "host" Global "missing" "units")) (BudgetAccountingRejected MissingBudgetAccount))
!(test (budgetAvailability (BudgetAccountId "host" Global "commands" "missing")) (BudgetAccountingRejected MissingBudgetAccount))
!(test (budgetAvailability ()) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability "host") (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "host" Global "commands")) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "" Global "commands" "units")) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "host" Other "commands" "units")) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (availabilityId (FrameTarget ""))) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (availabilityId (FrameTarget 123))) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "host" Global "" "units")) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "host" Global "commands" "")) (BudgetAccountingRejected InvalidBudgetAccountId))
!(test (budgetAvailability (BudgetAccountId "host" Global $resource "units")) (BudgetAccountingRejected InvalidBudgetAccountId))

;; Repeated reads preserve every balance and revision.
!(test (budgetAvailability (availabilityId Global)) (ResourceBudget "commands" "units" 3 Open))
!(test (get-state &budget-account-state) (BudgetAccounts (availabilityAccounts)))

;; Test-only host mutations: subsequent calls must see updated availability.
!(change-state! &budget-account-state
   (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 4 5 Open 8))))
!(test (budgetAvailability (availabilityId Global)) (ResourceBudget "commands" "units" 1 Open))
!(test (get-state &budget-account-state)
   (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 4 5 Open 8))))

;; Empty initialized storage differs from an uninitialized store.
!(change-state! &budget-account-state (BudgetAccounts ()))
!(test (budgetAvailability (availabilityId Global)) (BudgetAccountingRejected MissingBudgetAccount))

;; Corrupt host state must not produce capacity or mutate itself.
(= (availabilityCorruption $snapshot)
   (progn
      (change-state! &budget-account-state $snapshot)
      (let $result (budgetAvailability (availabilityId Global))
         ($result (=alpha (get-state &budget-account-state) $snapshot)))))
!(test (availabilityCorruption Broken)
   ((BudgetAccountingRejected InvalidBudgetAccounts) True))
!(test (availabilityCorruption (BudgetAccounts "broken"))
   ((BudgetAccountingRejected InvalidBudgetAccounts) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 8 3 Open 0))))
   ((BudgetAccountingRejected BudgetOvercommitted) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 1.5 0 Open 0))))
   ((BudgetAccountingRejected InvalidBudgetAccount) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 0 0 Unknown 0))))
   ((BudgetAccountingRejected InvalidBudgetAccounting) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 0 0 Open -1))))
   ((BudgetAccountingRejected InvalidBudgetAccount) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 0 0 Open 0) (BudgetAccount (availabilityId Global) 20 0 0 Open 0))))
   ((BudgetAccountingRejected DuplicateBudgetAccount) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 0 0 Open 0) Broken)))
   ((BudgetAccountingRejected InvalidBudgetAccount) True))
!(test (availabilityCorruption (BudgetAccounts ((BudgetAccount (availabilityId Global) 10 $spent 0 Open 0))))
   ((BudgetAccountingRejected InvalidBudgetAccounts) True))
