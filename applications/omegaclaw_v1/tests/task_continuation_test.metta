!(import! &self (library lib_import))
;; Real bridge selection through concrete policy to real Core frame inspection.
;; Only external provider/memory services are doubled. No scoring replacement.
!(import! &self fixtures/offline_services/offline_guard.py)
!(py-call (offline_guard.install))
!(import! &self fixtures/offline_services/frame_relation.py)
!(import! &self fixtures/offline_services/lib_llm_ext.py)
(= (provider) "Offline")
(= (embeddingprovider) "Offline")
(= (maxOutputToken) 256)
(= (wakeupInterval) 1)
(= (getFrameSkillsCompact) (send query))
(= (query $key) "")
(= (remember $payload) True)
!(import! &self (library OmegaClaw-Core src/helper.py))
!(import! &self (library OmegaClaw-Core src/utils))
!(import! &self (library OmegaClaw-Core src/context))
!(import! &self (library OmegaClaw-Core src/skills))
!(import! &self (library MetaMo applications/omegaclaw_v1/composition))
!(import! &self (library OmegaClaw-Core src/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/dispatch))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_dispatch_config.py))
!(import! &self fixtures/host_config_fixture.py)
!(import_prolog_functions_from_file
   (library MetaMo applications/omegaclaw_v1/tests/fixtures/commitments.pl)
   (commitmentFixtureReset commitmentFixtureOpen commitmentFixtureOutcome commitmentFixtureApply commitmentFixtureEpoch))
!(commitmentFixtureReset)
!(bind! &prevmsg (new-state ""))
!(bind! &lastresults (new-state ""))
!(bind! &error (new-state ""))
!(bind! &loops (new-state 1))
!(bind! &nextWakeAt (new-state 0))
!(bind! &continuation-test-channel (new-state local))
(= (commchannel) (get-state &continuation-test-channel))
!(import! &self (library OmegaClaw-Core channels/local_channel.py))
!(import! &self (library OmegaClaw-Core src/channels))
!(initContextFrame)
!(initOmegaClawMotivation)
!(ctx-ingest-user-message "Inspect the project context")
!(cfv2-load-frame (get-state &cfv2-last-admitted-frame-id))
;; Existing typed dispatch contract; native symbol-ID migration is separate.
!(change-state! &cfv2-current-frame-id "configured-frame")
!(change-state! &active-task "Inspect the project context")
!(change-state! &task-open True)
!(change-state! &new-msg-flag False)
!(initMetaMoDispatch)
!(import! &self fixtures/continuation_fixture.py)
!(bind! &config-path (new-state (py-call (continuation_fixture.setup))))
!(py-call (host_dispatch_config.provision (get-state &config-path)))
!(initOperationSession)
!(commitmentFixtureOpen "two-reads" "configured-frame" "Read both requested files")
!(bind! &read-plan (new-state (sread (py-call (continuation_fixture.plan)))))
!(test (hostBeginContinuation "read-plan" (get-state &read-plan)) (ContinuationStarted "read-plan"))
!(test (hostBeginContinuation "replacement" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))

;; F3.2 prepares ordinary step data without installing or replacing the live plan.
!(bind! &before-preparation (new-state (get-state &host-continuation)))
!(bind! &before-selection (new-state (get-state &selected-operation-decision)))
!(bind! &before-commitment (new-state (commitmentSnapshot)))
!(bind! &constructed-steps (new-state (sread (py-call (continuation_fixture.proposed_steps 2)))))

!(test (get-state &constructed-steps) (get-state &read-plan))
!(test (hostPrepareContinuation "proposed" (get-state &constructed-steps))
   (ContinuationPrepared "proposed" (get-state &read-plan)))
!(test (continuationPlanValid "sixteen" (sread (py-call (continuation_fixture.proposed_steps 16)))) True)
!(test (hostPrepareContinuation "empty" (sread (py-call (continuation_fixture.proposed_steps 0))))
   (ContinuationRejected InvalidPlan))
!(test (hostPrepareContinuation "seventeen" (sread (py-call (continuation_fixture.proposed_steps 17))))
   (ContinuationRejected InvalidPlan))
!(test (hostPrepareContinuation "" (get-state &constructed-steps)) (ContinuationRejected InvalidPlan))
!(test (hostPrepareContinuation "bad" malformed) (ContinuationRejected InvalidPlan))
!(test (hostPrepareContinuation "bad"
   (quote ((ExecutionStep "1" (read-file "a")) (ExecutionStep "1" (read-file "b")))))
   (ContinuationRejected InvalidPlan))
!(test (hostPrepareContinuation "bad" (quote ((ExecutionStep "1" (change-state! &error "ran")))))
   (ContinuationRejected InvalidPlan))
!(bind! &inert-steps (new-state (sread (py-call (continuation_fixture.inert_steps)))))
!(test (hostPrepareContinuation "inert" (get-state &inert-steps))
   (ContinuationPrepared "inert" (get-state &inert-steps)))
!(test (get-state &error) "")
!(test (get-state &host-continuation) (get-state &before-preparation))
!(test (get-state &selected-operation-decision) (get-state &before-selection))
!(test (commitmentSnapshot) (get-state &before-commitment))

;; F3.3 uses installed catalog/policies and leaves the live plan intact.
!(test (continuationResolveRead (car-atom (get-state &read-plan))) (car-atom (get-state &read-plan)))
!(test (hostAdmitContinuation "admitted" (get-state &read-plan))
   (ContinuationAdmitted "admitted" (get-state &read-plan)))
!(test (hostAdmitContinuation "relative" (sread (py-call (continuation_fixture.relative_steps))))
   (ContinuationAdmitted "relative"
      ((ExecutionStep "1" (sread (py-call (continuation_fixture.command 1))))
       (ExecutionStep "2" (sread (py-call (continuation_fixture.command 0)))))))
!(test (hostAdmitContinuation "unsupported" (get-state &inert-steps))
   (ContinuationRejected UnsupportedOperation))
!(test (hostAdmitContinuation "bad" ()) (ContinuationRejected InvalidPlan))
!(test (hostAdmitContinuation "aliases" (sread (py-call (continuation_fixture.aliased_steps))))
   (ContinuationRejected InvalidPlan))
!(test (hostAdmitContinuation "symlink" (sread (py-call (continuation_fixture.symlink_steps))))
   (ContinuationRejected UnsupportedOperation))
!(setConstitutionalMode Sleep)
!(test (hostAdmitContinuation "sleep" (get-state &read-plan))
   (ContinuationRejected SleepModeOperationalWork))
!(setConstitutionalMode Engaged)

;; Each denial tests the real gate against a freshly installed host policy.
(= (continuationTestAdmissionDenied $scope $variant)
   (progn
      (py-call (host_dispatch_config.provision (py-call (continuation_fixture.admission_config $scope $variant))))
      (hostAdmitContinuation "denied" (get-state &read-plan))))

!(test (continuationTestAdmissionDenied "global" "permission") (ContinuationRejected PermissionDenied))
!(test (continuationTestAdmissionDenied "frame" "permission") (ContinuationRejected PermissionDenied))
!(test (continuationTestAdmissionDenied "global" "skill") (ContinuationRejected SkillNotAllowed))
!(test (continuationTestAdmissionDenied "frame" "skill") (ContinuationRejected SkillNotAllowed))
!(test (continuationTestAdmissionDenied "global" "budget") (ContinuationRejected BudgetExhausted))
!(test (continuationTestAdmissionDenied "frame" "budget") (ContinuationRejected BudgetExhausted))
!(test (continuationTestAdmissionDenied "global" "constraint") (ContinuationRejected ConstraintDenied))
!(test (continuationTestAdmissionDenied "frame" "constraint") (ContinuationRejected ConstraintDenied))
!(test (continuationTestAdmissionDenied "frame" "unsupported") (ContinuationRejected UnsupportedOperation))
!(py-call (host_dispatch_config.provision (get-state &config-path)))

!(change-state! &cfv2-current-frame-id "other-frame")
!(test (hostAdmitContinuation "wrong-owner" (get-state &read-plan))
   (ContinuationRejected MissingAdmissionContext))
!(change-state! &cfv2-current-frame-id "configured-frame")
!(test (hostAdmitContinuation "restored" (get-state &read-plan))
   (ContinuationAdmitted "restored" (get-state &read-plan)))
!(test (sread (py-call (host_operations.admit_read_plan "bad" "(")))
   (ContinuationRejected InvalidPlan))
!(test (get-state &host-continuation) (get-state &before-preparation))
!(test (get-state &selected-operation-decision) (get-state &before-selection))
!(test (commitmentSnapshot) (get-state &before-commitment))
!(test (get-state &error) "")

!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (selectedHostCommand) (sread (py-call (continuation_fixture.command 0))))
!(test (frameRuntimeNewMessage (activeFrameBundle)) False)
!(test (frameRuntimeContinuation (activeFrameBundle))
   (ContinuationView "read-plan" "1" Ready (repr (sread (py-call (continuation_fixture.command 0))))))
!(bind! &first-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &first-command (new-state (selectedHostCommand)))
!(test (coreLoopDispatchCommand (get-state &first-ticket) (get-state &first-command))
   (DispatchResult Executed Feasible "observed local file content"))
!(bind! &first-outcome (new-state (get-state &last-operation-outcome)))
!(test (ingestOperationOutcome (get-state &first-outcome)) OutcomeDuplicate)
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (frameRuntimeNewMessage (activeFrameBundle)) False)
!(test (frameRuntimeOperationFeedback (activeFrameBundle)) (OperationFeedback Success 0))
!(test (frameRuntimeExecutionObserved (activeFrameBundle)) "")
!(test (executionContinuationNeededForBundle (activeFrameBundle)) True)
!(test (selectedHostCommand) (sread (py-call (continuation_fixture.command 1))))
!(test (hostContinuationRecovery) NoContinuationRecovery)
!(test (frameRuntimeContinuation (activeFrameBundle))
   (ContinuationView "read-plan" "2" Ready (repr (selectedHostCommand))))
!(test (ingestOperationOutcome (get-state &first-outcome)) (OutcomeRejected StaleCycle))
!(test (coreLoopDispatchCommand (get-state &first-ticket) (get-state &first-command))
   (DispatchResult Blocked UnselectedOperation none))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "other content"))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (frameRuntimeContinuation (activeFrameBundle))
   (ContinuationView "read-plan" None AwaitingCompletion ()))
!(test (executionContinuationNeededForBundle (activeFrameBundle)) False)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)
!(test (commitmentSnapshot) (CommitmentSnapshot "two-reads" "configured-frame" 0 Open "Read both requested files"))
!(commitmentFixtureOutcome "done" "two-reads" 0 Completed)
!(test (commitmentFixtureApply
   (quote (CommitmentEvent "close" "two-reads" 0 (Completed "done"))))
   (CommitmentApplied "close" "two-reads" Completed 1))
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) False)
!(test (executionContinuationNeededForBundle (activeFrameBundle)) False)

;; Status routing reads the original bounded input before summary compaction.
!(change-state! &prevmsg "Is it done?")
!(change-state! &new-msg-flag True)
!(bind! &status-bundle (new-state (prepareTaskStateForMetaMo)))
!(refreshSignals (get-state &status-bundle))
!(test (frameRuntimeStatusQuestion (get-state &status-bundle)) True)
!(test (resultQuestionNeedsResponseForBundle (get-state &status-bundle)) True)
!(change-state! &prevmsg "Is it done? Then delete the file")
!(test (frameRuntimeStatusQuestion (prepareTaskStateForMetaMo)) False)
!(change-state! &new-msg-flag False)
!(clearSignals)
;; Direct legacy interface uses explicit host progress, never guessed prose.
!(test (py-call (helper.task_needs_more_execution
   "{\"task_id\":\"task\",\"steps\":[\"one\",\"two\"]}"
   "{\"task_id\":\"task\",\"completed_steps\":[\"one\"],\"status\":\"Ready\"}")) 1)
!(test (py-call (helper.task_needs_more_execution "Read both files" "done")) 0)

;; Fresh scenario setup is an explicit session reset, not automatic retry.
(= (continuationTestReset)
   (progn
      (commitmentFixtureReset)
      (commitmentFixtureOpen "two-reads" "configured-frame" "Read both requested files")
      (initMetaMoDispatch)
      (initOperationSession)
      (initOmegaClawMotivation)
      (change-state! &new-msg-flag False)
      (change-state! &prevmsg "")
      (change-state! &lastsend "")
      (change-state! &error "")
      (change-state! &lastresults "")
      (hostBeginContinuation "read-plan" (get-state &read-plan))))

;; Invalid plans never run command-shaped input or replace the current plan.
!(test (hostBeginContinuation "bad" (quote ((ExecutionStep "one" (read-file)))))
   (ContinuationRejected InvalidPlan))
!(test (hostBeginContinuation "bad"
   (quote ((ExecutionStep "one" (read-file "/a")) (ExecutionStep "one" (read-file "/b")))))
   (ContinuationRejected InvalidPlan))
!(test (hostBeginContinuation "bad" (quote ((ExecutionStep "one" (change-state! &error "ran")))))
   (ContinuationRejected InvalidPlan))
!(test (get-state &error) "")
!(test (continuationStepsValid (get-state &read-plan) 1 ()) False)
!(test (continuationStepsValid malformed 16 ()) False)

;; A policy change after selection blocks execution and holds the exact step.
!(test (continuationTestReset) (ContinuationStarted "read-plan"))
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(bind! &blocked-ticket (new-state (coreLoopDispatchBegin)))
!(bind! &blocked-command (new-state (selectedHostCommand)))
!(py-call (host_dispatch_config.provision (get-state &config-path)))
!(test (coreLoopDispatchCommand (get-state &blocked-ticket) (get-state &blocked-command))
   (DispatchResult Blocked StaleSnapshot none))
!(motivationContextBlock)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (executionContinuationNeededForBundle (activeFrameBundle)) False)
!(test (tpContains (map-atom (get-state &operation-admitted-actions) $a (actionId $a)) execute-skill) False)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)

;; F4.1 classifies typed evidence, never modes or free-form claims of a missing file.
!(test (continuationReadRecoveryNeed (DispatchResult Blocked PermissionDenied none))
   (ReadRecoveryNeed PermissionDenied PermissionDenied))
!(test (continuationReadRecoveryNeed (DispatchResult Executed Feasible (Error read-file ReadFailed)))
   (ReadRecoveryNeed DefiniteFailure ReadFailed))
!(test (continuationReadRecoveryNeed (DispatchResult Unobserved ExecutionUncertain none))
   (ReadRecoveryNeed Uncertainty ExecutionUncertain))
!(test (continuationReadRecoveryNeed (DispatchResult Executed Feasible "file missing"))
   (ReadRecoveryNeed Uncertainty UnknownOutcome))
!(test (continuationReadRecoveryNeed unknown) (ReadRecoveryNeed Uncertainty UnknownOutcome))

;; Denial before selection leaves no executable second command.
!(test (continuationTestReset) (ContinuationStarted "read-plan"))
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "observed local file content"))
!(py-call (host_dispatch_config.provision (py-call (continuation_fixture.deny_second))))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (tpContains (candidateRejections) (CandidateRejection execute-skill PermissionDenied)) True)
!(test (selectedHostCommand) ())
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (sread (py-call (continuation_fixture.command 1))))
   (DispatchResult Blocked MissingDecision none))

!(prepareTaskStateForMetaMo)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (index-atom (hostContinuationRecovery) 6) "2")
!(test (index-atom (hostContinuationRecovery) 7)
   (ReadRecoveryNeed PermissionDenied (CandidateRejection execute-skill PermissionDenied)))
!(test (index-atom (hostContinuationRecovery) 8) (get-state &last-operation-outcome))
!(test (size-atom (index-atom (get-state &continuation-evidence) 5)) 1)

;; A definite native read failure must hold the plan without automatic retry.
!(test (continuationTestReset) (ContinuationStarted "read-plan"))
!(test (hostContinuationRecovery) NoContinuationRecovery)
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (py-call (host_config_fixture.remove_file)) 1)
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (Error read-file FileUnavailable)))
!(bind! &missing-read-outcome (new-state (get-state &last-operation-outcome)))
!(motivationContextBlock)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (index-atom (hostContinuationRecovery) 7) (ReadRecoveryNeed MissingInput FileUnavailable))
!(test (index-atom (hostContinuationRecovery) 8) (get-state &missing-read-outcome))
!(test (index-atom (hostContinuationRecovery) 6) "1")
!(test (index-atom (get-state &host-continuation) 7) (get-state &read-plan))
!(test (get-state &continuation-applied-decision) (index-atom (get-state &missing-read-outcome) 1))
!(bind! &held-read-recovery (new-state (hostContinuationRecovery)))
!(bind! &held-read-evidence (new-state (get-state &continuation-evidence)))
!(test (ingestOperationOutcome (get-state &missing-read-outcome)) (OutcomeRejected StaleCycle))
!(test (executionContinuationNeededForBundle (activeFrameBundle)) False)
!(test (frameRuntimeTaskOpen (activeFrameBundle)) True)
!(test (py-call (host_config_fixture.replace_file_content)) 1)
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (hostContinuationRecovery) (get-state &held-read-recovery))
!(test (get-state &continuation-evidence) (get-state &held-read-evidence))
!(change-state! &cfv2-current-frame-id "other-frame")
!(test (hostContinuationRecovery) NoContinuationRecovery)
!(change-state! &cfv2-current-frame-id "configured-frame")
!(test (hostContinuationRecovery) (get-state &held-read-recovery))

;; A trusted uncertain observation is retained once and cannot turn into an automatic retry.
!(test (continuationTestReset) (ContinuationStarted "read-plan"))
!(test (get-state &continuation-recovery) NoContinuationRecovery)
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(bind! &uncertain-read-outcome (new-state
   (OperationOutcome (get-state &selected-operation-decision)
      (attempted-command (selectedHostCommand)) Unobserved
      (DispatchResult Unobserved ExecutionUncertain none))))
!(test (ingestOperationOutcome (get-state &uncertain-read-outcome)) OutcomeAccepted)
!(test (ingestOperationOutcome (get-state &uncertain-read-outcome)) OutcomeDuplicate)
!(prepareTaskStateForMetaMo)
!(test (index-atom (hostContinuationRecovery) 7) (ReadRecoveryNeed Uncertainty ExecutionUncertain))
!(test (index-atom (hostContinuationRecovery) 8) (get-state &uncertain-read-outcome))
!(test (get-state &continuation-applied-decision) (index-atom (get-state &uncertain-read-outcome) 1))
!(test (index-atom (get-state &host-continuation) 7) (get-state &read-plan))
!(test (index-atom (get-state &continuation-evidence) 5) ())
!(bind! &uncertain-read-recovery (new-state (hostContinuationRecovery)))
!(prepareTaskStateForMetaMo)
!(test (hostContinuationRecovery) (get-state &uncertain-read-recovery))
!(test (executionContinuationNeededForBundle (activeFrameBundle)) False)

;; Pure transition check for an explicitly observed failure: same step held.
!(bind! &failure-decision (new-state
   (OperationDecision (OperationContext "session" 1 "configured-frame") execute-skill
      (sread (py-call (continuation_fixture.command 0))) (DispatchTicket "failure-ticket"))))
!(change-state! &applied-operation-decision (get-state &failure-decision))
!(change-state! &continuation-applied-decision ())
!(test (continuationConsume "session" "configured-frame" (get-state &read-plan)
   (OperationOutcome (get-state &failure-decision) (attempted-command (sread (py-call (continuation_fixture.command 0))))
      Failure (DispatchResult Executed Feasible (Error read failed))))
   (Held (get-state &read-plan)))

;; Frame change is sticky even if the host later returns to the old frame.
!(test (continuationTestReset) (ContinuationStarted "read-plan"))
!(change-state! &cfv2-current-frame-id "other-frame")
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (hostContinuationRecovery) NoContinuationRecovery)
!(change-state! &cfv2-current-frame-id "configured-frame")
!(prepareTaskStateForMetaMo)
!(test (frameRuntimeContinuation (activeFrameBundle)) (ContinuationView "read-plan" None Held ()))
!(test (initOperationSession) True)
!(test (get-state &host-continuation) ())
!(test (get-state &continuation-recovery) NoContinuationRecovery)
!(test (get-state &task-continuation-view) NoContinuation)
!(test (ingestOperationOutcome (get-state &first-outcome)) (OutcomeRejected WrongSession))

;; F3.4: install at a later safe point without resetting the session between tasks.
!(bind! &later-session (new-state (index-atom (get-state &operation-context) 1)))
!(change-state! &operation-context (OperationContext (get-state &later-session) 7 "configured-frame"))
!(test (hostBeginContinuation "late-plan" (get-state &read-plan)) (ContinuationStarted "late-plan"))
!(bind! &late-plan (new-state (get-state &host-continuation)))

;; Held and read-finished plans still belong to a live commitment.
(= (continuationTestStatus $status)
   (let (HostContinuation $session $owner $frame $revision $id $_ $steps)
      (get-state &host-continuation)
      (change-state! &host-continuation
         (HostContinuation $session $owner $frame $revision $id $status $steps))))

!(continuationTestStatus Held)
!(test (hostBeginContinuation "overwrite-held" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(continuationTestStatus AwaitingCompletion)
!(test (hostBeginContinuation "overwrite-waiting" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(change-state! &host-continuation (get-state &late-plan))
!(test (hostBeginContinuation "bad" ()) (ContinuationRejected InvalidPlan))
!(test (get-state &host-continuation) (get-state &late-plan))

;; Only a recorded terminal event releases the old task's plan slot.
!(test (commitmentFixtureApply (quote (CommitmentEvent "f34-abandon" "two-reads" 0 (Abandoned "done with task"))))
   (CommitmentApplied "f34-abandon" "two-reads" Abandoned 1))
!(test (commitmentFixtureOpen "later-task" "configured-frame" "A later admitted task")
   (CommitmentOpened "later-task"))
!(change-state! &operation-context (OperationContext (get-state &later-session) 8 "configured-frame"))
!(change-state! &selected-operation-decision (get-state &failure-decision))
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(change-state! &selected-operation-decision ())
!(change-state! &selected-host-operation SelectedInvocation)
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(change-state! &selected-host-operation ())
!(test (py-call (continuation_fixture.uncertain_invocation 1)) 1)
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationRejected OutstandingInvocation))
!(test (py-call (continuation_fixture.uncertain_invocation 0)) 1)
!(test (get-state &host-continuation) (get-state &late-plan))

;; A changed session or mismatched operation frame cannot take over the predecessor.
!(change-state! &operation-context (OperationContext "wrong-session" 8 "configured-frame"))
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(change-state! &operation-context (OperationContext (get-state &later-session) 8 "wrong-frame"))
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationRejected SessionAlreadyActive))
!(change-state! &operation-context (OperationContext (get-state &later-session) 8 "configured-frame"))

;; An accepted event must match the exact predecessor revision, not just its name.
!(let (HostContinuation $session $owner $frame $revision $id $status $steps)
   (get-state &late-plan)
   (change-state! &host-continuation
      (HostContinuation $session $owner $frame (+ $revision 1) $id $status $steps)))
!(test (hostBeginContinuation "stale-predecessor" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))
!(change-state! &host-continuation (get-state &late-plan))

;; Previously retained feedback is fenced when the new plan is installed.
!(change-state! &last-operation-outcome (get-state &first-outcome))
!(test (hostBeginContinuation "later-plan" (get-state &read-plan)) (ContinuationStarted "later-plan"))
!(test (get-state &continuation-applied-decision) (index-atom (get-state &first-outcome) 1))
!(test (get-state &last-operation-outcome) (get-state &first-outcome))
!(test (index-atom (get-state &host-continuation) 1) (get-state &later-session))
!(test (index-atom (get-state &host-continuation) 2) "later-task")
!(test (hostBeginContinuation "duplicate" (get-state &read-plan)) (ContinuationRejected AlreadyStarted))

;; Completed and superseded predecessors also release the slot through host events.
!(commitmentFixtureOutcome "f34-done" "later-task" 0 Completed)
!(test (commitmentFixtureApply (quote (CommitmentEvent "f34-complete" "later-task" 0 (Completed "f34-done"))))
   (CommitmentApplied "f34-complete" "later-task" Completed 1))
!(commitmentFixtureOpen "third-task" "configured-frame" "Third admitted task")
!(test (hostBeginContinuation "third-plan" (get-state &read-plan)) (ContinuationStarted "third-plan"))
!(test (commitmentFixtureApply (quote (CommitmentEvent "f34-replace" "third-task" 0
   (Superseded "fourth-task" "Fourth admitted task" "explicit replacement"))))
   (CommitmentApplied "f34-replace" "third-task" Superseded 1))
!(change-state! &cfv2-current-frame-id "other-frame")
!(change-state! &operation-context (OperationContext (get-state &later-session) 9 "other-frame"))
!(test (hostBeginContinuation "wrong-frame" (get-state &read-plan)) (ContinuationRejected WrongFrame))
!(test (index-atom (get-state &host-continuation) 2) "third-task")
!(change-state! &cfv2-current-frame-id "configured-frame")
!(change-state! &operation-context (OperationContext (get-state &later-session) 9 "configured-frame"))
!(test (hostBeginContinuation "fourth-plan" (get-state &read-plan)) (ContinuationStarted "fourth-plan"))
!(test (index-atom (get-state &host-continuation) 2) "fourth-task")
!(test (index-atom (get-state &operation-context) 1) (get-state &later-session))

;; F3.5: installation joins fresh admission and safe-point mutation under one lock.
!(py-call (host_config_fixture.write "ambiguous"))
!(py-call (host_dispatch_config.provision (get-state &config-path)))
!(bind! &install-context (new-state (get-state &operation-context)))
!(bind! &install-owner (new-state (commitmentSnapshot)))
!(bind! &install-admission (new-state (hostAdmitContinuation "installed-plan" (get-state &read-plan))))
!(bind! &install-before (new-state (get-state &host-continuation)))
!(bind! &install-epoch (new-state (commitmentFixtureEpoch)))

;; F3.A3/A5: rejection is atomic across plan, evidence, epoch and Core invocation results.
!(bind! &acceptance-evidence (new-state (get-state &continuation-evidence)))
!(bind! &acceptance-results (new-state (py-call (continuation_fixture.dispatch_result_count))))
!(bind! &unallowed-admission (new-state
   (hostAdmitContinuation "unallowed-plan" (sread (py-call (continuation_fixture.unallowed_steps))))))
!(test (get-state &unallowed-admission) (ContinuationRejected UnsupportedOperation))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &unallowed-admission)) (ContinuationRejected InvalidAdmission))
!(test (get-state &host-continuation) (get-state &install-before))
!(test (get-state &continuation-evidence) (get-state &acceptance-evidence))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))
!(test (py-call (continuation_fixture.dispatch_result_count)) (get-state &acceptance-results))

!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (ContinuationAdmitted "invalid-replacement" ())) (ContinuationRejected InvalidPlan))
!(test (get-state &host-continuation) (get-state &install-before))
!(test (get-state &continuation-evidence) (get-state &acceptance-evidence))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))
!(test (py-call (continuation_fixture.dispatch_result_count)) (get-state &acceptance-results))

!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (ContinuationRejected InvalidPlan)) (ContinuationRejected InvalidAdmission))
!(test (sread (py-call (host_operations.install_admitted_continuation "(" "()" "()")))
   (ContinuationRejected InvalidAdmission))
!(test (hostInstallAdmittedContinuation (OperationContext "stale-session" 9 "configured-frame")
   (get-state &install-owner) (get-state &install-admission)) (ContinuationRejected StaleOwnership))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))

;; An admission captured before replacement cannot install for the replacement owner.
!(commitmentFixtureApply (quote (CommitmentEvent "f35-replace" "fourth-task" 0
   (Superseded "install-task" "Installation task" "explicit replacement"))))
!(change-state! &install-epoch (commitmentFixtureEpoch))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationRejected StaleOwnership))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))
!(change-state! &install-owner (commitmentSnapshot))
!(change-state! &install-admission (hostAdmitContinuation "installed-plan" (get-state &read-plan)))

;; Revocation after admission fails atomically without replacing the predecessor.
!(py-call (host_dispatch_config.provision (py-call (continuation_fixture.admission_config "frame" "permission"))))
!(change-state! &install-epoch (commitmentFixtureEpoch))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationRejected PermissionDenied))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))
!(test (get-state &host-continuation) (get-state &install-before))
!(py-call (host_dispatch_config.provision (get-state &config-path)))
!(change-state! &install-epoch (commitmentFixtureEpoch))

;; Both ordinary selection and uncertain execution block installation without mutation.
!(change-state! &selected-host-operation SelectedInvocation)
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationRejected AlreadyStarted))
!(change-state! &selected-host-operation ())
!(py-call (continuation_fixture.uncertain_invocation 1))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationRejected OutstandingInvocation))
!(py-call (continuation_fixture.uncertain_invocation 0))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))
!(test (get-state &host-continuation) (get-state &install-before))

;; Successful installation preserves order and invalidates a previously captured ticket.
!(bind! &pre-install-ticket (new-state
   (coreDispatchCapture (AdmissionRequest propose-candidate current-frame execute-skill))))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationStarted "installed-plan"))
!(test (commitmentFixtureEpoch) (+ (get-state &install-epoch) 1))
!(test (index-atom (get-state &host-continuation) 2) "install-task")
!(test (index-atom (get-state &host-continuation) 7) (get-state &read-plan))
!(test (coreDispatchCommand (get-state &pre-install-ticket) (sread (py-call (continuation_fixture.command 0))))
   (DispatchResult Blocked StaleSnapshot none))
!(change-state! &install-epoch (commitmentFixtureEpoch))
!(test (hostInstallAdmittedContinuation (get-state &install-context) (get-state &install-owner)
   (get-state &install-admission)) (ContinuationRejected AlreadyStarted))
!(test (commitmentFixtureEpoch) (get-state &install-epoch))

;; F3.6: F3.5 installation reaches ordinary selection without a manual view refresh.
;; Catalog order is unrequested, first, second; the admitted request is second, first.
!(commitmentFixtureApply (quote (CommitmentEvent "f36-replace" "install-task" 0
   (Superseded "selection-task" "Read the second file then the first" "explicit replacement"))))
!(py-call (host_dispatch_config.provision (py-call (continuation_fixture.with_unrequested_read))))
!(bind! &selection-admission (new-state
   (hostAdmitContinuation "selection-plan" (sread (py-call (continuation_fixture.relative_steps))))))
!(test (hostInstallAdmittedContinuation (get-state &operation-context) (commitmentSnapshot)
   (get-state &selection-admission)) (ContinuationStarted "selection-plan"))
!(test (get-state &task-continuation-view) NoContinuation)
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (selectedHostCommand) (sread (py-call (continuation_fixture.command 1))))
!(test (frameRuntimeNewMessage (activeFrameBundle)) False)
!(bind! &selection-rows (new-state (captureCandidateOperations (activeFrameBundle))))
!(test (size-atom (hostRowsForCandidate execute-skill (get-state &selection-rows))) 1)
!(test (hostOperationGate (activeFrameBundle) search-knowledge (get-state &selection-rows))
   (GateDecision Admitted Feasible))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "other content"))
!(bind! &selection-outcome (new-state (get-state &last-operation-outcome)))
!(test (ingestOperationOutcome (get-state &selection-outcome)) OutcomeDuplicate)
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (selectedHostCommand) (sread (py-call (continuation_fixture.command 0))))
!(test (frameRuntimeContinuation (activeFrameBundle))
   (ContinuationView "selection-plan" "2" Ready (repr (selectedHostCommand))))
!(test (ingestOperationOutcome (get-state &selection-outcome)) (OutcomeRejected StaleCycle))

;; A further ordinary cycle cannot consume that observation a second time.
!(test (policyOutputOperation (motivationContextBlock)) execute-skill)
!(test (selectedHostCommand) (sread (py-call (continuation_fixture.command 0))))
!(test (size-atom (hostRowsForCandidate execute-skill (captureCandidateOperations (activeFrameBundle)))) 1)
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible "changed after invocation"))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (frameRuntimeContinuation (activeFrameBundle))
   (ContinuationView "selection-plan" None AwaitingCompletion ()))
!(test (hostRowsForCandidate execute-skill (captureCandidateOperations (activeFrameBundle))) ())
!(test (frameRuntimeNewMessage (activeFrameBundle)) False)
!(test (commitmentSnapshot)
   (CommitmentSnapshot "selection-task" "configured-frame" 0 Open "Read the second file then the first"))

;; F3.7 retains both successful outcomes and automatically prepares their grounded answer.
!(bind! &answer-evidence (new-state (get-state &continuation-evidence)))
!(test (size-atom (index-atom (get-state &answer-evidence) 5)) 2)
!(test (py-call (continuation_fixture.enable_answers "answer")) 1)
!(test (py-call (host_config_fixture.capture_local_output)) 1)

;; Incomplete retained evidence cannot cause preparation, even when the cursor says finished.
!(let (ContinuationEvidence $session $owner $id $steps $outcomes) (get-state &answer-evidence)
   (change-state! &continuation-evidence
      (ContinuationEvidence $session $owner $id $steps (cdr-atom $outcomes))))
!(motivationContextBlock)
!(test (py-call (continuation_fixture.response_calls)) 0)
!(test (preparedHostBinding) ())
!(change-state! &continuation-evidence (get-state &answer-evidence))
!(continuationTestStatus Held)
!(motivationContextBlock)
!(test (py-call (continuation_fixture.response_calls)) 0)
!(continuationTestStatus AwaitingCompletion)

!(test (policyOutputOperation (motivationContextBlock)) respond)
!(test (selectedHostCommand) (quote (send "Both files: other content; changed after invocation.")))
!(test (py-call (continuation_fixture.response_calls)) 1)
!(test (commitmentSnapshot)
   (CommitmentSnapshot "selection-task" "configured-frame" 0 Open "Read the second file then the first"))
!(test (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
   (DispatchResult Executed Feasible (SendObservation "local:stdout" Accepted)))
!(test (commitmentSnapshot)
   (CommitmentSnapshot "selection-task" "configured-frame" 1 Completed "Read the second file then the first"))
!(motivationContextBlock)
!(motivationContextBlock)
!(test (py-call (continuation_fixture.response_calls)) 1)
!(test (py-call (host_config_fixture.local_send_count "Both files: other content; changed after invocation.")) 1)
;; Later tasks reuse the same session, but start with empty evidence and fresh ownership.
(= (continuationAnswerTask $id $mode)
   (progn
      (commitmentFixtureOpen $id "configured-frame" "Read the second file then the first")
      (change-state! &host-response-input ())
      (py-call (continuation_fixture.enable_answers $mode))
      (prepareTaskStateForMetaMo)
      (hostInstallAdmittedContinuation (get-state &operation-context) (commitmentSnapshot)
         (hostAdmitContinuation $id (sread (py-call (continuation_fixture.relative_steps)))))))

(= (continuationAnswerReads)
   (progn
      (motivationContextBlock)
      (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))
      (motivationContextBlock)
      (coreLoopDispatchCommand (coreLoopDispatchBegin) (selectedHostCommand))))

!(test (continuationAnswerTask "no-answer-task" "no-action") (ContinuationStarted "no-answer-task"))
!(test (index-atom (get-state &continuation-evidence) 5) ())
!(test (continuationAnswerReads) (DispatchResult Executed Feasible "changed after invocation"))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (get-state &prepared-host-operation) (ResponseNoAction InsufficientEvidence))
!(test (py-call (continuation_fixture.response_calls)) 2)
!(motivationContextBlock)
!(test (py-call (continuation_fixture.response_calls)) 2)
!(test (commitmentSnapshot)
   (CommitmentSnapshot "no-answer-task" "configured-frame" 0 Open "Read the second file then the first"))
!(commitmentFixtureApply (quote (CommitmentEvent "f37-no-answer" "no-answer-task" 0 (Abandoned "no supported answer"))))

;; A newer input during inference invalidates publication, even with complete read evidence.
!(test (continuationAnswerTask "stale-answer-task" "stale") (ContinuationStarted "stale-answer-task"))
!(test (continuationAnswerReads) (DispatchResult Executed Feasible "changed after invocation"))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (preparedHostBinding) ())
!(test (py-call (continuation_fixture.response_calls)) 3)
!(test (commitmentSnapshot)
   (CommitmentSnapshot "stale-answer-task" "configured-frame" 0 Open "Read the second file then the first"))
!(commitmentFixtureApply (quote (CommitmentEvent "f37-stale-answer" "stale-answer-task" 0 (Abandoned "input changed"))))

;; Complete evidence and a prepared answer still cannot bypass denied egress.
!(test (continuationAnswerTask "denied-answer-task" "denied") (ContinuationStarted "denied-answer-task"))
!(test (continuationAnswerReads) (DispatchResult Executed Feasible "changed after invocation"))
!(test (policyOutputOperation (motivationContextBlock)) none)
!(test (hostOperationGate (activeFrameBundle) respond (captureCandidateOperations (activeFrameBundle)))
   (GateDecision Rejected EgressDenied))
!(test (py-call (continuation_fixture.response_calls)) 4)
!(test (commitmentSnapshot)
   (CommitmentSnapshot "denied-answer-task" "configured-frame" 0 Open "Read the second file then the first"))
!(test (py-call (host_config_fixture.local_send_count "Both files: other content; changed after invocation.")) 1)
!(test (initOperationSession) True)
!(test (get-state &continuation-evidence) ())

!(test (py-call (host_config_fixture.finish_local_capture)) 1)

!(test (py-call (host_config_fixture.cleanup)) 1)


;; F3.A1: a user message traverses real Core ingress, startup, planning, selection and dispatch.
;; The fixture supplies input/provider responses, never calls plan APIs or selects a command.
!(import! &self (library MetaMo applications/omegaclaw_v1/runtime_support))
!(import! &self (library MetaMo applications/omegaclaw_v1/host_startup))
(= (getPrompt) "Use only the selected host command.")
(= (maxFeedback) 512)
(= (addToHistory $message $response $commands $new) True)
!(import! &self (library OmegaClaw-Core src/loop))
!(configure maxSessionCycles 8)
!(configure maxNewInputLoops 7)
!(configure maxWakeLoops 1)
!(configure spamShield True)
!(configure sleepInterval 0)
!(configure reasoningMode medium)
!(configure useFrames True)

;; Example: reset independent scenarios; within each run only Core receives the one request.
(= (runAutomaticReadScenario $scenario)
   (progn
      (commitmentFixtureReset)
      (initContextFrame)
      (initOperationSession)
      (initOmegaClawMotivation)
      (py-call (continuation_fixture.install_auto_loop $scenario))
      (initializeHostStartup)
      (change-state! &prevmsg "")
      (change-state! &lastsend "")
      (change-state! &lastresults "")
      (change-state! &error "")
      (change-state! &loops 7)
      (if (== $scenario "sleep") (setConstitutionalMode Sleep) True)
      (omegaclaw 2)))

!(test (runAutomaticReadScenario "answer") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "unallowed") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "no-action") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "stale") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))


!(test (runAutomaticReadScenario "session") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "cancel") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))


;; Sleeping hosts must wake before admission, without consuming the one planning attempt.
!(test (runAutomaticReadScenario "sleep") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

;; F4.2: ordinary Core ingress, automatic plan, native missing read and one bound question.
!(test (runAutomaticReadScenario "missing") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(test (candidateIsAvailableRaw (activeFrameBundle) respond) False)
!(test (candidateIsAvailableRaw (activeFrameBundle) ask-clarification) False)
!(test (clarificationObservedForRecovery (hostContinuationRecovery)) True)
!(test (clarificationObservedForRecovery NoContinuationRecovery) False)
!(test (initOperationSession) True)
!(test (get-state &continuation-clarification) NoClarificationObservation)
!(py-call (host_config_fixture.cleanup))

;; Selection without a send is not delivery and does not suppress a later valid question.
!(test (runAutomaticReadScenario "missing-no-action") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

;; Both-scope egress policy and exact binding cardinality still govern the question.
!(test (runAutomaticReadScenario "missing-denied") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "missing-unbound") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

!(test (runAutomaticReadScenario "missing-ambiguous") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

;; A rejected selected question is observed as held, never delivered or retried while idle.
!(test (runAutomaticReadScenario "missing-stale") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

;; An uncertain send callback stays held without claiming delivery or retrying.
!(test (runAutomaticReadScenario "missing-uncertain") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (host_config_fixture.cleanup))

;; The same recovery selection uses the real IRC handler with a socket double.
!(import! &self (library OmegaClaw-Core channels/irc.py))
!(import! &self fixtures/irc_routing_fixture.py)
!(change-state! &continuation-test-channel irc)
!(test (runAutomaticReadScenario "missing-irc") True)
!(test (py-call (continuation_fixture.verify_auto_loop)) 1)
!(py-call (irc_routing_fixture.disconnect))
!(py-call (host_config_fixture.cleanup))
